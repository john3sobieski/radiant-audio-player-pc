// Installer / uninstaller window. Same look as the app's Black (OLED) theme: pure #000 background, barely lifted
// surfaces, violet accent. Pages: 0..3 setup steps, 4 installing, 5 done, 9 fatal error,
// 10 uninstall question, 11 removing, 12 removed. Rust owns the logic (src/main.rs), this file only draws.

// Colors of the app's Black theme (see `Theme` in crates/radiant-ui/ui/main.slint).
global T {
    out property <color> bg: #000000;
    out property <color> surface: #0c0c0e;
    out property <color> hover: #19191d;
    out property <color> text: #ececf2;
    out property <color> muted: #8d8d9b;
    out property <color> accent: #9376ff;
    out property <color> on-accent: #ffffff;
    out property <color> bad: #ff6166;
}

component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    width: 110px;
    height: 40px;
    border-radius: 20px;
    border-width: 1px;
    border-color: T.muted.with-alpha(0.35);
    background: (ta.has-hover && root.enabled) ? T.hover : T.surface;
    opacity: root.enabled ? 1 : 0.4;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: T.text;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component AccentButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    width: 130px;
    height: 40px;
    border-radius: 20px;
    background: (ta.has-hover && root.enabled) ? T.accent.brighter(0.15) : T.accent;
    opacity: root.enabled ? 1 : 0.4;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: T.on-accent;
        font-size: 14px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A path the user can type or pick with the "Browse" button.
component PathField inherits Rectangle {
    in-out property <string> value;
    in property <string> placeholder;
    callback browse();

    height: 44px;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width - 108px;
        height: parent.height;
        border-radius: 10px;
        border-width: 1px;
        border-color: ti.has-focus ? T.accent : T.hover;
        background: T.bg;

        Text {
            x: 14px;
            y: 0px;
            width: parent.width - 28px;
            height: parent.height;
            text: root.placeholder;
            color: T.muted;
            font-size: 14px;
            vertical-alignment: center;
            visible: root.value == "";
        }
        ti := TextInput {
            x: 14px;
            y: 0px;
            width: parent.width - 28px;
            height: parent.height;
            text <=> root.value;
            color: T.text;
            font-size: 14px;
            vertical-alignment: center;
            single-line: true;
        }
    }
    PillButton {
        x: parent.width - 100px;
        y: 2px;
        width: 100px;
        height: 40px;
        text: "Browse…";
        clicked => { root.browse(); }
    }
}

// A check box on a card: title and a few lines of explanation.
component CheckRow inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <string> sub;
    in property <bool> enabled: true;

    height: 52px;
    border-radius: 12px;
    background: (ta.has-hover && root.enabled) ? T.hover : T.surface;
    opacity: root.enabled ? 1 : 0.45;

    Rectangle {
        x: 16px;
        y: root.sub == "" ? (root.height - 20px) / 2 : 13px;
        width: 20px;
        height: 20px;
        border-radius: 6px;
        border-width: 1.5px;
        border-color: root.checked ? T.accent : T.muted;
        background: root.checked ? T.accent : transparent;
        if root.checked : Path {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            viewbox-width: 18;
            viewbox-height: 18;
            commands: "M 4.5 9.5 L 7.5 12.5 L 13.5 5.5";
            stroke: T.on-accent;
            stroke-width: 2px;
        }
    }
    Text {
        x: 52px;
        y: root.sub == "" ? (root.height - 22px) / 2 : 9px;
        width: root.width - 68px;
        height: 22px;
        text: root.text;
        color: T.text;
        font-size: 14px;
        font-weight: 600;
        vertical-alignment: center;
    }
    Text {
        x: 52px;
        y: 33px;
        width: root.width - 68px;
        height: max(0px, root.height - 38px);
        text: root.sub;
        color: T.muted;
        font-size: 12px;
        wrap: word-wrap;
        vertical-alignment: top;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; }
    }
}

component LangChip inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();

    height: 40px;
    border-radius: 20px;
    border-width: 1px;
    border-color: root.active ? T.accent : T.hover;
    background: root.active ? T.accent.with-alpha(0.2) : (ta.has-hover ? T.hover : T.surface);

    Text {
        x: 8px;
        y: 0px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.text;
        color: root.active ? T.accent : T.text;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The rail of dots with the step names (like the section rail of the app's settings).
component StepRail inherits Rectangle {
    in property <[string]> steps;
    in property <int> current;

    Rectangle {
        x: 5px;
        y: 6px;
        width: 2px;
        height: max(0px, (root.steps.length - 1) * 40px);
        background: T.hover;
    }
    Rectangle {
        x: 5px;
        y: 6px;
        width: 2px;
        height: max(0px, min(root.current, root.steps.length - 1) * 40px);
        background: T.accent;
    }
    for label[i] in root.steps : Rectangle {
        x: 0px;
        y: i * 40px;
        width: root.width;
        height: 24px;

        Rectangle {
            x: 0px;
            y: 1px;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            border-width: 2px;
            border-color: i <= root.current ? T.accent : T.muted;
            background: i <= root.current ? T.accent : T.bg;
        }
        Text {
            x: 26px;
            y: 0px;
            width: parent.width - 26px;
            height: 14px;
            text: label;
            color: i == root.current ? T.text : T.muted;
            font-size: 13px;
            font-weight: i == root.current ? 700 : 400;
            vertical-alignment: center;
        }
    }
}

component Bar inherits Rectangle {
    in property <float> value;

    height: 8px;
    border-radius: 4px;
    background: T.hover;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width * Math.min(1, Math.max(0, root.value));
        height: parent.height;
        border-radius: 4px;
        background: T.accent;
    }
}

component PageHead inherits Rectangle {
    in property <string> title;
    in property <string> sub;

    height: 96px;

    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 34px;
        text: root.title;
        color: T.text;
        font-size: 26px;
        font-weight: 700;
        vertical-alignment: center;
    }
    Text {
        x: 0px;
        y: 42px;
        width: parent.width;
        height: 54px;
        text: root.sub;
        color: T.muted;
        font-size: 13px;
        wrap: word-wrap;
        vertical-alignment: top;
    }
}

export component SetupWindow inherits Window {
    // ---- Set from Rust ----
    in property <string> caption: "Radiant Setup";
    in property <bool> uninstall-mode: false;
    in property <string> version;
    in-out property <int> page: 0;
    in property <string> space-needed;
    in property <string> model-size;
    /// False when this build has no verified model address: the option is shown dimmed.
    in property <bool> model-available: true;
    in property <string> app-dir;
    in property <string> data-info;
    in property <string> status;
    in property <float> progress: 0;
    in property <string> error;
    in property <string> notes;
    /// The AI model is being downloaded: the "Skip download" button is shown.
    in property <bool> downloading: false;

    // ---- Edited by the user ----
    in-out property <string> install-dir;
    in-out property <string> music-dir;
    /// 0 = System, 1..10 = the ten languages (same order as in the app).
    in-out property <int> language-index: 0;
    in-out property <bool> opt-desktop: true;
    in-out property <bool> opt-start: true;
    in-out property <bool> opt-model: false;
    in-out property <bool> opt-launch: true;
    in-out property <bool> opt-remove-data: false;

    callback browse-install();
    callback browse-music();
    callback go-next();
    callback go-back();
    callback skip-model();
    callback start-uninstall();
    callback finish();

    private property <[string]> language-names: ["System", "English", "Deutsch", "Русский", "Українська", "中文", "日本語", "Français", "Čeština", "Español", "Polski"];
    private property <[string]> setup-steps: ["Folder", "Music", "Language", "Options", "Install"];
    private property <[string]> remove-steps: ["Confirm", "Remove"];

    title: root.caption;
    icon: @image-url("../../radiant-ui/assets/logo.png");
    preferred-width: 680px;
    preferred-height: 460px;
    min-width: 680px;
    min-height: 460px;
    max-width: 680px;
    max-height: 460px;
    background: T.bg;
    default-font-size: 14px;

    // ---- Left panel: logo, name, step rail ----
    Rectangle {
        x: 0px;
        y: 0px;
        width: 200px;
        height: root.height;
        clip: true;

        Rectangle {
            x: -100px;
            y: 250px;
            width: 400px;
            height: 400px;
            background: @radial-gradient(circle, T.accent.with-alpha(0.22) 0%, T.accent.with-alpha(0) 70%);
        }
        Image {
            x: 28px;
            y: 30px;
            width: 56px;
            height: 56px;
            source: @image-url("../../radiant-ui/assets/logo.png");
            image-fit: contain;
        }
        Text {
            x: 28px;
            y: 96px;
            width: 160px;
            height: 30px;
            text: "Radiant";
            color: T.text;
            font-size: 22px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            x: 28px;
            y: 126px;
            width: 160px;
            height: 18px;
            text: (root.uninstall-mode ? "Uninstall" : "Setup") + (root.version == "" ? "" : " · v" + root.version);
            color: T.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
        StepRail {
            x: 30px;
            y: 186px;
            width: 150px;
            height: 200px;
            steps: root.uninstall-mode ? root.remove-steps : root.setup-steps;
            current: root.uninstall-mode ? (root.page >= 12 ? 2 : root.page - 10) : (root.page >= 5 ? 5 : root.page);
        }
    }
    Rectangle {
        x: 200px;
        y: 0px;
        width: 1px;
        height: root.height;
        background: T.hover;
    }

    // ---- 0: install folder ----
    if root.page == 0 : PageHead {
        x: 232px;
        y: 34px;
        width: 416px;
        title: "Install Radiant";
        sub: "A simple, private player for your local music. Choose the folder to install it to.";
    }
    if root.page == 0 : PathField {
        x: 232px;
        y: 148px;
        width: 416px;
        value <=> root.install-dir;
        placeholder: "Install folder";
        browse => { root.browse-install(); }
    }
    if root.page == 0 : Text {
        x: 232px;
        y: 208px;
        width: 416px;
        height: 60px;
        text: "Needs about " + root.space-needed + ". Installs for the current Windows user only, no administrator rights are needed.";
        color: T.muted;
        font-size: 12px;
        wrap: word-wrap;
    }

    // ---- 1: music folder ----
    if root.page == 1 : PageHead {
        x: 232px;
        y: 34px;
        width: 416px;
        title: "Music folder";
        sub: "Radiant scans this folder, with all subfolders, for your music. It never looks anywhere else.";
    }
    if root.page == 1 : PathField {
        x: 232px;
        y: 148px;
        width: 416px;
        value <=> root.music-dir;
        placeholder: "No folder chosen";
        browse => { root.browse-music(); }
    }
    if root.page == 1 : Text {
        x: 232px;
        y: 208px;
        width: 416px;
        height: 60px;
        text: "You can leave it empty and choose the folder later in the app. It can be changed at any time.";
        color: T.muted;
        font-size: 12px;
        wrap: word-wrap;
    }

    // ---- 2: language ----
    if root.page == 2 : PageHead {
        x: 232px;
        y: 34px;
        width: 416px;
        title: "Language";
        sub: "Default language of the app. \"System\" follows the Windows language. It can be changed later in Settings.";
    }
    if root.page == 2 : Rectangle {
        x: 232px;
        y: 148px;
        width: 416px;
        height: 200px;
        for name[i] in root.language-names : LangChip {
            x: Math.mod(i, 3) * 143px;
            y: Math.floor(i / 3) * 48px;
            width: 130px;
            text: name;
            active: i == root.language-index;
            clicked => { root.language-index = i; }
        }
    }

    // ---- 3: options ----
    if root.page == 3 : PageHead {
        x: 232px;
        y: 34px;
        width: 416px;
        title: "Options";
        sub: "";
    }
    if root.page == 3 : CheckRow {
        x: 232px;
        y: 84px;
        width: 416px;
        height: 52px;
        text: "Desktop shortcut";
        checked <=> root.opt-desktop;
    }
    if root.page == 3 : CheckRow {
        x: 232px;
        y: 146px;
        width: 416px;
        height: 52px;
        text: "Start menu shortcut";
        checked <=> root.opt-start;
    }
    if root.page == 3 : CheckRow {
        x: 232px;
        y: 208px;
        width: 416px;
        height: 118px;
        text: "Download the AI stem model now (" + root.model-size + ")";
        sub: root.model-available
            ? "Demucs, for splitting a track into vocals, drums, bass and other. It needs internet and is checked after the download. You can skip it and download it later in Settings → AI & stems."
            : "This build has no verified download address for the model. Download or import it later in Settings → AI & stems.";
        enabled: root.model-available;
        checked <=> root.opt-model;
    }

    // ---- 4: installing ----
    if root.page == 4 : PageHead {
        x: 232px;
        y: 34px;
        width: 416px;
        title: "Installing…";
        sub: "Please wait, it takes a moment.";
    }
    if root.page == 4 : Text {
        x: 232px;
        y: 158px;
        width: 416px;
        height: 44px;
        text: root.status;
        color: T.text;
        font-size: 14px;
        wrap: word-wrap;
        vertical-alignment: bottom;
    }
    if root.page == 4 : Bar {
        x: 232px;
        y: 212px;
        width: 416px;
        value: root.progress;
    }

    // ---- 5: done ----
    if root.page == 5 : PageHead {
        x: 232px;
        y: 34px;
        width: 416px;
        title: "Radiant is installed";
        sub: "You can start it from the Start menu or from the shortcut you chose.";
    }
    if root.page == 5 : Text {
        x: 232px;
        y: 140px;
        width: 416px;
        height: 150px;
        text: root.notes;
        color: T.muted;
        font-size: 13px;
        wrap: word-wrap;
    }
    if root.page == 5 : CheckRow {
        x: 232px;
        y: 300px;
        width: 416px;
        height: 52px;
        text: "Launch Radiant";
        checked <=> root.opt-launch;
    }

    // ---- 9: fatal error ----
    if root.page == 9 : PageHead {
        x: 232px;
        y: 34px;
        width: 416px;
        title: "Something went wrong";
        sub: "";
    }

    // ---- 10: uninstall question ----
    if root.page == 10 : PageHead {
        x: 232px;
        y: 34px;
        width: 416px;
        title: "Remove Radiant";
        sub: "Radiant will be removed from " + root.app-dir + ". Your music files are never touched.";
    }
    if root.page == 10 : CheckRow {
        x: 232px;
        y: 150px;
        width: 416px;
        height: 96px;
        text: "Also delete my settings and data";
        sub: root.data-info;
        checked <=> root.opt-remove-data;
    }

    // ---- 11: removing ----
    if root.page == 11 : PageHead {
        x: 232px;
        y: 34px;
        width: 416px;
        title: "Removing…";
        sub: "Please wait.";
    }
    if root.page == 11 : Text {
        x: 232px;
        y: 158px;
        width: 416px;
        height: 44px;
        text: root.status;
        color: T.text;
        font-size: 14px;
        wrap: word-wrap;
        vertical-alignment: bottom;
    }
    if root.page == 11 : Bar {
        x: 232px;
        y: 212px;
        width: 416px;
        value: root.progress;
    }

    // ---- 12: removed ----
    if root.page == 12 : PageHead {
        x: 232px;
        y: 34px;
        width: 416px;
        title: "Radiant was removed";
        sub: "";
    }
    if root.page == 12 : Text {
        x: 232px;
        y: 84px;
        width: 416px;
        height: 200px;
        text: root.notes;
        color: T.muted;
        font-size: 13px;
        wrap: word-wrap;
    }

    // Error line (wrong folder, Radiant still running, ...). On page 9 it is the whole message.
    Text {
        x: 232px;
        y: root.page == 9 ? 84px : 352px;
        width: 416px;
        height: root.page == 9 ? 290px : 44px;
        text: root.error;
        color: T.bad;
        font-size: 12px;
        wrap: word-wrap;
        vertical-alignment: top;
    }

    // ---- Buttons ----
    if (root.page >= 1 && root.page <= 3) : PillButton {
        x: 398px;
        y: 404px;
        text: "Back";
        clicked => { root.go-back(); }
    }
    if (root.page <= 3) : AccentButton {
        x: 518px;
        y: 404px;
        text: root.page == 3 ? "Install" : "Next";
        clicked => { root.go-next(); }
    }
    if (root.page == 4 && root.downloading) : PillButton {
        x: 478px;
        y: 404px;
        width: 170px;
        text: "Skip download";
        clicked => { root.skip-model(); }
    }
    if (root.page == 5 || root.page == 12) : AccentButton {
        x: 518px;
        y: 404px;
        text: root.page == 5 ? "Finish" : "Close";
        clicked => { root.finish(); }
    }
    if (root.page == 9) : AccentButton {
        x: 518px;
        y: 404px;
        text: "Close";
        clicked => { root.finish(); }
    }
    if (root.page == 10) : PillButton {
        x: 398px;
        y: 404px;
        text: "Cancel";
        clicked => { root.finish(); }
    }
    if (root.page == 10) : AccentButton {
        x: 518px;
        y: 404px;
        text: "Remove";
        clicked => { root.start-uninstall(); }
    }
}
