msgid "This file is not the expected model (checksum mismatch)"
msgstr "Ten plik nie jest oczekiwanym modelem (suma kontrolna się nie zgadza)"

msgid "Download the separation model first (Settings → AI & stems)"
msgstr "Najpierw pobierz model rozdzielania (Ustawienia → AI i stemy)"

msgid "The model was deleted"
msgstr "Model został usunięty"

msgid "The model is ready"
msgstr "Model jest gotowy"

msgid "Could not delete the model: {}"
msgstr "Nie udało się usunąć modelu: {}"

