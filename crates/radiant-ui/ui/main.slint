// Main window.
// DONE: volume slider (+ mute), shuffle / repeat toggles, seek bar with times; header (folder button, status), track list (left-aligned, hover/current highlight, click = play),
//       bottom player bar (prev / play-pause / next, now playing), empty state. Custom widgets, no std-widgets.
// TODO: tabs (Playlists / Albums / Tracks / Queues), search, sorting, volume, cover,
//       quality badge, themes (light / true-black / system), translations via @tr().
//       Colors live in `Theme`: when themes are added, turn it into a switchable set.

import { ListView } from "std-widgets.slint";

global Theme {
    out property <color> bg: #131316;
    out property <color> surface: #1b1b20;
    out property <color> surface-hover: #24242b;
    out property <color> accent: #8b6cff;
    out property <color> text: #ececf2;
    out property <color> muted: #8d8d9b;
}

// One row of the track list (filled by Rust).
export struct TrackRow {
    title: string,
    artist: string,
    album: string,
    year: string,
    duration: string,
    /// First letter of the title, shown while there is no cover.
    letter: string,
    cover: image,
    has-cover: bool,
}

// One line of the lyrics (time-ms = -1 for plain, unsynchronized lyrics).
export struct LyricRow {
    text: string,
    time-ms: int,
}

// One album of the Albums grid (filled by Rust).
export struct AlbumRow {
    title: string,
    artist: string,
    letter: string,
    cover: image,
    has-cover: bool,
}

// One row of the open album: a track, or a "Disc N" caption (header != "") on multi-disc albums.
export struct AlbumTrackRow {
    /// Track number from the tags (as on a CD); empty for captions.
    no: string,
    title: string,
    /// Shown under the title only when it differs from the album artist.
    artist: string,
    duration: string,
    header: string,
}

// One entry of the section rail.
export struct NavItem {
    label: string,
    icon: string,
    /// Extra width the segment gets while it is the open one (room for the label).
    extra: length,
}

// One "label: value" line of the Info tab.
export struct InfoRow {
    label: string,
    value: string,
}

// Square cover: the picture, or a quiet tile with a letter when there is none.
component CoverArt inherits Rectangle {
    in property <image> art;
    in property <bool> has-image: false;
    in property <string> letter;
    in property <length> letter-size: 16px;

    width: 40px;
    height: 40px;
    border-radius: 6px;
    clip: true;
    background: Theme.surface-hover;

    if root.has-image : Image {
        width: parent.width;
        height: parent.height;
        source: root.art;
        image-fit: cover;
    }
    if !root.has-image : Text {
        width: parent.width;
        height: parent.height;
        text: root.letter;
        color: Theme.muted;
        font-size: root.letter-size;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Album tile: big square cover with a soft shadow, title and artist underneath.
// Hover: the cover lifts a little. `shown` fires when the tile is created
// (the grid is virtualized, so this is how Rust learns which covers are needed).
component AlbumTile inherits Rectangle {
    in property <image> art;
    in property <bool> has-image: false;
    in property <string> letter;
    in property <string> title;
    in property <string> artist;
    callback clicked();
    callback shown();

    init => { root.shown(); }

    // Cover (square, as wide as the tile).
    Rectangle {
        y: ta.has-hover ? -4px : 0px;
        width: parent.width;
        height: parent.width;
        border-radius: 12px;
        background: Theme.surface-hover;
        drop-shadow-blur: ta.has-hover ? 22px : 14px;
        drop-shadow-color: #000000a0;
        drop-shadow-offset-y: ta.has-hover ? 10px : 5px;
        animate y { duration: 140ms; easing: ease-out; }

        Rectangle {
            clip: true;
            border-radius: 12px;
            if root.has-image : Image {
                width: parent.width;
                height: parent.height;
                source: root.art;
                image-fit: cover;
            }
            if !root.has-image : Rectangle {
                background: @linear-gradient(150deg, Theme.surface-hover 0%, Theme.surface 100%);
                Text {
                    text: root.letter;
                    color: Theme.muted;
                    font-size: parent.width / 3;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
    Text {
        x: 2px;
        y: root.width + 10px;
        width: parent.width - 4px;
        height: 20px;
        text: root.title;
        color: Theme.text;
        font-size: 14px;
        font-weight: 600;
        overflow: elide;
    }
    Text {
        x: 2px;
        y: root.width + 31px;
        width: parent.width - 4px;
        height: 18px;
        text: root.artist;
        color: Theme.muted;
        font-size: 12.5px;
        overflow: elide;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Round icon button drawn from SVG-like path commands (viewbox 20x20), so no font/icon files are needed.
component IconButton inherits Rectangle {
    in property <string> commands;
    in property <length> icon-size: 18px;
    in property <color> icon-color: Theme.text;
    in property <color> idle-color: transparent;
    in property <color> hover-color: Theme.surface-hover;
    callback clicked();

    border-radius: self.width / 2;
    background: ta.has-hover ? root.hover-color : root.idle-color;

    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.icon-size;
        height: root.icon-size;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: root.commands;
        fill: root.icon-color;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Seek bar: click or drag. Calls `seek` with 0..1 when the mouse is released.
component SeekBar inherits Rectangle {
    in property <float> ratio;
    /// Track length in seconds (0 = unknown); the wheel seeks by 5 s per notch.
    in property <float> duration-secs: 0;
    callback seek(float);
    property <float> drag: 0;
    height: 20px;

    function ratio-at(x: length) -> float {
        return max(0.0, min(1.0, x / root.width));
    }

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.surface-hover;
        Rectangle {
            x: 0px;
            width: parent.width * (ta.pressed ? root.drag : root.ratio);
            height: parent.height;
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.text;
        visible: ta.has-hover || ta.pressed;
        x: root.width * (ta.pressed ? root.drag : root.ratio) - self.width / 2;
        y: (parent.height - self.height) / 2;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left) {
                if (event.kind == PointerEventKind.down) {
                    root.drag = root.ratio-at(self.mouse-x);
                } else if (event.kind == PointerEventKind.up) {
                    root.seek(root.ratio-at(self.mouse-x));
                }
            }
        }
        moved => {
            if (self.pressed) {
                root.drag = root.ratio-at(self.mouse-x);
            }
        }
        scroll-event(event) => {
            if (root.duration-secs <= 0) {
                return reject;
            }
            // One wheel notch = 60 px in Slint; wheel up = forward.
            root.seek(max(0.0, min(1.0, root.ratio + (event.delta-y / 60px) * 5.0 / root.duration-secs)));
            return accept;
        }
    }
}

// Volume slider: sets the value while the mouse is pressed or dragged.
component VolumeBar inherits Rectangle {
    in property <float> value;
    callback edited(float);
    height: 20px;

    function ratio-at(x: length) -> float {
        return max(0.0, min(1.0, x / root.width));
    }

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.surface-hover;
        Rectangle {
            x: 0px;
            width: parent.width * root.value;
            height: parent.height;
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.text;
        visible: ta.has-hover || ta.pressed;
        x: root.width * root.value - self.width / 2;
        y: (parent.height - self.height) / 2;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.edited(root.ratio-at(self.mouse-x));
            }
        }
        moved => {
            if (self.pressed) {
                root.edited(root.ratio-at(self.mouse-x));
            }
        }
        scroll-event(event) => {
            // 5 % per wheel notch, wheel up = louder.
            root.edited(max(0.0, min(1.0, root.value + (event.delta-y / 60px) * 0.05)));
            return accept;
        }
    }
}

// Slider over any range (sound settings): sets the value while the mouse is pressed or dragged.
component FxSlider inherits Rectangle {
    in property <float> lo: 0;
    in property <float> hi: 1;
    in property <float> value;
    /// Change per wheel notch.
    in property <float> wheel-step: 0.5;
    callback edited(float);
    height: 20px;

    property <float> fraction: (root.value - root.lo) / (root.hi - root.lo);

    function value-at(x: length) -> float {
        return root.lo + (root.hi - root.lo) * max(0.0, min(1.0, x / root.width));
    }

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.surface-hover;
        Rectangle {
            x: 0px;
            width: parent.width * max(0.0, min(1.0, root.fraction));
            height: parent.height;
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.text;
        x: root.width * max(0.0, min(1.0, root.fraction)) - self.width / 2;
        y: (parent.height - self.height) / 2;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.edited(root.value-at(self.mouse-x));
            }
        }
        moved => {
            if (self.pressed) {
                root.edited(root.value-at(self.mouse-x));
            }
        }
        scroll-event(event) => {
            root.edited(max(root.lo, min(root.hi, root.value + (event.delta-y / 60px) * root.wheel-step)));
            return accept;
        }
    }
}

// One row of the sound panel: label, slider, value text.
component FxRow inherits Rectangle {
    in property <string> label;
    in property <string> value-text;
    in property <float> lo: 0;
    in property <float> hi: 1;
    in property <float> value;
    in property <float> wheel-step: 0.5;
    callback edited(float);
    height: 22px;

    HorizontalLayout {
        spacing: 10px;
        Text {
            text: root.label;
            width: 64px;
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
        FxSlider {
            lo: root.lo;
            hi: root.hi;
            value: root.value;
            wheel-step: root.wheel-step;
            edited(v) => { root.edited(v); }
        }
        Text {
            text: root.value-text;
            width: 56px;
            color: Theme.text;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// Three vertical dots at the end of a track row; `open` gets the window position of the click.
component MoreButton inherits Rectangle {
    callback open(length, length);

    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: ta.has-hover ? Theme.surface-hover : transparent;

    for k in 3 : Rectangle {
        x: (parent.width - 4px) / 2;
        y: 4px + k * 8px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: ta.has-hover ? Theme.text : Theme.muted;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
    }
}

// One line of the track context menu.
component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> dim: false;
    callback clicked();

    height: 34px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.surface-hover : transparent;

    Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.text;
        color: root.dim ? Theme.muted : Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Text toggle (Shuffle / Repeat): accent color when active.
component ToggleText inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();

    border-radius: 14px;
    background: root.active ? Theme.accent.with-alpha(0.2)
        : ta.has-hover ? Theme.surface-hover : transparent;

    Text {
        text: root.text;
        color: root.active ? Theme.accent : Theme.muted;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();

    height: 34px;
    border-radius: 17px;
    background: root.active ? Theme.accent.with-alpha(0.2)
        : ta.has-hover ? Theme.surface-hover : Theme.surface;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.text;
            color: root.active ? Theme.accent : Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Centers a fixed-height child vertically inside a stretching layout.
component HeaderItem inherits Rectangle {
    VerticalLayout {
        alignment: center;
        @children
    }
}

component SearchField inherits Rectangle {
    in-out property <string> value;
    callback edited(string);
    height: 40px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.surface-hover;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        Rectangle {
            width: 16px;
            height: 40px;
            background: transparent;
            Path {
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M 10 2 Q 2 2 2 10 Q 2 18 10 18 Q 18 18 18 10 Q 18 2 10 2 Z M 10 5 Q 15 5 15 10 Q 15 15 10 15 Q 5 15 5 10 Q 5 5 10 5 Z M 16 14 L 23 21 L 21 23 L 14 16 Z";
                fill: Theme.muted;
            }
        }
        TextInput {
            text: root.value;
            height: 40px;
            color: Theme.text;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            edited => { root.value = self.text; root.edited(self.text); }
        }
    }
}

// Small preset chip in the sound panel.
component PillPreset inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 26px;
    border-radius: 13px;
    background: ta.has-hover ? Theme.surface-hover : Theme.bg;

    Text {
        text: root.text;
        color: Theme.text;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "Radiant";
    preferred-width: 900px;
    preferred-height: 640px;
    min-width: 640px;
    min-height: 360px;
    background: Theme.bg;
    default-font-size: 14px;

    in property <[TrackRow]> tracks;

    // Track list grid: every column has an absolute position so rows line up exactly.
    // Narrow windows drop the Year column first, then Album.
    private property <length> col-pad: 20px;
    private property <length> col-gap: 16px;
    private property <length> num-w: 36px;
    private property <length> dur-w: 52px;
    private property <length> row-h: 56px;
    private property <length> list-w: root.width;
    private property <bool> show-album: root.list-w >= 700px;
    private property <bool> show-year: root.list-w >= 860px;
    private property <length> year-w: root.show-year ? 52px : 0px;
    // The right edge leaves room for the list's scroll bar.
    private property <length> right-pad: 32px;
    private property <length> dots-w: 28px;
    private property <length> content-right: root.list-w - root.right-pad - 14px;
    private property <length> dots-x: root.content-right - root.dots-w;
    // Right edge of the Time column: the three dots sit to its right.
    private property <length> time-right: root.dots-x - 8px;
    private property <length> title-x: root.col-pad + root.num-w + root.col-gap;
    // Space shared by the title and album columns.
    private property <length> flex-w: max(0px, root.time-right - root.title-x - root.dur-w - root.col-gap
        - (root.show-year ? root.year-w + root.col-gap : 0px));
    private property <length> title-w: root.show-album ? root.flex-w * 0.56 : root.flex-w;
    private property <length> album-x: root.title-x + root.title-w + root.col-gap;
    private property <length> album-w: root.show-album ? max(0px, root.flex-w - root.title-w - root.col-gap) : 0px;
    private property <length> year-x: root.show-album ? root.album-x + root.album-w + root.col-gap
        : root.title-x + root.title-w + root.col-gap;
    private property <length> dur-x: root.time-right - root.dur-w;
    in-out property <string> search-text: "";
    in-out property <int> sort-mode: 1;
    in-out property <bool> sort-descending: false;
    in-out property <int> drag-from: -1;
    in-out property <int> drag-to: -1;
    in-out property <bool> drag-active: false;
    in-out property <bool> drag-moved: false;
    in-out property <bool> suppress-click: false;
    in property <string> status;
    in property <string> now-playing;

    // Sections: 0 = Tracks, 1 = Albums, 2 = Playlists, 3 = Queues (four fixed queues).
    in-out property <int> section: 0;
    in-out property <int> queue-index: 0;
    /// Track count of each of the four queues (set by Rust once queues exist).
    in property <[int]> queue-counts: [0, 0, 0, 0];
    callback section-changed(int, int);

    // Albums grid: tiles of at least `tile-min`, as many columns as fit, tiles stretch to fill the row.
    in property <[AlbumRow]> albums;
    callback open-album(int);
    callback play-album-track(int);
    /// Play / Shuffle buttons of the open album page.
    callback play-album();
    callback shuffle-album();
    // Open album page (tracks in tag order, like a CD booklet).
    in-out property <bool> album-open: false;
    in property <[AlbumTrackRow]> album-tracks;
    in property <string> album-title;
    in property <string> album-artist;
    in property <string> album-meta;
    in property <image> album-cover;
    in property <bool> album-has-cover: false;
    in property <string> album-letter;
    /// Row of the playing track in `album-tracks`, -1 = none.
    in property <int> album-current-index: -1;
    private property <length> detail-row-h: 52px;
    private property <length> album-side: 152px;
    private property <length> album-title-w: max(0px, root.width - 2 * root.album-side);
    private property <length> album-list-title-w: max(0px, root.time-right - root.title-x - root.dur-w - root.col-gap);
    callback album-shown(int);
    private property <length> grid-pad: 28px;
    private property <length> grid-gap: 22px;
    private property <length> tile-min: 190px;
    private property <length> grid-w: root.width - 2 * root.grid-pad - 10px;
    private property <int> album-cols: max(2, Math.floor((root.grid-w + root.grid-gap) / (root.tile-min + root.grid-gap)));
    private property <length> tile-w: (root.grid-w - (root.album-cols - 1) * root.grid-gap) / root.album-cols;
    private property <length> album-row-h: root.tile-w + 52px + 20px;
    private property <int> album-rows: Math.ceil(root.albums.length / root.album-cols);
    // Section switcher ("lens"): the open section unfolds into its label, "Queues" also into four queue dots.
    private property <length> seg-w: 40px;
    private property <length> seg-gap: 2px;
    private property <length> chips-extra: 126px;
    private property <length> open-extra: root.nav-items[root.section].extra + (root.section == 3 ? root.chips-extra : 0px);
    private property <length> lens-w: 4 * root.seg-w + 3 * root.seg-gap + root.open-extra + 6px;
    private property <float> wheel-acc: 0;
    private property <[NavItem]> nav-items: [
        { label: "Tracks", icon: "M 8 3 L 17 1 V 12.5 A 2.5 2.5 0 1 1 15 10.5 V 5.2 L 10 6.2 V 14.5 A 2.5 2.5 0 1 1 8 12.5 Z", extra: 52px },
        { label: "Albums", icon: "M 10 2 A 8 8 0 1 1 9.99 2 Z M 10 7.5 A 2.5 2.5 0 1 1 9.99 7.5 Z", extra: 58px },
        { label: "Playlists", icon: "M 2 4 H 14 V 6 H 2 Z M 2 8 H 14 V 10 H 2 Z M 2 12 H 9 V 14 H 2 Z M 12 11.5 L 18 14.5 L 12 17.5 Z", extra: 66px },
        { label: "Queues", icon: "M 2 4 H 14 V 6 H 2 Z M 2 8 H 14 V 10 H 2 Z M 2 12 H 8 V 14 H 2 Z M 15.5 7 H 17.5 V 15 A 2 2 0 1 1 15.5 13 Z", extra: 58px },
    ];
    // Left edge of segment `i`: segments after the open one are pushed right by its extra width.
    pure function seg-x(i: int, open: int, extra: length) -> length {
        return 3px + i * (root.seg-w + root.seg-gap) + (open < i ? extra : 0px);
    }
    // Mouse wheel over the switcher: one notch = next / previous section (or queue, with the pointer on the dots).
    function wheel(delta: length, on-queues: bool) {
        root.wheel-acc += delta / 60px;
        if (root.wheel-acc <= -1 || root.wheel-acc >= 1) {
            let step = root.wheel-acc < 0 ? 1 : -1;
            root.wheel-acc = 0;
            if (on-queues) {
                root.go-queue(max(0, min(3, root.queue-index + step)));
            } else {
                root.go-section(max(0, min(3, root.section + step)));
            }
        }
    }
    function go-section(s: int) {
        if (s == 1 && root.section == 1) { root.album-open = false; }
        root.section = s;
        root.show-sort = false;
        root.section-changed(s, root.queue-index);
    }
    function go-queue(q: int) {
        root.section = 3;
        root.queue-index = q;
        root.show-sort = false;
        root.section-changed(3, q);
    }

    // Big player view ("Emitter"): cover inside a progress ring, glow from the cover, side tabs.
    in-out property <bool> show-player: false;
    /// 0 = Lyrics, 1 = Sound, 2 = Info, -1 = none (narrow windows only).
    in-out property <int> player-tab: 0;
    in property <string> np-title;
    in property <string> np-sub;
    in property <string> np-quality;
    in property <string> np-letter;
    in property <image> np-cover;
    in property <bool> np-has-cover: false;
    in property <color> glow-color: #8b6cff;
    in property <[InfoRow]> np-info;
    /// Spectrum rays around the ring (SVG path strings in a 1000 x 1000 box, built in rays.rs).
    in property <string> rays-halo;
    in property <string> rays-body;
    in property <string> rays-tips;
    in property <string> rays-peaks;
    /// Low-frequency energy 0..1: the glow breathes with the bass.
    in property <float> pulse: 0;
    in property <[LyricRow]> lyrics;
    in property <bool> lyrics-synced: false;
    /// Index of the current line of synchronized lyrics, -1 = before the first line.
    in property <int> lyric-index: -1;

    private property <length> header-h: 48px;
    private property <length> bar-h: 112px;
    private property <length> player-h: root.height - root.bar-h;
    private property <bool> wide: root.width >= 820px;
    private property <length> side-w: root.wide ? 380px : root.width;
    private property <length> side-x: root.width - root.side-w;
    private property <length> stage-w: root.wide ? root.side-x : root.width;
    private property <int> eff-tab: (root.wide && root.player-tab < 0) ? 0 : root.player-tab;
    private property <bool> side-open: root.wide || root.player-tab >= 0;
    private property <bool> stage-visible: root.wide || root.player-tab < 0;
    private property <length> card-x: root.wide ? root.side-x : 12px;
    private property <length> card-w: root.wide ? root.side-w - 12px : root.width - 24px;
    private property <length> card-h: root.player-h - root.header-h - 12px;
    private property <bool> sound-visible: (root.show-sound && !root.show-player)
        || (root.show-player && root.eff-tab == 1);

    function pick-tab(tab: int) {
        if (root.wide) {
            root.player-tab = tab;
        } else {
            root.player-tab = root.player-tab == tab ? -1 : tab;
        }
    }
    // Position on the ring (0..1 clockwise from the top) for a mouse position inside a square of `size`.
    pure function ring-ratio-at(mx: length, my: length, size: length) -> float {
        let a = Math.atan2((mx - size / 2) / 1px, (size / 2 - my) / 1px) / 360deg;
        return a < 0 ? a + 1 : a;
    }
    // True when the mouse is on the ring itself (not on the cover inside it).
    pure function ring-hit(mx: length, my: length, size: length) -> bool {
        let dx = (mx - size / 2) / 1px;
        let dy = (my - size / 2) / 1px;
        return Math.sqrt(dx * dx + dy * dy) * 1px >= size / 2 - 22px;
    }
    in property <bool> is-playing;
    /// Index of the playing track in `tracks`, -1 if none.
    in property <int> current-index: -1;
    /// Playback position 0..1 and its texts ("1:23").
    in property <float> progress;
    in property <string> position-text;
    in property <string> duration-text;
    /// Track length in seconds, 0 if unknown (used for wheel seeking).
    in property <float> duration-secs: 0;
    in property <bool> shuffle;
    /// 0 = off, 1 = all, 2 = one.
    in property <int> repeat-mode;
    in-out property <float> volume: 1.0;
    private property <float> volume-before-mute: 0.7;

    // Sound settings panel (values are owned here; Rust keeps the same numbers for the engine).
    in-out property <bool> show-sound: false;
    in-out property <bool> show-sort: false;
    in-out property <bool> fx-normalize: false;
    in-out property <bool> fx-mono: false;
    in-out property <float> fx-bass: 0;
    in-out property <float> fx-treble: 0;
    in-out property <float> fx-subsonic: 0;
    // Playback speed slider position, -2 ..= +2 in steps of 0.1 (+2 = 3x faster, -2 = 3x slower).
    in-out property <float> speed-t: 0;
    // Label value in tenths (12 = "1.2x"); integer math avoids float noise like 1.2000001.
    private property <float> speed-n: root.speed-t >= 0
        ? (10 + root.speed-t * 10).round()
        : (10 - root.speed-t * 10).round();
    /// 12 equalizer gains in dB (model owned by Rust).
    in property <[float]> eq-gains;
    private property <[string]> eq-labels: ["32", "64", "125", "250", "500", "1k", "2k", "3.5k", "6k", "9k", "12.5k", "16k"];

    // Track context menu (three dots / right click).
    in-out property <bool> show-menu: false;
    in-out property <length> menu-x: 0px;
    in-out property <length> menu-y: 0px;
    /// Row the menu was opened for (index in `tracks`, or in `album-tracks` when `menu-in-album`).
    in-out property <int> menu-row: -1;
    in-out property <bool> menu-in-album: false;
    private property <length> menu-w: 156px;
    private property <length> menu-h: 3 * 34px + 12px;
    /// Album (index in `albums`) the track at this row of the Tracks list belongs to, -1 = not found.
    callback album-index-of-track(int) -> int;
    callback add-to-playlist(int, bool);
    callback create-stems(int, bool);
    function open-menu(mx: length, my: length, row: int, in-album: bool) {
        root.menu-row = row;
        root.menu-in-album = in-album;
        root.menu-x = max(8px, min(mx, root.width - root.menu-w - 8px));
        root.menu-y = (my + root.menu-h + 8px > root.height) ? max(8px, my - root.menu-h) : my;
        root.show-menu = true;
    }

    callback choose-folder();
    callback search-changed(string);
    callback sort-changed(int, bool);
    callback reorder-tracks(int, int);
    callback play-track(int);
    callback toggle-play();
    callback next-track();
    callback previous-track();
    callback seek(float);
    callback volume-changed(float);
    callback shuffle-changed(bool);
    callback repeat-changed(int);
    callback normalize-changed(bool);
    callback mono-changed(bool);
    callback bass-changed(float);
    callback treble-changed(float);
    callback subsonic-changed(float);
    callback speed-changed(float);
    callback eq-changed(int, float);
    /// Names of the EQ presets (set by Rust from radiant-dsp).
    in property <[string]> eq-preset-names;
    callback eq-preset-selected(int);
    callback fx-reset();

    VerticalLayout {
        // ---- header ----
        Rectangle {
            height: 64px;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 16px;
                Text {
                    text: "Radiant";
                    color: Theme.text;
                    font-size: 22px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                HeaderItem {
                    horizontal-stretch: 1;
                    SearchField {
                        value: root.search-text;
                        edited(text) => { root.search-text = text; root.search-changed(text); }
                    }
                }
                Text {
                    text: root.status;
                    color: Theme.muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.section == 0 : HeaderItem {
                    PillButton {
                        text: "Sort";
                        active: root.show-sort;
                        clicked => { root.show-sort = !root.show-sort; root.show-sound = false; }
                    }
                }
                HeaderItem {
                    PillButton {
                        text: "Sound";
                        active: root.show-sound;
                        clicked => { root.show-sound = !root.show-sound; root.show-sort = false; }
                    }
                }
                HeaderItem {
                    PillButton {
                        text: "Choose folder";
                        clicked => { root.choose-folder(); }
                    }
                }
            }
        }

        // ---- section bar: the lens switcher on the left, context on the right ----
        VerticalLayout {
            vertical-stretch: 1;

            Rectangle {
                height: 54px;

                // The lens: a pill that morphs. Icons only; the open section shows its name.
                Rectangle {
                    x: 20px;
                    y: 8px;
                    width: root.lens-w;
                    height: 38px;
                    border-radius: 19px;
                    background: Theme.surface;
                    animate width { duration: 280ms; easing: ease-in-out; }

                    // Glass highlight under the open segment.
                    Rectangle {
                        x: root.seg-x(root.section, root.section, root.open-extra) - 0px;
                        y: 3px;
                        width: root.seg-w + root.open-extra;
                        height: 32px;
                        border-radius: 16px;
                        background: Theme.accent.with-alpha(0.26);
                        border-width: 1px;
                        border-color: Theme.accent.with-alpha(0.55);
                        animate x { duration: 280ms; easing: ease-in-out; }
                        animate width { duration: 280ms; easing: ease-in-out; }
                    }
                    for item[i] in root.nav-items : Rectangle {
                        x: root.seg-x(i, root.section, root.open-extra);
                        y: 3px;
                        width: root.seg-w + (i == root.section ? root.open-extra : 0px);
                        height: 32px;
                        border-radius: 16px;
                        clip: true;
                        background: seg-ta.has-hover && i != root.section ? Theme.surface-hover : transparent;
                        animate x { duration: 280ms; easing: ease-in-out; }
                        animate width { duration: 280ms; easing: ease-in-out; }

                        Path {
                            x: 10px;
                            y: 6px;
                            width: 20px;
                            height: 20px;
                            viewbox-width: 20;
                            viewbox-height: 20;
                            commands: item.icon;
                            fill: i == root.section ? Theme.accent.brighter(0.5) : Theme.muted;
                            fill-rule: evenodd;
                        }
                        Text {
                            x: 36px;
                            width: item.extra;
                            height: parent.height;
                            text: item.label;
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                            opacity: i == root.section ? 1 : 0;
                            animate opacity { duration: 220ms; }
                        }
                        // Click = open; wheel = previous / next section.
                        seg-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.go-section(i); }
                            scroll-event(e) => {
                                root.wheel(e.delta-y, false);
                                return accept;
                            }
                        }

                        // The four queues: filled = has tracks, ring = empty, bright = open.
                        if i == 3 && root.section == 3 : Rectangle {
                            x: root.seg-w + item.extra - 4px;
                            width: root.chips-extra;
                            height: parent.height;
                            // Wheel over the dots = previous / next queue (under the dots, so their clicks still work).
                            TouchArea {
                                width: parent.width;
                                height: parent.height;
                                scroll-event(e) => {
                                    root.wheel(e.delta-y, true);
                                    return accept;
                                }
                            }
                            for q in 4 : Rectangle {
                                x: q * 30px;
                                y: 3px;
                                width: 26px;
                                height: 26px;
                                border-radius: 13px;
                                background: q == root.queue-index ? Theme.accent
                                    : root.queue-counts[q] > 0 ? Theme.accent.with-alpha(0.30)
                                    : chip-ta.has-hover ? Theme.surface-hover : transparent;
                                border-width: root.queue-counts[q] > 0 || q == root.queue-index ? 0px : 1px;
                                border-color: Theme.muted.with-alpha(0.5);
                                animate background { duration: 150ms; }
                                Text {
                                    text: q + 1;
                                    color: q == root.queue-index ? #ffffff : Theme.text;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                chip-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.go-queue(q); }
                                }
                            }
                        }
                    }
                }
                Text {
                    x: parent.width - 20px - self.width;
                    width: 260px;
                    height: parent.height;
                    text: root.section == 0 ? "\{root.tracks.length} tracks"
                        : root.section == 1 ? "\{root.albums.length} albums"
                        : root.section == 3 ? "Queue \{root.queue-index + 1} · \{root.queue-counts[root.queue-index]} tracks" : "";
                    color: Theme.muted;
                    font-size: 13px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }

            // Pages sit side by side on a strip; switching slides the strip (the direction shows where you went).
            Rectangle {
                vertical-stretch: 1;
                clip: true;

                // Albums: a grid of covers.
                Rectangle {
                    x: (1 - root.section) * parent.width;
                    width: parent.width;
                    height: parent.height;
                    clip: true;
                    animate x { duration: 320ms; easing: ease-in-out; }

                    if root.albums.length == 0 : Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.search-text == "" ? "No albums yet. Choose a music folder to start." : "No matching albums";
                        color: Theme.muted;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if root.albums.length > 0 : ListView {
                        for r in root.album-rows : Rectangle {
                            height: root.album-row-h;
                            for c in root.album-cols : Rectangle {
                                if r * root.album-cols + c < root.albums.length : AlbumTile {
                                    x: root.grid-pad + c * (root.tile-w + root.grid-gap);
                                    y: 12px;
                                    width: root.tile-w;
                                    height: root.album-row-h - 12px;
                                    art: root.albums[r * root.album-cols + c].cover;
                                    has-image: root.albums[r * root.album-cols + c].has-cover;
                                    letter: root.albums[r * root.album-cols + c].letter;
                                    title: root.albums[r * root.album-cols + c].title;
                                    artist: root.albums[r * root.album-cols + c].artist;
                                    clicked => { root.album-open = true; root.open-album(r * root.album-cols + c); }
                                    shown => { root.album-shown(r * root.album-cols + c); }
                                }
                            }
                        }
                    }

                    // Open album: slides in over the grid.
                    Rectangle {
                        x: root.album-open ? 0px : parent.width;
                        width: parent.width;
                        height: parent.height;
                        background: Theme.bg;
                        animate x { duration: 260ms; easing: ease-in-out; }

                        // Keeps clicks and the wheel away from the grid underneath.
                        TouchArea {
                            scroll-event(e) => { return accept; }
                        }

                        VerticalLayout {
                            // Header: title and artist centered in the window, cover on the right, back button on the left.
                            Rectangle {
                                height: 164px;
                                Text {
                                    x: root.album-side;
                                    y: 22px;
                                    width: root.album-title-w;
                                    height: 42px;
                                    text: root.album-title;
                                    color: Theme.text;
                                    font-size: 30px;
                                    font-weight: 800;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    x: root.album-side;
                                    y: 66px;
                                    width: root.album-title-w;
                                    height: 24px;
                                    text: root.album-artist;
                                    color: Theme.text;
                                    font-size: 17px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    x: root.album-side;
                                    y: 92px;
                                    width: root.album-title-w;
                                    height: 18px;
                                    text: root.album-meta;
                                    color: Theme.muted;
                                    font-size: 12.5px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                CoverArt {
                                    x: parent.width - 28px - self.width;
                                    y: 14px;
                                    width: 104px;
                                    height: 104px;
                                    border-radius: 10px;
                                    art: root.album-cover;
                                    has-image: root.album-has-cover;
                                    letter: root.album-letter;
                                    letter-size: 40px;
                                }
                                PillButton {
                                    x: parent.width / 2 - self.width - 6px;
                                    y: 122px;
                                    width: 110px;
                                    text: (root.album-current-index >= 0 && root.is-playing) ? "Pause" : "Play";
                                    active: root.album-current-index >= 0 && root.is-playing;
                                    clicked => {
                                        // A track of this album is loaded (started from anywhere): pause / resume it.
                                        if (root.album-current-index >= 0) { root.toggle-play(); }
                                        else { root.play-album(); }
                                    }
                                }
                                PillButton {
                                    x: parent.width / 2 + 6px;
                                    y: 122px;
                                    width: 110px;
                                    text: "Shuffle";
                                    active: root.shuffle;
                                    clicked => {
                                        if (root.shuffle) { root.shuffle-changed(false); }
                                        else if (root.album-current-index >= 0) { root.shuffle-changed(true); }
                                        else { root.shuffle-album(); }
                                    }
                                }
                                IconButton {
                                    x: 16px;
                                    y: 14px;
                                    width: 36px;
                                    height: 36px;
                                    commands: "M 12.5 3 L 5.5 10 L 12.5 17 L 14 15.5 L 8.5 10 L 14 4.5 Z";
                                    icon-size: 20px;
                                    clicked => { root.album-open = false; }
                                }
                            }

                            // Column captions.
                            Rectangle {
                                height: 30px;
                                Text {
                                    x: root.col-pad;
                                    width: root.num-w;
                                    height: parent.height;
                                    text: "#";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Text {
                                    x: root.title-x;
                                    width: root.album-list-title-w;
                                    height: parent.height;
                                    text: "Title";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    x: root.dur-x;
                                    width: root.dur-w;
                                    height: parent.height;
                                    text: "Time";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    x: root.col-pad;
                                    y: parent.height - 1px;
                                    width: parent.width - 2 * root.col-pad;
                                    height: 1px;
                                    background: Theme.surface-hover;
                                }
                            }

                            ListView {
                                vertical-stretch: 1;
                                for t[i] in root.album-tracks : Rectangle {
                                    height: root.detail-row-h;
                                    background: t.header != "" ? transparent
                                        : i == root.album-current-index ? Theme.accent.with-alpha(0.16)
                                        : arow-ta.has-hover ? Theme.surface : transparent;
                                    animate background { duration: 120ms; }

                                    // "Disc N" caption (multi-disc albums).
                                    if t.header != "" : Text {
                                        x: root.col-pad;
                                        y: 10px;
                                        width: parent.width - 2 * root.col-pad;
                                        height: parent.height - 10px;
                                        text: t.header;
                                        color: Theme.accent.brighter(0.5);
                                        font-size: 13px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    if t.header == "" : Text {
                                        x: root.col-pad;
                                        width: root.num-w;
                                        height: parent.height;
                                        text: t.no;
                                        color: i == root.album-current-index ? Theme.accent : Theme.muted;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                    if t.header == "" : Text {
                                        x: root.title-x;
                                        y: t.artist == "" ? 0px : 8px;
                                        width: root.album-list-title-w;
                                        height: t.artist == "" ? parent.height : 22px;
                                        text: t.title;
                                        color: i == root.album-current-index ? Theme.accent : Theme.text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    if t.header == "" && t.artist != "" : Text {
                                        x: root.title-x;
                                        y: 30px;
                                        width: root.album-list-title-w;
                                        height: 18px;
                                        text: t.artist;
                                        color: Theme.muted;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    if t.header == "" : Text {
                                        x: root.dur-x;
                                        width: root.dur-w;
                                        height: parent.height;
                                        text: t.duration;
                                        color: Theme.muted;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                    arow-ta := TouchArea {
                                        enabled: t.header == "";
                                        mouse-cursor: pointer;
                                        clicked => { root.play-album-track(i); }
                                        pointer-event(event) => {
                                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                                root.open-menu(arow-ta.absolute-position.x + arow-ta.mouse-x, arow-ta.absolute-position.y + arow-ta.mouse-y, i, true);
                                            }
                                        }
                                    }
                                    if t.header == "" : MoreButton {
                                        x: root.dots-x;
                                        y: (parent.height - self.height) / 2;
                                        open(mx, my) => { root.open-menu(mx, my, i, true); }
                                    }
                                }
                            }
                        }
                    }
                }

                for k in 2 : Rectangle {
                    x: (k + 2 - root.section) * parent.width;
                    width: parent.width;
                    height: parent.height;
                    animate x { duration: 320ms; easing: ease-in-out; }

                    VerticalLayout {
                        padding-left: 28px;
                        padding-right: 28px;
                        padding-top: 14px;
                        spacing: 12px;
                        alignment: start;
                        Text {
                            text: k == 0 ? "Playlists" : "Queue \{root.queue-index + 1}";
                            color: Theme.text;
                            font-size: 22px;
                            font-weight: 700;
                        }
                        if k == 1 : Rectangle {
                            height: 40px;
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                // Disabled until the queue has tracks.
                                Rectangle {
                                    width: 110px;
                                    height: 36px;
                                    border-radius: 18px;
                                    background: Theme.surface;
                                    Text { text: "Play"; color: Theme.muted.with-alpha(0.6); horizontal-alignment: center; vertical-alignment: center; }
                                }
                                Rectangle {
                                    width: 110px;
                                    height: 36px;
                                    border-radius: 18px;
                                    background: Theme.surface;
                                    Text { text: "Shuffle"; color: Theme.muted.with-alpha(0.6); horizontal-alignment: center; vertical-alignment: center; }
                                }
                            }
                        }
                        Text {
                            width: 100%;
                            text: k == 0 ? "Playlists will live here. \"Liked tracks\" always stays on top."
                                : "Queue \{root.queue-index + 1} is empty. Tracks you add to it will appear here.";
                            color: Theme.muted;
                            font-size: 15px;
                            wrap: word-wrap;
                        }
                    }
                }

            Rectangle {
                x: (0 - root.section) * parent.width;
                width: parent.width;
                height: parent.height;
                animate x { duration: 320ms; easing: ease-in-out; }
            VerticalLayout {

            // Column captions.
            if root.tracks.length > 0 : Rectangle {
                height: 30px;
                Text {
                    x: root.col-pad;
                    width: root.num-w;
                    height: parent.height;
                    text: "#";
                    color: Theme.muted;
                    font-size: 12px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                Text {
                    x: root.title-x;
                    width: root.title-w;
                    height: parent.height;
                    text: "Title";
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                if root.show-album : Text {
                    x: root.album-x;
                    width: root.album-w;
                    height: parent.height;
                    text: "Album";
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                if root.show-year : Text {
                    x: root.year-x;
                    width: root.year-w;
                    height: parent.height;
                    text: "Year";
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Text {
                    x: root.dur-x;
                    width: root.dur-w;
                    height: parent.height;
                    text: "Time";
                    color: Theme.muted;
                    font-size: 12px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                Rectangle {
                    x: root.col-pad;
                    y: parent.height - 1px;
                    width: parent.width - 2 * root.col-pad;
                    height: 1px;
                    background: Theme.surface-hover;
                }
            }

            if root.tracks.length == 0 : Rectangle {
                vertical-stretch: 1;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.search-text == "" ? "Choose a music folder to start" : "No matching tracks";
                    color: Theme.muted;
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.tracks.length > 0 : ListView {
                vertical-stretch: 1;
                for t[i] in root.tracks : Rectangle {
                    height: root.row-h;
                    background: root.drag-active && i == root.drag-from ? Theme.accent.with-alpha(0.28)
                        : i == root.current-index ? Theme.accent.with-alpha(0.16)
                        : row-ta.has-hover ? Theme.surface : transparent;
                    animate y { duration: 180ms; easing: ease-in-out; }
                    animate background { duration: 120ms; }

                    if root.drag-active && i == root.drag-to : Rectangle {
                        x: 12px;
                        y: root.drag-to > root.drag-from ? parent.height - 2px : 0px;
                        width: parent.width - 24px;
                        height: 2px;
                        background: Theme.accent;
                    }

                    // 1. number
                    Text {
                        x: root.col-pad;
                        width: root.num-w;
                        height: parent.height;
                        text: i + 1;
                        color: i == root.current-index ? Theme.accent : Theme.muted;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    // 2. cover, title and artist
                    CoverArt {
                        x: root.title-x;
                        y: (parent.height - self.height) / 2;
                        art: t.cover;
                        has-image: t.has-cover;
                        letter: t.letter;
                    }
                    Text {
                        x: root.title-x + 52px;
                        y: t.artist == "" ? 0px : 8px;
                        width: max(0px, root.title-w - 52px);
                        height: t.artist == "" ? parent.height : 22px;
                        text: t.title;
                        color: i == root.current-index ? Theme.accent : Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if t.artist != "" : Text {
                        x: root.title-x + 52px;
                        y: 30px;
                        width: max(0px, root.title-w - 52px);
                        height: 18px;
                        text: t.artist;
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    // 3. album
                    if root.show-album : Text {
                        x: root.album-x;
                        width: root.album-w;
                        height: parent.height;
                        text: t.album;
                        color: Theme.muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    // 4. year
                    if root.show-year : Text {
                        x: root.year-x;
                        width: root.year-w;
                        height: parent.height;
                        text: t.year;
                        color: Theme.muted;
                        vertical-alignment: center;
                    }
                    // 5. duration
                    Text {
                        x: root.dur-x;
                        width: root.dur-w;
                        height: parent.height;
                        text: t.duration;
                        color: Theme.muted;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    row-ta := TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                root.open-menu(row-ta.absolute-position.x + row-ta.mouse-x, row-ta.absolute-position.y + row-ta.mouse-y, i, false);
                            }
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                root.suppress-click = false;
                            }
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down && root.search-text == "") {
                                root.drag-from = i;
                                root.drag-to = i;
                                root.drag-active = true;
                                root.drag-moved = false;
                            } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.drag-active) {
                                if (root.drag-moved && root.drag-from != root.drag-to) {
                                    root.reorder-tracks(root.drag-from, root.drag-to);
                                    root.suppress-click = true;
                                }
                                root.drag-active = false;
                                root.drag-moved = false;
                            }
                        }
                        moved => {
                            if (self.pressed && root.drag-active) {
                                let target = max(0, min(root.tracks.length - 1,
                                    i + ((self.mouse-y - self.pressed-y) / root.row-h).round()));
                                if (target != root.drag-to) {
                                    root.drag-to = target;
                                    root.drag-moved = true;
                                }
                            }
                        }
                        clicked => {
                            if (root.suppress-click) { root.suppress-click = false; }
                            else { root.play-track(i); }
                        }
                    }
                    MoreButton {
                        x: root.dots-x;
                        y: (parent.height - self.height) / 2;
                        open(mx, my) => { root.open-menu(mx, my, i, false); }
                    }
                }
            }
            }
            }
            }
        }

        // ---- player bar ----
        Rectangle {
            height: 112px;
            background: Theme.surface;

            VerticalLayout {
            padding-top: 8px;
            spacing: 0px;

            HorizontalLayout {
                height: 24px;
                padding-left: 24px;
                padding-right: 24px;
                spacing: 12px;
                Text {
                    text: root.position-text;
                    width: 44px;
                    color: Theme.muted;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                SeekBar {
                    ratio: root.progress;
                    duration-secs: root.duration-secs;
                    seek(r) => { root.seek(r); }
                }
                Text {
                    text: root.duration-text;
                    width: 44px;
                    color: Theme.muted;
                    vertical-alignment: center;
                }
            }

            // Control row: every block has an absolute position, so the title length
            // can never move the buttons. Transport is centered in the window, the title
            // takes the space to its left, volume sits at the right edge.
            Rectangle {
                vertical-stretch: 1;

                // Cover of the playing track (or a tile with its first letter), like in the list.
                if root.now-playing != "" : CoverArt {
                    x: 24px;
                    y: (parent.height - self.height) / 2;
                    width: 52px;
                    height: 52px;
                    border-radius: 8px;
                    art: root.np-cover;
                    has-image: root.np-has-cover;
                    letter: root.np-letter;
                    letter-size: 22px;
                }
                Text {
                    x: root.now-playing != "" ? 88px : 24px;
                    width: max(0px, (parent.width - 348px) / 2 - (root.now-playing != "" ? 88px : 24px) - 16px);
                    height: parent.height;
                    text: root.now-playing;
                    color: root.show-player ? Theme.accent : Theme.text;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                // Click the title to open / close the big player view.
                TouchArea {
                    x: 24px;
                    width: max(0px, (parent.width - 348px) / 2 - 24px - 16px);
                    height: parent.height;
                    enabled: root.now-playing != "";
                    mouse-cursor: pointer;
                    clicked => {
                        root.show-player = !root.show-player;
                        root.show-sort = false;
                        root.show-sound = false;
                    }
                }

                // Center: transport controls.
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 348px;
                    height: 52px;
                    ToggleText {
                        x: 0px;
                        y: 12px;
                        width: 84px;
                        height: 28px;
                        text: "Shuffle";
                        active: root.shuffle;
                        clicked => { root.shuffle-changed(!root.shuffle); }
                    }
                    IconButton {
                        x: 96px;
                        y: 6px;
                        width: 40px;
                        height: 40px;
                        commands: "M 1 0 H 4 V 20 H 1 Z M 19 0 V 20 L 6 10 Z";
                        clicked => { root.previous-track(); }
                    }
                    IconButton {
                        x: 148px;
                        y: 0px;
                        width: 52px;
                        height: 52px;
                        icon-size: 20px;
                        icon-color: #ffffff;
                        idle-color: Theme.accent;
                        hover-color: Theme.accent.brighter(0.2);
                        commands: root.is-playing
                            ? "M 3 0 H 8 V 20 H 3 Z M 12 0 H 17 V 20 H 12 Z"
                            : "M 4 0 L 19 10 L 4 20 Z";
                        clicked => { root.toggle-play(); }
                    }
                    IconButton {
                        x: 212px;
                        y: 6px;
                        width: 40px;
                        height: 40px;
                        commands: "M 16 0 H 19 V 20 H 16 Z M 1 0 L 14 10 L 1 20 Z";
                        clicked => { root.next-track(); }
                    }
                    ToggleText {
                        x: 264px;
                        y: 12px;
                        width: 84px;
                        height: 28px;
                        text: root.repeat-mode == 0 ? "Repeat"
                            : root.repeat-mode == 1 ? "Repeat all" : "Repeat one";
                        active: root.repeat-mode != 0;
                        clicked => { root.repeat-changed(root.repeat-mode >= 2 ? 0 : root.repeat-mode + 1); }
                    }
                }

                // Right: volume (click the speaker to mute / unmute).
                Rectangle {
                    x: parent.width - 24px - self.width;
                    y: (parent.height - self.height) / 2;
                    width: 150px;
                    height: 28px;
                    IconButton {
                        x: 0px;
                        y: 0px;
                        width: 28px;
                        height: 28px;
                        icon-size: 16px;
                        icon-color: root.volume <= 0.001 ? Theme.muted : Theme.text;
                        commands: "M 1 7 H 5 L 11 2 V 18 L 5 13 H 1 Z M 13 6 Q 16.5 10 13 14 L 14.5 15.5 Q 19.5 10 14.5 4.5 Z";
                        clicked => {
                            if (root.volume > 0.001) {
                                root.volume-before-mute = root.volume;
                                root.volume = 0.0;
                            } else {
                                root.volume = root.volume-before-mute;
                            }
                            root.volume-changed(root.volume);
                        }
                    }
                    VolumeBar {
                        x: 36px;
                        y: 4px;
                        width: 110px;
                        height: 20px;
                        value: root.volume;
                        edited(v) => {
                            root.volume = v;
                            root.volume-changed(v);
                        }
                    }
                }
            }
            }
        }
    }

    // ---- big player view: covers the track list, the player bar below stays usable ----
    if root.show-player : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.player-h;
        background: Theme.bg;
        clip: true;

        // Swallows every mouse event the player does not use itself, so clicks never fall
        // through to the track list underneath (they used to start another track).
        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        // Stage: glow, progress ring, cover, title.
        if root.stage-visible : stage := Rectangle {
            x: 0px;
            y: root.header-h;
            width: root.stage-w;
            height: root.player-h - root.header-h;

            property <length> zone-h: self.height - 76px;
            // The rays need 20 % of the ring diameter on every side.
            property <length> ring-d: max(90px, min(self.zone-h, min(self.width - 40px, 500px)) / 1.4);
            property <length> ring-x: (self.width - self.ring-d) / 2;
            property <length> ring-y: max(0px, (self.zone-h - self.ring-d) / 2);
            property <float> ring-drag: 0;
            property <bool> ring-band: false;
            property <float> ring-ratio: ring-ta.pressed && self.ring-band ? self.ring-drag : root.progress;
            property <float> ring-c: self.ring-d / 2px;
            property <float> ring-r: self.ring-c - 2;
            property <angle> ring-angle: min(self.ring-ratio, 0.9999) * 360deg;
            property <float> ring-x1: self.ring-c + self.ring-r * Math.sin(self.ring-angle);
            property <float> ring-y1: self.ring-c - self.ring-r * Math.cos(self.ring-angle);

            // Light spilling out of the cover; it swells a little with the bass.
            Rectangle {
                x: stage.ring-x - stage.ring-d * (0.45 + 0.2 * root.pulse);
                y: stage.ring-y - stage.ring-d * (0.45 + 0.2 * root.pulse);
                width: stage.ring-d * (1.9 + 0.4 * root.pulse);
                height: stage.ring-d * (1.9 + 0.4 * root.pulse);
                background: @radial-gradient(circle, root.glow-color.with-alpha(0.30 + 0.40 * root.pulse) 0%, root.glow-color.with-alpha(0) 70%);
            }
            // Spectrum rays: soft halo, body, bright tips, falling peak markers.
            Path {
                x: stage.ring-x - stage.ring-d * 0.2;
                y: stage.ring-y - stage.ring-d * 0.2;
                width: stage.ring-d * 1.4;
                height: stage.ring-d * 1.4;
                viewbox-width: 1000;
                viewbox-height: 1000;
                commands: root.rays-halo;
                fill: root.glow-color.with-alpha(0.20);
            }
            Path {
                x: stage.ring-x - stage.ring-d * 0.2;
                y: stage.ring-y - stage.ring-d * 0.2;
                width: stage.ring-d * 1.4;
                height: stage.ring-d * 1.4;
                viewbox-width: 1000;
                viewbox-height: 1000;
                commands: root.rays-body;
                fill: root.glow-color.with-alpha(0.88);
            }
            Path {
                x: stage.ring-x - stage.ring-d * 0.2;
                y: stage.ring-y - stage.ring-d * 0.2;
                width: stage.ring-d * 1.4;
                height: stage.ring-d * 1.4;
                viewbox-width: 1000;
                viewbox-height: 1000;
                commands: root.rays-tips;
                fill: root.glow-color.brighter(1.0);
            }
            Path {
                x: stage.ring-x - stage.ring-d * 0.2;
                y: stage.ring-y - stage.ring-d * 0.2;
                width: stage.ring-d * 1.4;
                height: stage.ring-d * 1.4;
                viewbox-width: 1000;
                viewbox-height: 1000;
                commands: root.rays-peaks;
                fill: #ffffffd0;
            }
            // Ring track.
            Rectangle {
                x: stage.ring-x;
                y: stage.ring-y;
                width: stage.ring-d;
                height: stage.ring-d;
                border-radius: self.width / 2;
                border-width: 4px;
                border-color: Theme.surface-hover;
            }
            // Ring progress.
            Path {
                x: stage.ring-x;
                y: stage.ring-y;
                width: stage.ring-d;
                height: stage.ring-d;
                viewbox-width: stage.ring-d / 1px;
                viewbox-height: stage.ring-d / 1px;
                commands: stage.ring-ratio < 0.002 ? "M 0 0"
                    : "M \{stage.ring-c} \{stage.ring-c - stage.ring-r} A \{stage.ring-r} \{stage.ring-r} 0 \{stage.ring-ratio > 0.5 ? 1 : 0} 1 \{stage.ring-x1} \{stage.ring-y1}";
                stroke: root.glow-color.brighter(0.2);
                stroke-width: 4px;
                stroke-line-cap: round;
            }
            // Knob at the end of the progress (hover / drag).
            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: Theme.text;
                visible: ring-ta.has-hover || ring-ta.pressed;
                x: stage.ring-x + stage.ring-x1 * 1px - 6px;
                y: stage.ring-y + stage.ring-y1 * 1px - 6px;
            }
            // Round cover.
            CoverArt {
                x: stage.ring-x + 14px;
                y: stage.ring-y + 14px;
                width: stage.ring-d - 28px;
                height: stage.ring-d - 28px;
                border-radius: self.width / 2;
                art: root.np-cover;
                has-image: root.np-has-cover;
                letter: root.np-letter;
                letter-size: stage.ring-d / 4;
            }
            // Paused: a play mark over the cover.
            if !root.is-playing : Rectangle {
                x: stage.ring-x + 14px;
                y: stage.ring-y + 14px;
                width: stage.ring-d - 28px;
                height: stage.ring-d - 28px;
                border-radius: self.width / 2;
                background: #00000066;
                Path {
                    x: (parent.width - self.width) / 2 + 2px;
                    y: (parent.height - self.height) / 2;
                    width: 28px;
                    height: 28px;
                    viewbox-width: 20;
                    viewbox-height: 20;
                    commands: "M 4 0 L 19 10 L 4 20 Z";
                    fill: #ffffff;
                }
            }
            // Ring: drag or click on the ring = seek, wheel = 5 s, click on the cover = play / pause.
            ring-ta := TouchArea {
                x: stage.ring-x;
                y: stage.ring-y;
                width: stage.ring-d;
                height: stage.ring-d;
                mouse-cursor: pointer;
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                        stage.ring-band = root.ring-hit(self.mouse-x, self.mouse-y, self.width);
                        if (stage.ring-band) {
                            stage.ring-drag = root.ring-ratio-at(self.mouse-x, self.mouse-y, self.width);
                        }
                    } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up
                        && stage.ring-band && root.duration-secs > 0) {
                        root.seek(root.ring-ratio-at(self.mouse-x, self.mouse-y, self.width));
                    }
                }
                moved => {
                    if (self.pressed && stage.ring-band) {
                        stage.ring-drag = root.ring-ratio-at(self.mouse-x, self.mouse-y, self.width);
                    }
                }
                clicked => {
                    if (!stage.ring-band) { root.toggle-play(); }
                }
                scroll-event(event) => {
                    if (root.duration-secs <= 0) {
                        return reject;
                    }
                    root.seek(max(0.0, min(1.0, root.progress + (event.delta-y / 60px) * 5.0 / root.duration-secs)));
                    return accept;
                }
            }

            // Title, "artist · album · year", quality.
            Text {
                x: 24px;
                y: parent.height - 72px;
                width: parent.width - 48px;
                height: 28px;
                text: root.np-title;
                color: Theme.text;
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: 24px;
                y: parent.height - 44px;
                width: parent.width - 48px;
                height: 20px;
                text: root.np-sub;
                color: Theme.muted;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.np-quality != "" : Rectangle {
                y: parent.height - 22px;
                height: 18px;
                width: min(parent.width - 48px, quality-text.preferred-width + 20px);
                x: (parent.width - self.width) / 2;
                border-radius: 9px;
                background: root.glow-color.with-alpha(0.18);
                quality-text := Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.np-quality;
                    color: Theme.text;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Side card: Lyrics / Info (the Sound tab shows the sound panel here, see below).
        if root.side-open : Rectangle {
            x: root.card-x;
            y: root.header-h;
            width: root.card-w;
            height: root.card-h;
            background: Theme.surface;
            border-radius: 14px;
            clip: true;

            if root.eff-tab == 0 && root.lyrics.length == 0 : Text {
                width: parent.width;
                height: parent.height;
                text: "No lyrics for this track";
                color: Theme.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            // Synchronized: the current line stays in the middle, click a line to jump there.
            if root.eff-tab == 0 && root.lyrics.length > 0 && root.lyrics-synced : Rectangle {
                clip: true;
                Rectangle {
                    y: parent.height / 2 - 20px - max(0, root.lyric-index) * 40px;
                    width: parent.width;
                    height: root.lyrics.length * 40px;
                    animate y { duration: 260ms; easing: ease-in-out; }
                    for l[i] in root.lyrics : Rectangle {
                        y: i * 40px;
                        width: parent.width;
                        height: 40px;
                        Text {
                            x: 20px;
                            width: parent.width - 40px;
                            height: parent.height;
                            text: l.text;
                            font-size: 18px;
                            horizontal-alignment: center;
                            font-weight: i == root.lyric-index ? 700 : 400;
                            color: i == root.lyric-index ? Theme.text
                                : i < root.lyric-index ? Theme.muted.with-alpha(0.45) : Theme.muted;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.duration-secs > 0) {
                                    root.seek(max(0.0, min(1.0, (l.time-ms / 1000.0) / root.duration-secs)));
                                }
                            }
                        }
                    }
                }
            }
            // Plain text: centered, comfortable size, long lines wrap instead of being cut off.
            if root.eff-tab == 0 && root.lyrics.length > 0 && !root.lyrics-synced : Flickable {
                VerticalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-top: 28px;
                    padding-bottom: 36px;
                    spacing: 9px;
                    alignment: start;
                    for l in root.lyrics : VerticalLayout {
                        if l.text == "" : Rectangle {
                            height: 12px;
                        }
                        if l.text != "" : Text {
                            text: l.text;
                            font-size: 17px;
                            color: Theme.text.with-alpha(0.92);
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
            // Info: "label  value" rows; long values (paths, titles) wrap instead of being cut off.
            if root.eff-tab == 2 : Flickable {
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    alignment: start;
                    if root.np-info.length == 0 : Text {
                        text: "No information";
                        color: Theme.muted;
                        font-size: 13px;
                    }
                    for r in root.np-info : HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Text {
                            width: 104px;
                            text: r.label;
                            color: Theme.muted;
                            font-size: 13px;
                            vertical-alignment: top;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: r.value;
                            color: Theme.text;
                            font-size: 13px;
                            wrap: word-wrap;
                            vertical-alignment: top;
                        }
                    }
                }
            }
        }

        // Header: close, caption, tabs.
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.header-h;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 16px;
                spacing: 8px;
                HeaderItem {
                    IconButton {
                        width: 40px;
                        height: 40px;
                        commands: "M 2 6 L 3.5 4.5 L 10 11 L 16.5 4.5 L 18 6 L 10 14 Z";
                        clicked => { root.show-player = false; }
                    }
                }
                Text {
                    text: "Now playing";
                    color: Theme.muted;
                    font-size: 13px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                HeaderItem {
                    PillButton {
                        text: "Lyrics";
                        active: root.side-open && root.eff-tab == 0;
                        clicked => { root.pick-tab(0); }
                    }
                }
                HeaderItem {
                    PillButton {
                        text: "Sound";
                        active: root.side-open && root.eff-tab == 1;
                        clicked => { root.pick-tab(1); }
                    }
                }
                HeaderItem {
                    PillButton {
                        text: "Info";
                        active: root.side-open && root.eff-tab == 2;
                        clicked => { root.pick-tab(2); }
                    }
                }
            }
        }
    }

    // ---- sort panel (overlay): click outside to close ----
    if root.show-sort : TouchArea {
        y: 64px;
        height: root.height - 64px;
        clicked => { root.show-sort = false; }
    }
    if root.show-sort : Rectangle {
        x: root.width - self.width - 20px;
        y: 68px;
        width: 260px;
        height: min(root.height - 78px, 290px);
        background: Theme.surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.surface-hover;
        clip: true;

        TouchArea { }
        VerticalLayout {
            padding: 16px;
            spacing: 2px;
            Text {
                text: "Sort tracks";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
                height: 26px;
            }
            for label[i] in ["Manual order", "Name", "Artist", "Album", "Duration", "File date"] : Rectangle {
                height: 28px;
                border-radius: 7px;
                background: root.sort-mode == i ? Theme.accent.with-alpha(0.2)
                    : sort-row.has-hover ? Theme.surface-hover : transparent;
                Text {
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    text: label;
                    color: root.sort-mode == i ? Theme.accent : Theme.text;
                    vertical-alignment: center;
                }
                sort-row := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.sort-mode = i;
                        if (i == 0) { root.sort-descending = false; }
                        root.sort-changed(i, root.sort-descending);
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                PillButton {
                    text: "Ascending";
                    active: root.sort-mode != 0 && !root.sort-descending;
                    clicked => {
                        root.sort-descending = false;
                        root.sort-changed(root.sort-mode, false);
                    }
                }
                PillButton {
                    text: "Descending";
                    active: root.sort-mode != 0 && root.sort-descending;
                    clicked => {
                        root.sort-descending = true;
                        root.sort-changed(root.sort-mode, true);
                    }
                }
            }
        }
    }

    // ---- sound panel (overlay): click outside to close ----
    if root.show-sound && !root.show-player : TouchArea {
        y: 64px;
        height: root.height - 64px;
        clicked => { root.show-sound = false; }
    }
    if root.sound-visible : Rectangle {
        // In the player view the panel IS the side card (same position and size, no frame of its own).
        x: root.show-player ? root.card-x : root.width - self.width - 20px;
        y: root.show-player ? root.header-h : 68px;
        width: root.show-player ? root.card-w : 360px;
        height: root.show-player ? root.card-h : min(root.height - 78px, 640px);
        background: Theme.surface;
        border-radius: root.show-player ? 14px : 12px;
        border-width: root.show-player ? 0px : 1px;
        border-color: Theme.surface-hover;
        clip: true;

        // Swallows clicks so the panel does not close itself.
        TouchArea { }

        VerticalLayout {
            padding: 16px;
            spacing: 4px;
            alignment: start;

            Text {
                text: "Sound";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
                height: 26px;
            }
            Rectangle {
                height: 32px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    ToggleText {
                        width: 96px;
                        height: 28px;
                        text: "Normalize";
                        active: root.fx-normalize;
                        clicked => {
                            root.fx-normalize = !root.fx-normalize;
                            root.normalize-changed(root.fx-normalize);
                        }
                    }
                    ToggleText {
                        width: 64px;
                        height: 28px;
                        text: "Mono";
                        active: root.fx-mono;
                        clicked => {
                            root.fx-mono = !root.fx-mono;
                            root.mono-changed(root.fx-mono);
                        }
                    }
                    ToggleText {
                        width: 64px;
                        height: 28px;
                        text: "Reset";
                        active: false;
                        clicked => { root.fx-reset(); }
                    }
                }
            }
            FxRow {
                label: "Speed";
                lo: -2;
                hi: 2;
                wheel-step: 0.1;
                value: root.speed-t;
                // 1x..3x faster, -1x..-3x slower (pitch is kept).
                value-text: (root.speed-t >= 0 ? "" : "-")
                    + "\{Math.floor(root.speed-n / 10)}.\{Math.mod(root.speed-n, 10)}x";
                edited(v) => {
                    root.speed-t = (v * 10).round() / 10; // steps of 0.1
                    root.speed-changed(root.speed-t);
                }
            }
            FxRow {
                label: "Bass";
                lo: 0;
                hi: 15;
                value: root.fx-bass;
                value-text: "\{(root.fx-bass * 2).round() / 2} dB";
                edited(v) => {
                    root.fx-bass = v;
                    root.bass-changed(v);
                }
            }
            FxRow {
                label: "Treble";
                lo: 0;
                hi: 15;
                value: root.fx-treble;
                value-text: "\{(root.fx-treble * 2).round() / 2} dB";
                edited(v) => {
                    root.fx-treble = v;
                    root.treble-changed(v);
                }
            }
            FxRow {
                label: "Subsonic";
                lo: 0;
                hi: 100;
                wheel-step: 1;
                value: root.fx-subsonic;
                value-text: "\{root.fx-subsonic.round()} %";
                edited(v) => {
                    root.fx-subsonic = v;
                    root.subsonic-changed(v);
                }
            }
            Text {
                text: "Equalizer";
                color: Theme.muted;
                font-size: 12px;
                height: 24px;
                vertical-alignment: bottom;
            }
            // Presets: two rows of five buttons.
            for row in [0, 1] : Rectangle {
                height: 30px;
                // Explicit positions (no layout): 5 chips of 62 px with 4 px gaps = 326 px.
                for name[k] in root.eq-preset-names : PillPreset {
                    x: (k - row * 5) * 66px;
                    y: 2px;
                    width: 62px;
                    visible: k >= row * 5 && k < row * 5 + 5;
                    text: name;
                    clicked => { root.eq-preset-selected(k); }
                }
            }
            for g[i] in root.eq-gains : FxRow {
                label: root.eq-labels[i] + " Hz";
                lo: -12;
                hi: 12;
                value: g;
                value-text: "\{(g * 2).round() / 2} dB";
                edited(v) => { root.eq-changed(i, v); }
            }
        }
    }
    // ---- track context menu (overlay): click outside to close ----
    if root.show-menu : TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.show-menu = false; }
        }
        scroll-event(e) => { root.show-menu = false; return accept; }
    }
    if root.show-menu : Rectangle {
        x: root.menu-x;
        y: root.menu-y;
        width: root.menu-w;
        height: root.menu-h;
        background: Theme.surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.surface-hover;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000080;
        drop-shadow-offset-y: 4px;

        TouchArea { }
        VerticalLayout {
            padding: 6px;
            MenuItem {
                text: "Open album";
                clicked => {
                    root.show-menu = false;
                    if (!root.menu-in-album) {
                        let a = root.album-index-of-track(root.menu-row);
                        if (a >= 0) {
                            root.go-section(1);
                            root.album-open = true;
                            root.open-album(a);
                        }
                    }
                }
            }
            MenuItem {
                text: "Add to playlist";
                clicked => { root.show-menu = false; root.add-to-playlist(root.menu-row, root.menu-in-album); }
            }
            MenuItem {
                text: "Create stems";
                clicked => { root.show-menu = false; root.create-stems(root.menu-row, root.menu-in-album); }
            }
        }
    }
}
