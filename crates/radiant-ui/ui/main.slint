// Main window.
// DONE: volume slider (+ mute), shuffle / repeat toggles, seek bar with times; header (folder button, status), track list (left-aligned, hover/current highlight, click = play),
//       bottom player bar (prev / play-pause / next, now playing), empty state. Custom widgets, no std-widgets.
// TODO: tabs (Playlists / Albums / Tracks / Queues), search, sorting, volume, cover,
//       quality badge, themes (light / true-black / system), translations via @tr().
//       Colors live in `Theme`: when themes are added, turn it into a switchable set.

import { ListView } from "std-widgets.slint";

global Theme {
    out property <color> bg: #131316;
    out property <color> surface: #1b1b20;
    out property <color> surface-hover: #24242b;
    out property <color> accent: #8b6cff;
    out property <color> text: #ececf2;
    out property <color> muted: #8d8d9b;
}

// One row of the track list (filled by Rust).
export struct TrackRow {
    title: string,
    artist: string,
    album: string,
    year: string,
    duration: string,
    /// First letter of the title, shown while there is no cover.
    letter: string,
    cover: image,
    has-cover: bool,
}

// One line of the lyrics (time-ms = -1 for plain, unsynchronized lyrics).
export struct LyricRow {
    text: string,
    time-ms: int,
}

// One album of the Albums grid (filled by Rust).
export struct AlbumRow {
    title: string,
    artist: string,
    letter: string,
    cover: image,
    has-cover: bool,
}

// One row of the open album: a track, or a "Disc N" caption (header != "") on multi-disc albums.
export struct AlbumTrackRow {
    /// Track number from the tags (as on a CD); empty for captions.
    no: string,
    title: string,
    /// Shown under the title only when it differs from the album artist.
    artist: string,
    duration: string,
    header: string,
}

// One entry of the section rail.
export struct NavItem {
    label: string,
    icon: string,
    /// Extra width the segment gets while it is the open one (room for the label).
    extra: length,
}

// One "label: value" line of the Info tab.
export struct InfoRow {
    label: string,
    value: string,
}

// One record sleeve of the "Add to playlist" window (filled by Rust).
export struct PlaylistCard {
    name: string,
    count: string,
    letter: string,
    color-a: color,
    color-b: color,
    /// The track the window works on is already in this playlist.
    added: bool,
    liked: bool,
}

// A folder in the folder picker.
export struct FolderChip {
    id: string,
    name: string,
}

// One line of the Playlists page: a folder header or a playlist.
export struct PlaylistListRow {
    is-folder: bool,
    name: string,
    sub: string,
    letter: string,
    color-a: color,
    color-b: color,
    liked: bool,
    collapsed: bool,
    /// Playlist inside a folder.
    indent: bool,
}

// One track of the open playlist page. `missing`: the file is no longer in the library.
export struct PlTrackRow {
    no: string,
    title: string,
    artist: string,
    duration: string,
    missing: bool,
}

// Square cover: the picture, or a quiet tile with a letter when there is none.
component CoverArt inherits Rectangle {
    in property <image> art;
    in property <bool> has-image: false;
    in property <string> letter;
    in property <length> letter-size: 16px;

    width: 40px;
    height: 40px;
    border-radius: 6px;
    clip: true;
    background: Theme.surface-hover;

    if root.has-image : Image {
        width: parent.width;
        height: parent.height;
        source: root.art;
        image-fit: cover;
    }
    if !root.has-image : Text {
        width: parent.width;
        height: parent.height;
        text: root.letter;
        color: Theme.muted;
        font-size: root.letter-size;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Album tile: big square cover with a soft shadow, title and artist underneath.
// Hover: the cover lifts a little. `shown` fires when the tile is created
// (the grid is virtualized, so this is how Rust learns which covers are needed).
component AlbumTile inherits Rectangle {
    in property <image> art;
    in property <bool> has-image: false;
    in property <string> letter;
    in property <string> title;
    in property <string> artist;
    /// The tile is being dragged (manual order): dimmed. `drop-target`: the tile the dragged one will take the place of.
    in property <bool> dragging: false;
    in property <bool> drop-target: false;
    callback clicked();
    callback shown();
    callback drag-start();
    /// Pointer offset from the press point.
    callback drag-move(length, length);
    callback drag-end();
    private property <bool> was-dragged: false;

    init => { root.shown(); }
    opacity: root.dragging ? 0.45 : 1;
    animate opacity { duration: 120ms; }

    // Cover (square, as wide as the tile).
    Rectangle {
        y: ta.has-hover ? -4px : 0px;
        width: parent.width;
        height: parent.width;
        border-radius: 12px;
        background: Theme.surface-hover;
        border-width: root.drop-target ? 3px : 0px;
        border-color: Theme.accent;
        drop-shadow-blur: ta.has-hover ? 22px : 14px;
        drop-shadow-color: #000000a0;
        drop-shadow-offset-y: ta.has-hover ? 10px : 5px;
        animate y { duration: 140ms; easing: ease-out; }

        Rectangle {
            clip: true;
            border-radius: 12px;
            if root.has-image : Image {
                width: parent.width;
                height: parent.height;
                source: root.art;
                image-fit: cover;
            }
            if !root.has-image : Rectangle {
                background: @linear-gradient(150deg, Theme.surface-hover 0%, Theme.surface 100%);
                Text {
                    text: root.letter;
                    color: Theme.muted;
                    font-size: parent.width / 3;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
    Text {
        x: 2px;
        y: root.width + 10px;
        width: parent.width - 4px;
        height: 20px;
        text: root.title;
        color: Theme.text;
        font-size: 14px;
        font-weight: 600;
        overflow: elide;
    }
    Text {
        x: 2px;
        y: root.width + 31px;
        width: parent.width - 4px;
        height: 18px;
        text: root.artist;
        color: Theme.muted;
        font-size: 12.5px;
        overflow: elide;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.was-dragged = false;
                root.drag-start();
            } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                root.drag-end();
            }
        }
        moved => {
            if (self.pressed) {
                if (abs(self.mouse-x - self.pressed-x) > 8px || abs(self.mouse-y - self.pressed-y) > 8px) {
                    root.was-dragged = true;
                }
                if (root.was-dragged) {
                    root.drag-move(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                }
            }
        }
        clicked => {
            if (!root.was-dragged) { root.clicked(); }
            root.was-dragged = false;
        }
    }
}

// Round icon button drawn from SVG-like path commands (viewbox 20x20), so no font/icon files are needed.
component IconButton inherits Rectangle {
    in property <string> commands;
    in property <length> icon-size: 18px;
    in property <color> icon-color: Theme.text;
    in property <color> idle-color: transparent;
    in property <color> hover-color: Theme.surface-hover;
    callback clicked();

    border-radius: self.width / 2;
    background: ta.has-hover ? root.hover-color : root.idle-color;

    Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.icon-size;
        height: root.icon-size;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: root.commands;
        fill: root.icon-color;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Seek bar: click or drag. Calls `seek` with 0..1 when the mouse is released.
component SeekBar inherits Rectangle {
    in property <float> ratio;
    /// Track length in seconds (0 = unknown); the wheel seeks by 5 s per notch.
    in property <float> duration-secs: 0;
    callback seek(float);
    property <float> drag: 0;
    height: 20px;

    function ratio-at(x: length) -> float {
        return max(0.0, min(1.0, x / root.width));
    }

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.surface-hover;
        Rectangle {
            x: 0px;
            width: parent.width * (ta.pressed ? root.drag : root.ratio);
            height: parent.height;
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.text;
        visible: ta.has-hover || ta.pressed;
        x: root.width * (ta.pressed ? root.drag : root.ratio) - self.width / 2;
        y: (parent.height - self.height) / 2;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left) {
                if (event.kind == PointerEventKind.down) {
                    root.drag = root.ratio-at(self.mouse-x);
                } else if (event.kind == PointerEventKind.up) {
                    root.seek(root.ratio-at(self.mouse-x));
                }
            }
        }
        moved => {
            if (self.pressed) {
                root.drag = root.ratio-at(self.mouse-x);
            }
        }
        scroll-event(event) => {
            if (root.duration-secs <= 0) {
                return reject;
            }
            // One wheel notch = 60 px in Slint; wheel up = forward.
            root.seek(max(0.0, min(1.0, root.ratio + (event.delta-y / 60px) * 5.0 / root.duration-secs)));
            return accept;
        }
    }
}

// Volume slider: sets the value while the mouse is pressed or dragged.
component VolumeBar inherits Rectangle {
    in property <float> value;
    callback edited(float);
    height: 20px;

    function ratio-at(x: length) -> float {
        return max(0.0, min(1.0, x / root.width));
    }

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.surface-hover;
        Rectangle {
            x: 0px;
            width: parent.width * root.value;
            height: parent.height;
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.text;
        visible: ta.has-hover || ta.pressed;
        x: root.width * root.value - self.width / 2;
        y: (parent.height - self.height) / 2;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.edited(root.ratio-at(self.mouse-x));
            }
        }
        moved => {
            if (self.pressed) {
                root.edited(root.ratio-at(self.mouse-x));
            }
        }
        scroll-event(event) => {
            // 5 % per wheel notch, wheel up = louder.
            root.edited(max(0.0, min(1.0, root.value + (event.delta-y / 60px) * 0.05)));
            return accept;
        }
    }
}

// Slider over any range (sound settings): sets the value while the mouse is pressed or dragged.
component FxSlider inherits Rectangle {
    in property <float> lo: 0;
    in property <float> hi: 1;
    in property <float> value;
    /// Change per wheel notch.
    in property <float> wheel-step: 0.5;
    in property <bool> enabled: true;
    callback edited(float);
    height: 20px;

    property <float> fraction: (root.value - root.lo) / (root.hi - root.lo);

    function value-at(x: length) -> float {
        return root.lo + (root.hi - root.lo) * max(0.0, min(1.0, x / root.width));
    }

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.surface-hover;
        Rectangle {
            x: 0px;
            width: parent.width * max(0.0, min(1.0, root.fraction));
            height: parent.height;
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.text;
        x: root.width * max(0.0, min(1.0, root.fraction)) - self.width / 2;
        y: (parent.height - self.height) / 2;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.edited(root.value-at(self.mouse-x));
            }
        }
        moved => {
            if (self.pressed) {
                root.edited(root.value-at(self.mouse-x));
            }
        }
        scroll-event(event) => {
            root.edited(max(root.lo, min(root.hi, root.value + (event.delta-y / 60px) * root.wheel-step)));
            return accept;
        }
    }
}

// One row of the sound panel: label, slider, value text.
component FxRow inherits Rectangle {
    in property <string> label;
    in property <string> value-text;
    in property <float> lo: 0;
    in property <float> hi: 1;
    in property <float> value;
    in property <float> wheel-step: 0.5;
    in property <bool> enabled: true;
    callback edited(float);
    height: 22px;

    HorizontalLayout {
        spacing: 10px;
        Text {
            text: root.label;
            width: 64px;
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
        FxSlider {
            lo: root.lo;
            hi: root.hi;
            value: root.value;
            wheel-step: root.wheel-step;
            enabled: root.enabled;
            edited(v) => { root.edited(v); }
        }
        Text {
            text: root.value-text;
            width: 56px;
            color: Theme.text;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// Three vertical dots at the end of a track row; `open` gets the window position of the click.
component MoreButton inherits Rectangle {
    callback open(length, length);

    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: ta.has-hover ? Theme.surface-hover : transparent;

    for k in 3 : Rectangle {
        x: (parent.width - 4px) / 2;
        y: 4px + k * 8px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: ta.has-hover ? Theme.text : Theme.muted;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); }
    }
}

// One line of the track context menu.
component MenuItem inherits Rectangle {
    in property <string> text;
    in property <bool> dim: false;
    callback clicked();

    height: 34px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.surface-hover : transparent;

    Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.text;
        color: root.dim ? Theme.muted : Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Text toggle (Shuffle / Repeat): accent color when active.
component ToggleText inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();

    border-radius: 14px;
    background: root.active ? Theme.accent.with-alpha(0.2)
        : ta.has-hover ? Theme.surface-hover : transparent;

    Text {
        text: root.text;
        color: root.active ? Theme.accent : Theme.muted;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component PillButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    callback clicked();

    height: 34px;
    border-radius: 17px;
    background: root.active ? Theme.accent.with-alpha(0.2)
        : ta.has-hover ? Theme.surface-hover : Theme.surface;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text {
            text: root.text;
            color: root.active ? Theme.accent : Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Round header button with a "refresh" arrow (manual rescan of the music folder).
component RescanButton inherits Rectangle {
    /// True while a scan runs: the arrow spins.
    in property <bool> spinning: false;
    callback clicked();

    width: 34px;
    height: 34px;
    border-radius: 17px;
    background: ta.has-hover ? Theme.surface-hover : Theme.surface;

    Path {
        x: 8px;
        y: 8px;
        width: 18px;
        height: 18px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M20 12A8 8 0 1 1 17.5 6.3M17.5 2V6.5H13";
        stroke: ta.has-hover ? Theme.text : Theme.muted;
        stroke-width: 2.2px;
        stroke-line-cap: round;
        fill: transparent;
        // One turn per 0.9 s while scanning; at rest the arrow stands still.
        transform-rotation: root.spinning ? Math.mod(animation-tick() / 900ms, 1.0) * 360deg : 0deg;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One soft colored light of the background behind the player rays (radial gradient, no edge).
component GlowBlob inherits Rectangle {
    in property <color> tint;
    in property <float> strength: 0.3;
    in property <length> cx;
    in property <length> cy;
    in property <length> size;
    x: root.cx - root.size / 2;
    y: root.cy - root.size / 2;
    width: root.size;
    height: root.size;
    background: @radial-gradient(circle, root.tint.with-alpha(Math.min(1, Math.max(0, root.strength))) 0%, root.tint.with-alpha(0) 70%);
}

// Centers a fixed-height child vertically inside a stretching layout.
component HeaderItem inherits Rectangle {
    VerticalLayout {
        alignment: center;
        @children
    }
}

component SearchField inherits Rectangle {
    in-out property <string> value;
    callback edited(string);
    height: 40px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.surface-hover;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        Rectangle {
            width: 16px;
            height: 40px;
            background: transparent;
            Path {
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                viewbox-width: 24;
                viewbox-height: 24;
                commands: "M 10 2 Q 2 2 2 10 Q 2 18 10 18 Q 18 18 18 10 Q 18 2 10 2 Z M 10 5 Q 15 5 15 10 Q 15 15 10 15 Q 5 15 5 10 Q 5 5 10 5 Z M 16 14 L 23 21 L 21 23 L 14 16 Z";
                fill: Theme.muted;
            }
        }
        TextInput {
            text: root.value;
            height: 40px;
            color: Theme.text;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            edited => { root.value = self.text; root.edited(self.text); }
        }
    }
}

// Small preset chip in the sound panel.
component PillPreset inherits Rectangle {
    in property <string> text;
    /// The current curve is exactly this preset.
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 26px;
    border-radius: 13px;
    background: root.active ? Theme.accent.with-alpha(0.22)
        : (ta.has-hover && root.enabled) ? Theme.surface-hover : Theme.bg;
    border-width: 1px;
    border-color: root.active ? Theme.accent.with-alpha(0.7) : transparent;
    animate background { duration: 120ms; }

    Text {
        text: root.text;
        color: root.active ? Theme.accent : Theme.text;
        font-size: 11px;
        font-weight: root.active ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

// A preset card: name on top, a miniature of its curve below.
component PresetCard inherits Rectangle {
    in property <string> text;
    /// SVG paths of the curve and of its fill down to the zero line (328 x 46 box, `eq_curve::mini_paths`).
    in property <string> line;
    in property <string> fill;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();

    border-radius: 12px;
    background: root.active ? Theme.accent.with-alpha(0.18)
        : (ta.has-hover && root.enabled) ? Theme.surface-hover : Theme.bg;
    border-width: 1px;
    border-color: root.active ? Theme.accent.with-alpha(0.7) : transparent;
    animate background { duration: 120ms; }

    Text {
        x: 12px;
        y: 8px;
        width: parent.width - 24px;
        height: 16px;
        text: root.text;
        color: root.active ? Theme.accent : Theme.text;
        font-size: 13px;
        font-weight: root.active ? 700 : 500;
        overflow: elide;
        vertical-alignment: center;
    }
    // Zero line of the miniature.
    Rectangle {
        x: 12px;
        y: 26px + (parent.height - 34px) / 2;
        width: parent.width - 24px;
        height: 1px;
        background: root.active ? Theme.accent.with-alpha(0.35) : Theme.muted.with-alpha(0.35);
    }
    Path {
        x: 12px;
        y: 26px;
        width: parent.width - 24px;
        height: parent.height - 34px;
        viewbox-width: 328;
        viewbox-height: 46;
        commands: root.fill;
        fill: root.active ? Theme.accent.with-alpha(0.40) : Theme.muted.with-alpha(0.28);
    }
    Path {
        x: 12px;
        y: 26px;
        width: parent.width - 24px;
        height: parent.height - 34px;
        viewbox-width: 328;
        viewbox-height: 46;
        commands: root.line;
        stroke: root.active ? Theme.accent : Theme.text;
        stroke-width: 2.5px;
        stroke-line-join: round;
        stroke-line-cap: round;
        fill: transparent;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

// Segmented switch: a colored pill slides under the chosen label.
component SegmentedControl inherits Rectangle {
    in property <[string]> labels;
    in property <int> current;
    callback selected(int);

    height: 32px;
    border-radius: 16px;
    background: Theme.bg;

    property <length> seg-w: (root.width - 6px) / max(1, root.labels.length);

    Rectangle {
        x: 3px + root.current * root.seg-w;
        y: 3px;
        width: root.seg-w;
        height: root.height - 6px;
        border-radius: (root.height - 6px) / 2;
        background: Theme.accent;
        drop-shadow-color: Theme.accent.with-alpha(0.5);
        drop-shadow-blur: 10px;
        animate x { duration: 220ms; easing: cubic-bezier(0.2, 0.8, 0.2, 1); }
    }
    for label[k] in root.labels : Rectangle {
        x: 3px + k * root.seg-w;
        y: 0px;
        width: root.seg-w;
        height: root.height;
        Text {
            text: label;
            color: k == root.current ? #ffffff : (seg-ta.has-hover ? Theme.text : Theme.muted);
            font-size: 12px;
            font-weight: k == root.current ? 700 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate color { duration: 160ms; }
        }
        seg-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.selected(k); }
        }
    }
}

// Small response graph of the equalizer curve with a caption that tells which curve is active.
// The path strings come from Rust (`eq_curve.rs`); the box there is 328 x 46 units, 1 unit = 1 px high.
component EqGraph inherits Rectangle {
    in property <[float]> gains;
    in property <string> line;
    in property <string> fill;
    /// 0 = off, 1 = one curve for all tracks, 2 = own curve per track.
    in property <int> mode;
    in property <bool> editable;
    in property <string> track-name;
    in property <bool> saved;

    height: 46px;
    border-radius: 10px;
    background: Theme.bg;
    clip: true;

    property <bool> chip-visible: root.mode == 2 && root.track-name != "";

    // Zero line.
    Rectangle {
        x: 8px;
        y: 29px;
        width: root.width - 16px;
        height: 1px;
        background: Theme.surface-hover;
    }
    Path {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        viewbox-width: 328;
        viewbox-height: 46;
        commands: root.fill;
        fill: Theme.accent.with-alpha(root.editable ? 0.18 : 0.05);
    }
    Path {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        viewbox-width: 328;
        viewbox-height: 46;
        commands: root.line;
        stroke: root.editable ? Theme.accent : Theme.muted;
        stroke-width: 2px;
        stroke-line-join: round;
        stroke-line-cap: round;
        fill: transparent;
    }
    // One dot per band.
    for g[i] in root.gains : Rectangle {
        visible: root.editable;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: Theme.text;
        x: (8.0 + 312.0 * i / 11.0) / 328.0 * root.width - 3px;
        y: (29.0 - Math.min(12.0, Math.max(-12.0, g)) / 12.0 * 11.0) * 1px - 3px;
    }
    // Caption.
    Text {
        x: 10px;
        y: 2px;
        width: root.width - 20px - (root.chip-visible ? 64px : 0px);
        height: 13px;
        font-size: 10px;
        color: Theme.muted;
        overflow: elide;
        vertical-alignment: center;
        text: root.mode == 0 ? "Bypassed \u{2014} your curves are kept"
            : root.mode == 1 ? "One curve for every track"
            : root.track-name == "" ? "Play a track to give it its own curve"
            : "\u{266A} " + root.track-name;
    }
    if root.chip-visible : Rectangle {
        x: root.width - 62px;
        y: 2px;
        width: 54px;
        height: 13px;
        border-radius: 6.5px;
        background: root.saved ? Theme.accent.with-alpha(0.25) : Theme.surface-hover;
        Text {
            text: root.saved ? "own curve" : "flat";
            color: root.saved ? Theme.accent : Theme.muted;
            font-size: 9px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Primary (accent) button; grey while disabled.
component AccentButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> tone: Theme.accent;
    callback clicked();

    width: 120px;
    height: 40px;
    border-radius: 20px;
    background: root.enabled ? (ta.has-hover ? root.tone.brighter(0.15) : root.tone) : Theme.surface-hover;
    animate background { duration: 120ms; }

    Text {
        text: root.text;
        color: root.enabled ? #ffffff : Theme.muted;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Single-line text field with a placeholder.
component NameField inherits Rectangle {
    in-out property <string> value;
    in property <string> placeholder;
    callback accepted(string);
    public function focus-input() { ti.focus(); }

    height: 44px;
    border-radius: 10px;
    border-width: 1px;
    border-color: ti.has-focus ? Theme.accent : Theme.surface-hover;
    background: Theme.bg;
    animate border-color { duration: 120ms; }

    Text {
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.muted;
        vertical-alignment: center;
        visible: root.value == "";
    }
    ti := TextInput {
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        text <=> root.value;
        color: Theme.text;
        font-size: 15px;
        vertical-alignment: center;
        single-line: true;
        accepted => { root.accepted(self.text); }
    }
}

// A record sleeve with the vinyl peeking out: the record slides out on hover,
// all the way out (and a check appears) when the track is already inside.
component SleeveCard inherits Rectangle {
    in property <string> name;
    in property <string> count;
    in property <string> letter;
    in property <color> color-a: #8b6cff;
    in property <color> color-b: #3a2a8a;
    in property <bool> added: false;
    in property <bool> liked: false;
    in property <bool> is-new: false;
    callback clicked();

    width: 176px;
    height: 186px;
    private property <length> lift: ta.has-hover ? -3px : 0px;
    animate lift { duration: 140ms; easing: ease-out; }

    // The record, behind the sleeve.
    if !root.is-new : Rectangle {
        x: root.added ? 58px : ta.has-hover ? 38px : 20px;
        y: 10px + root.lift;
        width: 114px;
        height: 114px;
        border-radius: 57px;
        background: #0c0c0f;
        border-width: 1px;
        border-color: #ffffff18;
        animate x { duration: 280ms; easing: ease-out; }

        Rectangle { x: 12px; y: 12px; width: 90px; height: 90px; border-radius: 45px; border-width: 1px; border-color: #ffffff12; }
        Rectangle { x: 24px; y: 24px; width: 66px; height: 66px; border-radius: 33px; border-width: 1px; border-color: #ffffff12; }
        Rectangle {
            x: 38px;
            y: 38px;
            width: 38px;
            height: 38px;
            border-radius: 19px;
            background: @linear-gradient(135deg, root.color-a, root.color-b);
        }
        Rectangle { x: 54px; y: 54px; width: 6px; height: 6px; border-radius: 3px; background: #0c0c0f; }
    }

    // The sleeve.
    if !root.is-new : Rectangle {
        x: 0px;
        y: root.lift;
        width: 134px;
        height: 134px;
        border-radius: 12px;
        background: @linear-gradient(135deg, root.color-a, root.color-b);
        drop-shadow-blur: 14px;
        drop-shadow-color: #00000070;
        drop-shadow-offset-y: 4px;

        if !root.liked : Text {
            width: parent.width;
            height: parent.height;
            text: root.letter;
            color: #ffffff40;
            font-size: 56px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.liked : Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 64px;
            height: 64px;
            viewbox-width: 20;
            viewbox-height: 20;
            commands: "M 10 17.5 C 2 11.5 2 5 6 4 C 8 3.5 9.5 4.5 10 6 C 10.5 4.5 12 3.5 14 4 C 18 5 18 11.5 10 17.5 Z";
            fill: #ffffff55;
        }
        Rectangle {
            x: parent.width - 36px;
            y: 8px;
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: Theme.accent;
            opacity: root.added ? 1 : 0;
            animate opacity { duration: 180ms; }
            Path {
                x: 4px;
                y: 4px;
                width: 20px;
                height: 20px;
                viewbox-width: 20;
                viewbox-height: 20;
                commands: "M 4 10.5 L 8 14.5 L 16 6";
                stroke: #ffffff;
                stroke-width: 2.4px;
                fill: transparent;
            }
        }
    }
    if root.is-new : Rectangle {
        x: 0px;
        y: root.lift;
        width: 134px;
        height: 134px;
        border-radius: 12px;
        background: Theme.surface;
        border-width: 2px;
        border-color: Theme.accent.with-alpha(ta.has-hover ? 0.8 : 0.4);
        animate border-color { duration: 140ms; }
        Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 44px;
            height: 44px;
            viewbox-width: 20;
            viewbox-height: 20;
            commands: "M 9 3 H 11 V 9 H 17 V 11 H 11 V 17 H 9 V 11 H 3 V 9 H 9 Z";
            fill: Theme.accent.brighter(0.5);
        }
    }

    Text {
        x: 0px;
        y: 142px;
        width: 134px;
        height: 20px;
        text: root.is-new ? "New playlist" : root.name;
        color: Theme.text;
        font-size: 14px;
        font-weight: 600;
        overflow: elide;
    }
    Text {
        x: 0px;
        y: 162px;
        width: 134px;
        height: 18px;
        text: root.is-new ? "Name it, pick a folder" : root.count;
        color: Theme.muted;
        font-size: 12px;
        overflow: elide;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One line of the folder picker ("No folder", a folder, or "New folder...").
component FolderRow inherits Rectangle {
    in property <string> name;
    in property <bool> active: false;
    in property <bool> plus: false;
    in property <bool> blank: false;
    callback clicked();

    height: 40px;
    border-radius: 10px;
    background: root.active ? Theme.accent.with-alpha(0.18) : ta.has-hover ? Theme.surface-hover : transparent;
    animate background { duration: 120ms; }

    if !root.plus && !root.blank : Path {
        x: 14px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: "M 1 4 Q 1 2 3 2 H 8 L 10 4 H 17 Q 19 4 19 6 V 15 Q 19 17 17 17 H 3 Q 1 17 1 15 Z";
        fill: root.active ? Theme.accent.brighter(0.5) : Theme.muted;
    }
    if root.blank : Path {
        x: 14px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: "M 10 2.5 A 7.5 7.5 0 1 1 9.99 2.5 Z M 4.7 4.7 L 15.3 15.3";
        stroke: root.active ? Theme.accent.brighter(0.5) : Theme.muted;
        stroke-width: 1.6px;
        fill: transparent;
    }
    if root.plus : Path {
        x: 14px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        viewbox-width: 20;
        viewbox-height: 20;
        commands: "M 9 3 H 11 V 9 H 17 V 11 H 11 V 17 H 9 V 11 H 3 V 9 H 9 Z";
        fill: Theme.accent.brighter(0.5);
    }
    Text {
        x: 44px;
        width: parent.width - 44px - 44px;
        height: parent.height;
        text: root.name;
        color: root.plus ? Theme.accent.brighter(0.5) : root.blank ? Theme.muted : Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
    if !root.plus : Rectangle {
        x: parent.width - 32px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        border-width: 2px;
        border-color: root.active ? Theme.accent : Theme.muted.with-alpha(0.6);
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 8px;
            height: 8px;
            border-radius: 4px;
            background: Theme.accent;
            visible: root.active;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Choose one folder (or none), or make a new one on the spot.
component FolderPicker inherits Rectangle {
    in property <[FolderChip]> folders;
    in-out property <string> selected;
    callback create-folder(string);
    private property <bool> adding: false;
    private property <string> new-name: "";
    function commit() {
        if (root.new-name != "") { root.create-folder(root.new-name); }
        root.new-name = "";
        root.adding = false;
    }

    VerticalLayout {
        spacing: 4px;
        FolderRow {
            name: "No folder";
            blank: true;
            active: root.selected == "";
            clicked => { root.selected = ""; }
        }
        ListView {
            vertical-stretch: 1;
            for f in root.folders : FolderRow {
                name: f.name;
                active: root.selected == f.id;
                clicked => { root.selected = f.id; }
            }
        }
        if !root.adding : FolderRow {
            name: "New folder...";
            plus: true;
            clicked => { root.adding = true; }
        }
        if root.adding : Rectangle {
            height: 44px;
            HorizontalLayout {
                spacing: 8px;
                NameField {
                    placeholder: "Folder name";
                    value <=> root.new-name;
                    accepted(v) => { root.commit(); }
                    init => { self.focus-input(); }
                }
                AccentButton {
                    width: 80px;
                    height: 44px;
                    text: "Add";
                    enabled: root.new-name != "";
                    clicked => { root.commit(); }
                }
            }
        }
    }
}

// ---- Settings page: "orbit" style ----------------------------------------------------------
// Faint concentric rings in the corner, a satellite drifting along one of them, a rail of dots
// on the left (one per section; the lit segment grows down to the open one) and cards on the right.

// Round header button with "sliders" icon (opens the settings page).
component SettingsButton inherits Rectangle {
    in property <bool> active: false;
    callback clicked();

    width: 34px;
    height: 34px;
    border-radius: 17px;
    background: root.active ? Theme.accent.with-alpha(0.2)
        : ta.has-hover ? Theme.surface-hover : Theme.surface;

    Path {
        x: 8px;
        y: 8px;
        width: 18px;
        height: 18px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M3 7H21M3 12H21M3 17H21";
        stroke: root.active ? Theme.accent : ta.has-hover ? Theme.text : Theme.muted;
        stroke-width: 2.2px;
        stroke-line-cap: round;
        fill: transparent;
    }
    // Knobs of the three sliders.
    Rectangle { x: 18px; y: 10px; width: 6px; height: 6px; border-radius: 3px; background: root.active ? Theme.accent : ta.has-hover ? Theme.text : Theme.muted; }
    Rectangle { x: 10px; y: 14px; width: 6px; height: 6px; border-radius: 3px; background: root.active ? Theme.accent : ta.has-hover ? Theme.text : Theme.muted; }
    Rectangle { x: 19px; y: 18px; width: 6px; height: 6px; border-radius: 3px; background: root.active ? Theme.accent : ta.has-hover ? Theme.text : Theme.muted; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One thin circle of the orbit background.
component OrbitRing inherits Rectangle {
    in property <length> radius;
    in property <length> cx;
    in property <length> cy;
    in property <float> strength: 0.1;
    x: root.cx - root.radius;
    y: root.cy - root.radius;
    width: root.radius * 2;
    height: root.radius * 2;
    border-radius: root.radius;
    border-width: 1px;
    border-color: Theme.accent.with-alpha(root.strength);
}

// One dot + label of the settings rail.
component SettingsNode inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> active: false;
    in property <bool> show-hint: true;
    callback clicked();

    // Glow behind the dot of the open section.
    Rectangle {
        x: 3px;
        y: (root.height - self.height) / 2;
        width: 34px;
        height: 34px;
        border-radius: 17px;
        background: @radial-gradient(circle, Theme.accent.with-alpha(0.45) 0%, Theme.accent.with-alpha(0) 70%);
        opacity: root.active ? 1 : 0;
        animate opacity { duration: 250ms; }
    }
    Rectangle {
        x: 13px;
        y: (root.height - self.height) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.active ? Theme.accent : Theme.bg;
        border-width: 2px;
        border-color: root.active || ta.has-hover ? Theme.accent : Theme.muted.with-alpha(0.6);
        animate background { duration: 200ms; }
    }
    VerticalLayout {
        x: 52px;
        y: 0px;
        width: max(0px, root.width - 52px);
        height: root.height;
        alignment: center;
        spacing: 1px;
        Text {
            text: root.label;
            color: root.active || ta.has-hover ? Theme.text : Theme.muted;
            font-size: 16px;
            font-weight: root.active ? 700 : 500;
            overflow: elide;
        }
        if root.show-hint : Text {
            text: root.hint;
            color: Theme.muted;
            font-size: 12px;
            overflow: elide;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One card of a settings section (placeholder until the real control exists).
export struct SettingsCardInfo {
    title: string,
    text: string,
}

component SettingsPage inherits Rectangle {
    in-out property <int> section: 0;
    callback close();

    // To add a section: extend the four lists below (same order), nothing else.
    private property <[string]> names: ["Appearance", "Language", "Security", "AI & stems", "Library"];
    private property <[string]> hints: ["Themes and colors", "Interface language", "App lock", "Stem separation", "Music folder"];
    private property <[string]> leads: [
        "How Radiant looks.",
        "The language of the interface.",
        "Keep your music private.",
        "Splitting tracks into vocals, drums, bass and the rest.",
        "Where the music lives.",
    ];
    private property <[[SettingsCardInfo]]> pages: [
        [
            { title: "Theme", text: "Dark, light, OLED black, or follow Windows." },
            { title: "Accent color", text: "Pick the color of highlights and the player glow." },
        ],
        [
            { title: "Interface language", text: "10 languages plus System; switches on the fly without stopping the music." },
        ],
        [
            { title: "App lock", text: "4 digits, 6 digits or your own code, asked at start and when returning to the app." },
            { title: "Recovery file", text: "A file of 12 words to get back in if the code is forgotten." },
        ],
        [
            { title: "Models", text: "Download the separation models or import them from files." },
            { title: "Stems", text: "Choose which parts to keep and where they are saved." },
        ],
        [
            { title: "Music folder", text: "Choose and rescan the folder (for now these two buttons stay in the header)." },
        ],
    ];

    // Rail geometry: the rows shrink a little in short windows.
    private property <length> nh: Math.max(30px, Math.min(60px, (root.height - 130px) / 5));
    private property <length> y0: 104px;
    private property <length> rail-x: 40px;
    private property <length> content-x: 320px;
    private property <length> content-w: max(0px, root.width - root.content-x - 40px);

    background: Theme.bg;
    clip: true;

    // Soft lights drifting behind everything.
    GlowBlob {
        tint: Theme.accent;
        strength: 0.22;
        cx: root.width * 0.75 + Math.sin(animation-tick() / 11s * 360deg) * 90px;
        cy: root.height * 0.3 + Math.cos(animation-tick() / 13s * 360deg) * 60px;
        size: 520px;
    }
    GlowBlob {
        tint: #3aa6ff;
        strength: 0.12;
        cx: root.width * 0.15 + Math.cos(animation-tick() / 17s * 360deg) * 80px;
        cy: root.height * 0.85 + Math.sin(animation-tick() / 9s * 360deg) * 50px;
        size: 460px;
    }

    // Orbit rings around the bottom-left corner, and a satellite swinging along one of them.
    OrbitRing { cx: 0px; cy: root.height; radius: 200px; strength: 0.16; }
    OrbitRing { cx: 0px; cy: root.height; radius: 340px; strength: 0.11; }
    OrbitRing { cx: 0px; cy: root.height; radius: 500px; strength: 0.08; }
    OrbitRing { cx: 0px; cy: root.height; radius: 700px; strength: 0.05; }
    Rectangle {
        private property <angle> a: (0.5 + 0.5 * Math.sin(animation-tick() / 8s * 360deg)) * 90deg;
        x: 340px * Math.cos(self.a) - 5px;
        y: root.height - 340px * Math.sin(self.a) - 5px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.accent;
        Rectangle {
            x: -9px;
            y: -9px;
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: @radial-gradient(circle, Theme.accent.with-alpha(0.5) 0%, Theme.accent.with-alpha(0) 70%);
        }
    }

    // Swallows clicks so nothing below the page reacts.
    TouchArea { }

    // ---- top bar ----
    Rectangle {
        x: 24px;
        y: 20px;
        width: 34px;
        height: 34px;
        border-radius: 17px;
        background: sback-ta.has-hover ? Theme.surface-hover : Theme.surface;
        Path {
            x: 8px;
            y: 8px;
            width: 18px;
            height: 18px;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: "M15 5L8 12L15 19";
            stroke: sback-ta.has-hover ? Theme.text : Theme.muted;
            stroke-width: 2.4px;
            stroke-line-cap: round;
            stroke-line-join: round;
            fill: transparent;
        }
        sback-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.close(); }
        }
    }
    Text {
        x: 70px;
        y: 20px;
        height: 34px;
        text: "SETTINGS";
        color: Theme.muted;
        font-size: 12px;
        font-weight: 700;
        vertical-alignment: center;
    }

    // ---- rail: a line with one dot per section ----
    Rectangle {
        x: root.rail-x + 19px;
        y: root.y0 + root.nh / 2;
        width: 2px;
        height: 4 * root.nh;
        background: Theme.muted.with-alpha(0.25);
    }
    // The lit part of the line, from the first dot down to the open one.
    Rectangle {
        x: root.rail-x + 19px;
        y: root.y0 + root.nh / 2;
        width: 2px;
        height: root.section * root.nh;
        background: Theme.accent;
        animate height { duration: 280ms; easing: ease-in-out; }
    }
    for name[i] in root.names : SettingsNode {
        x: root.rail-x;
        y: root.y0 + i * root.nh;
        width: 240px;
        height: root.nh;
        label: name;
        hint: root.hints[i];
        show-hint: root.nh >= 48px;
        active: root.section == i;
        clicked => { root.section = i; }
    }

    // ---- content of the open section ----
    Text {
        x: root.content-x;
        y: 62px;
        width: root.content-w;
        text: root.names[root.section];
        color: Theme.text;
        font-size: 30px;
        font-weight: 700;
        overflow: elide;
    }
    Text {
        x: root.content-x;
        y: 102px;
        width: root.content-w;
        text: root.leads[root.section];
        color: Theme.muted;
        font-size: 14px;
        wrap: word-wrap;
    }
    Flickable {
        x: root.content-x;
        y: 146px;
        width: root.content-w;
        height: max(0px, root.height - 146px);
        content-height: root.pages[root.section].length * 104px + 16px;

        for card[k] in root.pages[root.section] : Rectangle {
            x: 0px;
            y: k * 104px;
            width: parent.width;
            height: 92px;
            border-radius: 14px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.surface-hover;

            VerticalLayout {
                padding: 16px;
                spacing: 4px;
                alignment: start;
                Text {
                    text: card.title;
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: card.text;
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }
            Rectangle {
                x: parent.width - 66px;
                y: 14px;
                width: 52px;
                height: 22px;
                border-radius: 11px;
                background: Theme.accent.with-alpha(0.15);
                Text {
                    text: "Soon";
                    color: Theme.accent;
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Radiant";
    preferred-width: 900px;
    preferred-height: 640px;
    min-width: 640px;
    min-height: 360px;
    background: Theme.bg;
    default-font-size: 14px;

    in property <[TrackRow]> tracks;

    // Track list grid: every column has an absolute position so rows line up exactly.
    // Narrow windows drop the Year column first, then Album.
    private property <length> col-pad: 20px;
    private property <length> col-gap: 16px;
    private property <length> num-w: 36px;
    private property <length> dur-w: 52px;
    private property <length> row-h: 56px;
    private property <length> list-w: root.width;
    private property <bool> show-album: root.list-w >= 700px;
    private property <bool> show-year: root.list-w >= 860px;
    private property <length> year-w: root.show-year ? 52px : 0px;
    // The right edge leaves room for the list's scroll bar.
    private property <length> right-pad: 32px;
    private property <length> dots-w: 28px;
    private property <length> content-right: root.list-w - root.right-pad - 14px;
    private property <length> dots-x: root.content-right - root.dots-w;
    // Right edge of the Time column: the three dots sit to its right.
    private property <length> time-right: root.dots-x - 8px;
    private property <length> title-x: root.col-pad + root.num-w + root.col-gap;
    // Space shared by the title and album columns.
    private property <length> flex-w: max(0px, root.time-right - root.title-x - root.dur-w - root.col-gap
        - (root.show-year ? root.year-w + root.col-gap : 0px));
    private property <length> title-w: root.show-album ? root.flex-w * 0.56 : root.flex-w;
    private property <length> album-x: root.title-x + root.title-w + root.col-gap;
    private property <length> album-w: root.show-album ? max(0px, root.flex-w - root.title-w - root.col-gap) : 0px;
    private property <length> year-x: root.show-album ? root.album-x + root.album-w + root.col-gap
        : root.title-x + root.title-w + root.col-gap;
    private property <length> dur-x: root.time-right - root.dur-w;
    in-out property <string> search-text: "";
    in-out property <int> sort-mode: 1;
    in-out property <bool> sort-descending: false;
    /// Playlists page sort: 0 = date created, 1 = name, 2 = date changed, 3 = track count.
    in-out property <int> pl-sort-mode: 0;
    in-out property <bool> pl-sort-descending: false;
    callback pl-sort-changed(int, bool);
    /// Albums grid sort: 0 = manual order, 1 = name, 2 = artist, 3 = duration.
    in-out property <int> album-sort-mode: 1;
    in-out property <bool> album-sort-descending: false;
    callback album-sort-changed(int, bool);
    /// Sort panel shows the modes of the open section (Tracks, Albums or Playlists).
    private property <int> cur-sort-mode: root.section == 2 ? root.pl-sort-mode
        : root.section == 1 ? root.album-sort-mode : root.sort-mode;
    private property <bool> cur-sort-desc: root.section == 2 ? root.pl-sort-descending
        : root.section == 1 ? root.album-sort-descending : root.sort-descending;
    /// The manual order is selected (it has no direction).
    private property <bool> cur-sort-manual: root.section == 2 ? root.pl-sort-mode == 4
        : root.section == 1 ? root.album-sort-mode == 0 : root.sort-mode == 0;
    /// The Sort button exists in Tracks, Albums (grid only) and Playlists, not in Queues.
    private property <bool> sort-available: root.section == 0 || root.section == 2 || (root.section == 1 && !root.album-open);
    private property <[string]> sort-labels: root.section == 2
        ? ["Date created", "Name", "Date changed", "Tracks", "Manual order"]
        : root.section == 1 ? ["Manual order", "Name", "Artist", "Duration"]
        : ["Manual order", "Name", "Artist", "Album", "Duration", "File date"];
    function apply-sort(mode: int, desc: bool) {
        if (root.section == 2) {
            let d = mode == 4 ? false : desc;
            root.pl-sort-mode = mode;
            root.pl-sort-descending = d;
            root.pl-sort-changed(mode, d);
        } else if (root.section == 1) {
            let d = mode == 0 ? false : desc;
            root.album-sort-mode = mode;
            root.album-sort-descending = d;
            root.album-sort-changed(mode, d);
        } else {
            let d = mode == 0 ? false : desc;
            root.sort-mode = mode;
            root.sort-descending = d;
            root.sort-changed(mode, d);
        }
    }
    // Drag of album tiles (manual order) and of playlist rows.
    in-out property <bool> album-drag-active: false;
    in-out property <int> album-drag-from: -1;
    in-out property <int> album-drag-to: -1;
    callback album-move(int, int);
    in-out property <bool> plr-drag-active: false;
    in-out property <int> plr-drag-from: -1;
    in-out property <int> plr-drag-to: -1;
    in-out property <bool> plr-drag-moved: false;
    callback pl-move-playlist(int, int);
    /// A playlist row can be dropped here: another playlist of the same group (same folder state), not Liked tracks.
    pure function plr-valid(from: int, to: int) -> bool {
        return from != to && from >= 0 && to >= 0
            && !root.pl-rows[from].is-folder && !root.pl-rows[to].is-folder
            && !root.pl-rows[from].liked && !root.pl-rows[to].liked
            && root.pl-rows[from].indent == root.pl-rows[to].indent;
    }
    /// "Add to playlist" button of the player view (the track that is playing now).
    callback add-current-to-playlist();
    in-out property <int> drag-from: -1;
    in-out property <int> drag-to: -1;
    in-out property <bool> drag-active: false;
    in-out property <bool> drag-moved: false;
    in-out property <bool> suppress-click: false;
    in property <string> status;
    /// A music folder scan is running (the rescan button spins).
    in property <bool> scanning: false;
    in property <string> now-playing;

    // Sections: 0 = Tracks, 1 = Albums, 2 = Playlists, 3 = Queues (four fixed queues).
    in-out property <int> section: 0;
    in-out property <int> queue-index: 0;
    /// Track count of each of the four queues (set by Rust once queues exist).
    in property <[int]> queue-counts: [0, 0, 0, 0];
    callback section-changed(int, int);

    // Albums grid: tiles of at least `tile-min`, as many columns as fit, tiles stretch to fill the row.
    in property <[AlbumRow]> albums;
    callback open-album(int);
    callback play-album-track(int);
    /// Play / Shuffle buttons of the open album page.
    callback play-album();
    callback shuffle-album();
    // Open album page (tracks in tag order, like a CD booklet).
    in-out property <bool> album-open: false;
    in property <[AlbumTrackRow]> album-tracks;
    in property <string> album-title;
    in property <string> album-artist;
    in property <string> album-meta;
    in property <image> album-cover;
    in property <bool> album-has-cover: false;
    in property <string> album-letter;
    /// Row of the playing track in `album-tracks`, -1 = none.
    in property <int> album-current-index: -1;
    private property <length> detail-row-h: 52px;
    private property <length> album-side: 152px;
    private property <length> album-title-w: max(0px, root.width - 2 * root.album-side);
    private property <length> album-list-title-w: max(0px, root.time-right - root.title-x - root.dur-w - root.col-gap);
    callback album-shown(int);
    private property <length> grid-pad: 28px;
    private property <length> grid-gap: 22px;
    private property <length> tile-min: 190px;
    private property <length> grid-w: root.width - 2 * root.grid-pad - 10px;
    private property <int> album-cols: max(2, Math.floor((root.grid-w + root.grid-gap) / (root.tile-min + root.grid-gap)));
    private property <length> tile-w: (root.grid-w - (root.album-cols - 1) * root.grid-gap) / root.album-cols;
    private property <length> album-row-h: root.tile-w + 52px + 20px;
    private property <int> album-rows: Math.ceil(root.albums.length / root.album-cols);
    // Section switcher ("lens"): the open section unfolds into its label, "Queues" also into four queue dots.
    private property <length> seg-w: 40px;
    private property <length> seg-gap: 2px;
    private property <length> chips-extra: 126px;
    private property <length> open-extra: root.nav-items[root.section].extra + (root.section == 3 ? root.chips-extra : 0px);
    private property <length> lens-w: 4 * root.seg-w + 3 * root.seg-gap + root.open-extra + 6px;
    private property <float> wheel-acc: 0;
    private property <[NavItem]> nav-items: [
        { label: "Tracks", icon: "M 8 3 L 17 1 V 12.5 A 2.5 2.5 0 1 1 15 10.5 V 5.2 L 10 6.2 V 14.5 A 2.5 2.5 0 1 1 8 12.5 Z", extra: 52px },
        { label: "Albums", icon: "M 10 2 A 8 8 0 1 1 9.99 2 Z M 10 7.5 A 2.5 2.5 0 1 1 9.99 7.5 Z", extra: 58px },
        { label: "Playlists", icon: "M 2 4 H 14 V 6 H 2 Z M 2 8 H 14 V 10 H 2 Z M 2 12 H 9 V 14 H 2 Z M 12 11.5 L 18 14.5 L 12 17.5 Z", extra: 66px },
        { label: "Queues", icon: "M 2 4 H 14 V 6 H 2 Z M 2 8 H 14 V 10 H 2 Z M 2 12 H 8 V 14 H 2 Z M 15.5 7 H 17.5 V 15 A 2 2 0 1 1 15.5 13 Z", extra: 58px },
    ];
    // Left edge of segment `i`: segments after the open one are pushed right by its extra width.
    pure function seg-x(i: int, open: int, extra: length) -> length {
        return 3px + i * (root.seg-w + root.seg-gap) + (open < i ? extra : 0px);
    }
    // Mouse wheel over the switcher: one notch = next / previous section (or queue, with the pointer on the dots).
    function wheel(delta: length, on-queues: bool) {
        root.wheel-acc += delta / 60px;
        if (root.wheel-acc <= -1 || root.wheel-acc >= 1) {
            let step = root.wheel-acc < 0 ? 1 : -1;
            root.wheel-acc = 0;
            if (on-queues) {
                root.go-queue(max(0, min(3, root.queue-index + step)));
            } else {
                root.go-section(max(0, min(3, root.section + step)));
            }
        }
    }
    function go-section(s: int) {
        if (s == 1 && root.section == 1) { root.album-open = false; }
        if (s == 2 && root.section == 2) { root.pl-open = false; }
        root.section = s;
        root.show-sort = false;
        root.section-changed(s, root.queue-index);
    }
    // Queue switch animation: the page content jumps to a side offset (no animation), then eases back in.
    private property <bool> q-anim-reset: false;
    private property <float> q-fade: 1;
    private property <length> q-shift: 0px;
    q-anim-timer := Timer {
        interval: 30ms;
        running: false;
        triggered => {
            self.running = false;
            root.q-anim-reset = false;
            root.q-fade = 1;
            root.q-shift = 0px;
        }
    }
    function go-queue(q: int) {
        if (q != root.queue-index && root.section == 3) {
            q-anim-timer.running = false;
            root.q-anim-reset = true;
            root.q-fade = 0;
            root.q-shift = q > root.queue-index ? 40px : -40px;
            q-anim-timer.running = true;
        }
        root.section = 3;
        root.queue-index = q;
        root.show-sort = false;
        root.section-changed(3, q);
    }

    // Big player view ("Emitter"): cover inside a progress ring, glow from the cover, side tabs.
    in-out property <bool> show-player: false;
    /// 0 = Lyrics, 1 = Sound, 2 = Info, -1 = none (narrow windows only).
    in-out property <int> player-tab: 0;
    in property <string> np-title;
    in property <string> np-sub;
    in property <string> np-quality;
    /// 0 = lossy / unknown, 1 = lossless, 2 = Hi-Res: a chip in front of the quality text.
    in property <int> np-quality-tier: 0;
    in property <string> np-letter;
    in property <image> np-cover;
    in property <bool> np-has-cover: false;
    in property <color> glow-color: #8b6cff;
    in property <[InfoRow]> np-info;
    /// Spectrum rays around the ring (SVG path strings in a 1000 x 1000 box, built in rays.rs).
    in property <string> rays-halo;
    in property <string> rays-body;
    in property <string> rays-tips;
    in property <string> rays-peaks;
    /// Low-frequency energy 0..1: the glow breathes with the bass.
    in property <float> pulse: 0;
    /// Overall loudness 0..1: the colored lights behind the rays swell and drift faster.
    in property <float> energy: 0;
    in property <[LyricRow]> lyrics;
    in property <bool> lyrics-synced: false;
    /// Index of the current line of synchronized lyrics, -1 = before the first line.
    in property <int> lyric-index: -1;
    // Manual scrolling of synchronized lyrics: the wheel stops the auto-follow; it resumes after
    // a few idle seconds, on a click on a line, or with the "Back to current line" pill.
    in-out property <bool> lyr-user-scroll: false;
    private property <length> lyr-scroll-y: 0px;
    private property <int> lyr-idle: 0;
    // `dy` is the wheel delta (positive = up), `area-h` the height of the lyrics area.
    function lyric-wheel(dy: length, area-h: length) {
        let top = area-h / 2 - 28px;
        if (!root.lyr-user-scroll) {
            root.lyr-scroll-y = top - max(0, root.lyric-index) * 56px;
            root.lyr-user-scroll = true;
        }
        root.lyr-scroll-y = max(top - (root.lyrics.length - 1) * 56px, min(top, root.lyr-scroll-y + dy));
        root.lyr-idle = 0;
    }
    lyr-timer := Timer {
        interval: 500ms;
        running: root.lyr-user-scroll;
        triggered => {
            root.lyr-idle += 1;
            if (root.lyr-idle >= 7) {
                root.lyr-user-scroll = false;
            }
        }
    }

    private property <length> header-h: 48px;
    private property <length> bar-h: 112px;
    private property <length> player-h: root.height - root.bar-h;
    private property <bool> wide: root.width >= 820px;
    private property <length> side-w: root.wide ? 380px : root.width;
    private property <length> side-x: root.width - root.side-w;
    private property <length> stage-w: root.wide ? root.side-x : root.width;
    private property <int> eff-tab: (root.wide && root.player-tab < 0) ? 0 : root.player-tab;
    private property <bool> side-open: root.wide || root.player-tab >= 0;
    private property <bool> stage-visible: root.wide || root.player-tab < 0;
    private property <length> card-x: root.wide ? root.side-x : 12px;
    private property <length> card-w: root.wide ? root.side-w - 12px : root.width - 24px;
    private property <length> card-h: root.player-h - root.header-h - 12px;
    private property <bool> sound-visible: (root.show-sound && !root.show-player)
        || (root.show-player && root.eff-tab == 1);

    function pick-tab(tab: int) {
        if (root.wide) {
            root.player-tab = tab;
        } else {
            root.player-tab = root.player-tab == tab ? -1 : tab;
        }
    }
    // Position on the ring (0..1 clockwise from the top) for a mouse position inside a square of `size`.
    pure function ring-ratio-at(mx: length, my: length, size: length) -> float {
        let a = Math.atan2((mx - size / 2) / 1px, (size / 2 - my) / 1px) / 360deg;
        return a < 0 ? a + 1 : a;
    }
    // True when the mouse is on the ring itself (not on the cover inside it).
    pure function ring-hit(mx: length, my: length, size: length) -> bool {
        let dx = (mx - size / 2) / 1px;
        let dy = (my - size / 2) / 1px;
        return Math.sqrt(dx * dx + dy * dy) * 1px >= size / 2 - 22px;
    }
    in property <bool> is-playing;
    /// Index of the playing track in `tracks`, -1 if none.
    in property <int> current-index: -1;
    /// Playback position 0..1 and its texts ("1:23").
    in property <float> progress;
    in property <string> position-text;
    in property <string> duration-text;
    /// Track length in seconds, 0 if unknown (used for wheel seeking).
    in property <float> duration-secs: 0;
    in property <bool> shuffle;
    /// 0 = off, 1 = all, 2 = one.
    in property <int> repeat-mode;
    in-out property <float> volume: 1.0;
    private property <float> volume-before-mute: 0.7;

    // Sound settings panel (values are owned here; Rust keeps the same numbers for the engine).
    in-out property <bool> show-sound: false;
    /// The settings page is open (it slides/fades in over the library, the player bar stays visible).
    in-out property <bool> show-settings: false;
    private property <float> settings-t: root.show-settings ? 1 : 0;
    animate settings-t { duration: 260ms; easing: ease-out; }
    in-out property <bool> show-sort: false;
    in-out property <bool> fx-normalize: false;
    in-out property <bool> fx-mono: false;
    in-out property <float> fx-bass: 0;
    in-out property <float> fx-treble: 0;
    in-out property <float> fx-subsonic: 0;
    // Playback speed slider position, -2 ..= +2 in steps of 0.1 (+2 = 3x faster, -2 = 3x slower).
    in-out property <float> speed-t: 0;
    // Label value in tenths (12 = "1.2x"); integer math avoids float noise like 1.2000001.
    private property <float> speed-n: root.speed-t >= 0
        ? (10 + root.speed-t * 10).round()
        : (10 - root.speed-t * 10).round();
    /// 12 equalizer gains in dB (model owned by Rust).
    in property <[float]> eq-gains;
    private property <[string]> eq-labels: ["32", "64", "125", "250", "500", "1k", "2k", "3.5k", "6k", "9k", "12.5k", "16k"];

    // Track context menu (three dots / right click).
    in-out property <bool> show-menu: false;
    in-out property <length> menu-x: 0px;
    in-out property <length> menu-y: 0px;
    /// Row the menu was opened for (index in `tracks`, or in `album-tracks` when `menu-in-album`).
    in-out property <int> menu-row: -1;
    in-out property <bool> menu-in-album: false;
    /// The menu was opened for a track of the open playlist page (`menu-row` = row of `pl-page-tracks`).
    in-out property <bool> menu-in-pl: false;
    private property <length> menu-w: 196px;
    private property <length> menu-h: (root.menu-in-queue ? 5 : 4) * 34px + 12px;
    /// Album (index in `albums`) the track at this row of the Tracks list belongs to, -1 = not found.
    callback album-index-of-track(int) -> int;
    callback add-to-playlist(int, bool);
    callback add-to-queue(int, bool);
    /// Queue page (section 3): rows of the open queue, same row type as the playlist page.
    in property <[PlTrackRow]> queue-page-tracks;
    in property <string> queue-page-meta;
    /// Row of the playing track in `queue-page-tracks`, -1 = none.
    in property <int> queue-current-index: -1;
    callback queue-play-track(int);
    callback queue-play-all();
    callback queue-shuffle-all();
    callback queue-clear();
    /// Asks before clearing; the delete window (pl-view 4) is reused, `clear-confirm` switches its button.
    callback queue-clear-ask();
    in-out property <bool> clear-confirm: false;
    callback queue-move-track(int, int);
    callback queue-remove(int);
    callback queue-page-add-to-playlist(int);
    callback queue-page-add-to-queue(int);
    callback album-index-of-queue-track(int) -> int;
    /// Rust fills the page again (another queue opened, library rescanned).
    callback queue-page-refresh();
    in-out property <bool> q-drag-active: false;
    in-out property <int> q-drag-from: -1;
    in-out property <int> q-drag-to: -1;
    in-out property <bool> q-drag-moved: false;
    /// The menu was opened for a track of the open queue page (`menu-row` = row of `queue-page-tracks`).
    in-out property <bool> menu-in-queue: false;
    callback pl-page-add-to-queue(int);
    // Window "Add to queue": opened from the menu or from the button next to the volume.
    in-out property <bool> show-q-popup: false;
    /// Which queues already hold the track the window works on.
    in property <[bool]> q-added: [false, false, false, false];
    callback queue-toggle(int);
    callback add-current-to-queue();
    callback create-stems(int, bool);
    function open-menu(mx: length, my: length, row: int, in-album: bool) {
        root.menu-row = row;
        root.menu-in-album = in-album;
        root.menu-in-pl = false;
        root.menu-in-queue = false;
        root.menu-x = max(8px, min(mx, root.width - root.menu-w - 8px));
        root.menu-y = (my + root.menu-h + 8px > root.height) ? max(8px, my - root.menu-h) : my;
        root.show-menu = true;
    }
    function open-pl-menu(mx: length, my: length, row: int) {
        root.menu-row = row;
        root.menu-in-album = false;
        root.menu-in-pl = true;
        root.menu-in-queue = false;
        root.menu-x = max(8px, min(mx, root.width - root.menu-w - 8px));
        root.menu-y = (my + root.menu-h + 8px > root.height) ? max(8px, my - root.menu-h) : my;
        root.show-menu = true;
    }
    function open-queue-menu(mx: length, my: length, row: int) {
        root.menu-row = row;
        root.menu-in-album = false;
        root.menu-in-pl = false;
        root.menu-in-queue = true;
        root.menu-x = max(8px, min(mx, root.width - root.menu-w - 8px));
        root.menu-y = (my + root.menu-h + 8px > root.height) ? max(8px, my - root.menu-h) : my;
        root.show-menu = true;
    }

    callback choose-folder();
    callback rescan-folder();
    callback search-changed(string);
    callback sort-changed(int, bool);
    callback reorder-tracks(int, int);
    callback play-track(int);
    callback toggle-play();
    callback next-track();
    callback previous-track();
    callback seek(float);
    callback volume-changed(float);
    callback shuffle-changed(bool);
    callback repeat-changed(int);
    callback normalize-changed(bool);
    callback mono-changed(bool);
    callback bass-changed(float);
    callback treble-changed(float);
    callback subsonic-changed(float);
    callback speed-changed(float);
    callback eq-changed(int, float);
    /// Equalizer mode: 0 = off, 1 = one curve for all tracks, 2 = own curve per track.
    in-out property <int> eq-mode: 1;
    callback eq-mode-changed(int);
    /// The sliders and presets can be used now (not in the Off mode; per-track mode needs a track).
    in property <bool> eq-editable: true;
    /// Title of the track whose curve is shown (per-track mode); empty when nothing has played yet.
    in property <string> eq-track-name;
    /// That track has its own stored curve.
    in property <bool> eq-track-saved: false;
    /// Smooth line / area of the curve for the small graph (SVG path strings from Rust).
    in property <string> eq-curve-line;
    in property <string> eq-curve-fill;
    /// Index of the preset equal to the current curve, -1 for none.
    in property <int> eq-active-preset: -1;
    /// The status timer reports that another track started (Rust loads its equalizer curve).
    callback now-track-changed(string);
    /// Names of the EQ presets (set by Rust from radiant-dsp).
    in property <[string]> eq-preset-names;
    /// Curve path of every preset (miniatures on the preset cards).
    in property <[string]> eq-preset-lines;
    in property <[string]> eq-preset-fills;
    /// Presets can be picked (always, except in per-track mode before any track has played).
    in property <bool> eq-presets-enabled: true;
    /// The preset sheet over the sound panel is open.
    in-out property <bool> show-presets: false;
    callback eq-preset-selected(int);
    callback fx-reset();

    // ---- Playlists ----
    /// "Add to playlist" window: 0 = pick a playlist, 1 = create one, 2 = move a playlist to a folder.
    in-out property <bool> show-pl-popup: false;
    in-out property <int> pl-view: 0;
    in property <[PlaylistCard]> pl-cards;
    in property <[FolderChip]> pl-folders;
    in property <[PlaylistListRow]> pl-rows;
    in property <int> pl-total: 1;
    /// The window was opened for a track (false: opened to create a playlist or move one).
    in property <bool> pl-has-track: false;
    in property <string> pl-track-title;
    in property <string> pl-track-artist;
    in property <string> pl-track-letter;
    in property <image> pl-track-cover;
    in property <bool> pl-track-has-cover: false;
    in property <string> pl-move-name;
    in-out property <string> pl-name: "";
    /// Folder id chosen in the create / move view, "" = no folder.
    in-out property <string> pl-folder-sel: "";
    callback pl-toggle(int);
    callback pl-create(string, string) -> bool;
    callback pl-folder-create(string) -> string;
    callback pl-move(string);
    callback pl-open-create();
    callback pl-open-move(int);
    callback pl-row-clicked(int);
    /// Text of the rename / delete windows (views 3 and 4), set by Rust.
    in property <string> pl-dialog-title;
    in property <string> pl-dialog-text;
    callback pl-rename(string) -> bool;
    callback pl-delete();
    callback pl-open-rename-folder(int);
    callback pl-open-delete-folder(int);

    // Open playlist page (slides over the Playlists list, like the album page).
    in-out property <bool> pl-open: false;
    in property <[PlTrackRow]> pl-page-tracks;
    in property <string> pl-page-title;
    in property <string> pl-page-meta;
    in property <string> pl-page-letter;
    in property <bool> pl-page-liked: false;
    in property <color> pl-page-color-a: #8b6cff;
    in property <color> pl-page-color-b: #3a2a8a;
    /// Row of the playing track in `pl-page-tracks`, -1 = none.
    in property <int> pl-current-index: -1;
    callback pl-play-track(int);
    callback pl-play-all();
    callback pl-shuffle-all();
    callback pl-move-track(int, int);
    callback pl-page-add-to-playlist(int);
    callback album-index-of-pl-track(int) -> int;
    // Manual order of the open playlist: drag a row.
    in-out property <bool> pl-drag-active: false;
    in-out property <int> pl-drag-from: -1;
    in-out property <int> pl-drag-to: -1;
    in-out property <bool> pl-drag-moved: false;
    callback pl-open-rename-playlist();
    callback pl-open-delete-playlist();
    private property <length> pl-btn-x0: (root.width - (root.pl-page-liked ? 218px : 446px)) / 2;

    /// Views 3 (rename) and 4 (delete) are small dialogs; the others use the big window.
    private property <length> pl-w: root.pl-view >= 3 ? min(420px, root.width - 32px) : min(640px, root.width - 32px);
    private property <length> pl-h: root.pl-view == 3 ? min(236px, root.height - 32px)
        : root.pl-view == 4 ? min(224px, root.height - 32px)
        : min(580px, root.height - 32px);
    private property <length> pl-inner-w: min(640px, root.width - 32px) - 44px;
    private property <length> sl-w: 176px;
    private property <length> sl-h: 196px;
    private property <length> sl-gap: 14px;
    private property <int> pl-cols: max(1, Math.floor((root.pl-inner-w + root.sl-gap) / (root.sl-w + root.sl-gap)));
    private property <int> pl-grid-rows: Math.ceil((root.pl-cards.length + 1) / root.pl-cols);
    private property <length> pl-grid-x: max(0px, (root.pl-inner-w - (root.pl-cols * root.sl-w + (root.pl-cols - 1) * root.sl-gap)) / 2);
    function pl-submit() {
        if (root.pl-create(root.pl-name, root.pl-folder-sel)) {
            root.pl-name = "";
            if (root.pl-has-track) { root.pl-view = 0; } else { root.show-pl-popup = false; }
        }
    }
    function pl-back() {
        if (root.pl-has-track && root.pl-view == 1) { root.pl-view = 0; } else { root.show-pl-popup = false; }
    }
    changed show-pl-popup => {
        if (self.show-pl-popup) { pl-fs.focus(); } else { root.clear-confirm = false; }
    }
    changed show-q-popup => {
        if (self.show-q-popup) { q-fs.focus(); }
    }

    VerticalLayout {
        // ---- header ----
        Rectangle {
            height: 64px;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 16px;
                Text {
                    text: "Radiant";
                    color: Theme.text;
                    font-size: 22px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                HeaderItem {
                    horizontal-stretch: 1;
                    SearchField {
                        value: root.search-text;
                        edited(text) => { root.search-text = text; root.search-changed(text); }
                    }
                }
                Text {
                    text: root.status;
                    color: Theme.muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
                // Sort lives only in Tracks / Playlists: in Queues it folds away and the search field grows into its place.
                Rectangle {
                    width: root.sort-available ? 60px : 0px;
                    clip: true;
                    animate width { duration: 280ms; easing: ease-in-out; }
                    PillButton {
                        x: 0px;
                        y: (parent.height - self.height) / 2;
                        width: 60px;
                        text: "Sort";
                        active: root.show-sort;
                        opacity: root.sort-available ? 1 : 0;
                        animate opacity { duration: 200ms; }
                        clicked => {
                            if (root.sort-available) {
                                root.show-sort = !root.show-sort;
                                root.show-sound = false;
                            }
                        }
                    }
                }
                HeaderItem {
                    PillButton {
                        text: "Sound";
                        active: root.show-sound;
                        clicked => { root.show-sound = !root.show-sound; root.show-sort = false; }
                    }
                }
                HeaderItem {
                    PillButton {
                        text: "Choose folder";
                        clicked => { root.choose-folder(); }
                    }
                }
                HeaderItem {
                    width: 34px;
                    RescanButton {
                        spinning: root.scanning;
                        clicked => { root.rescan-folder(); }
                    }
                }
                HeaderItem {
                    width: 34px;
                    SettingsButton {
                        active: root.show-settings;
                        clicked => {
                            root.show-settings = !root.show-settings;
                            root.show-sort = false;
                            root.show-sound = false;
                            root.show-presets = false;
                        }
                    }
                }
            }
        }

        // ---- section bar: the lens switcher on the left, context on the right ----
        VerticalLayout {
            vertical-stretch: 1;

            Rectangle {
                height: 54px;

                // The lens: a pill that morphs. Icons only; the open section shows its name.
                Rectangle {
                    x: 20px;
                    y: 8px;
                    width: root.lens-w;
                    height: 38px;
                    border-radius: 19px;
                    background: Theme.surface;
                    animate width { duration: 280ms; easing: ease-in-out; }

                    // Glass highlight under the open segment.
                    Rectangle {
                        x: root.seg-x(root.section, root.section, root.open-extra) - 0px;
                        y: 3px;
                        width: root.seg-w + root.open-extra;
                        height: 32px;
                        border-radius: 16px;
                        background: Theme.accent.with-alpha(0.26);
                        border-width: 1px;
                        border-color: Theme.accent.with-alpha(0.55);
                        animate x { duration: 280ms; easing: ease-in-out; }
                        animate width { duration: 280ms; easing: ease-in-out; }
                    }
                    for item[i] in root.nav-items : Rectangle {
                        x: root.seg-x(i, root.section, root.open-extra);
                        y: 3px;
                        width: root.seg-w + (i == root.section ? root.open-extra : 0px);
                        height: 32px;
                        border-radius: 16px;
                        clip: true;
                        background: seg-ta.has-hover && i != root.section ? Theme.surface-hover : transparent;
                        animate x { duration: 280ms; easing: ease-in-out; }
                        animate width { duration: 280ms; easing: ease-in-out; }

                        Path {
                            x: 10px;
                            y: 6px;
                            width: 20px;
                            height: 20px;
                            viewbox-width: 20;
                            viewbox-height: 20;
                            commands: item.icon;
                            fill: i == root.section ? Theme.accent.brighter(0.5) : Theme.muted;
                            fill-rule: evenodd;
                        }
                        Text {
                            x: 36px;
                            width: item.extra;
                            height: parent.height;
                            text: item.label;
                            color: Theme.text;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                            opacity: i == root.section ? 1 : 0;
                            animate opacity { duration: 220ms; }
                        }
                        // Click = open; wheel = previous / next section.
                        seg-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.go-section(i); }
                            scroll-event(e) => {
                                root.wheel(e.delta-y, false);
                                return accept;
                            }
                        }

                        // The four queues: filled = has tracks, ring = empty, bright = open.
                        if i == 3 && root.section == 3 : Rectangle {
                            x: root.seg-w + item.extra - 4px;
                            width: root.chips-extra;
                            height: parent.height;
                            // Wheel over the dots = previous / next queue (under the dots, so their clicks still work).
                            TouchArea {
                                width: parent.width;
                                height: parent.height;
                                scroll-event(e) => {
                                    root.wheel(e.delta-y, true);
                                    return accept;
                                }
                            }
                            for q in 4 : Rectangle {
                                x: q * 30px;
                                y: 3px;
                                width: 26px;
                                height: 26px;
                                border-radius: 13px;
                                background: q == root.queue-index ? Theme.accent
                                    : root.queue-counts[q] > 0 ? Theme.accent.with-alpha(0.30)
                                    : chip-ta.has-hover ? Theme.surface-hover : transparent;
                                border-width: root.queue-counts[q] > 0 || q == root.queue-index ? 0px : 1px;
                                border-color: Theme.muted.with-alpha(0.5);
                                animate background { duration: 150ms; }
                                Text {
                                    text: q + 1;
                                    color: q == root.queue-index ? #ffffff : Theme.text;
                                    font-size: 12px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                chip-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.go-queue(q); }
                                }
                            }
                        }
                    }
                }
                Text {
                    x: parent.width - 20px - self.width;
                    width: 260px;
                    height: parent.height;
                    text: root.section == 0 ? "\{root.tracks.length} tracks"
                        : root.section == 1 ? "\{root.albums.length} albums"
                        : root.section == 2 ? "\{root.pl-total} playlists"
                        : root.section == 3 ? "Queue \{root.queue-index + 1} · \{root.queue-counts[root.queue-index]} tracks" : "";
                    color: Theme.muted;
                    font-size: 13px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }

            // Pages sit side by side on a strip; switching slides the strip (the direction shows where you went).
            Rectangle {
                vertical-stretch: 1;
                clip: true;

                // Albums: a grid of covers.
                Rectangle {
                    x: (1 - root.section) * parent.width;
                    width: parent.width;
                    height: parent.height;
                    clip: true;
                    animate x { duration: 320ms; easing: ease-in-out; }

                    if root.albums.length == 0 : Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.search-text == "" ? "No albums yet. Choose a music folder to start." : "No matching albums";
                        color: Theme.muted;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if root.albums.length > 0 : ListView {
                        for r in root.album-rows : Rectangle {
                            height: root.album-row-h;
                            for c in root.album-cols : Rectangle {
                                if r * root.album-cols + c < root.albums.length : AlbumTile {
                                    x: root.grid-pad + c * (root.tile-w + root.grid-gap);
                                    y: 12px;
                                    width: root.tile-w;
                                    height: root.album-row-h - 12px;
                                    art: root.albums[r * root.album-cols + c].cover;
                                    has-image: root.albums[r * root.album-cols + c].has-cover;
                                    letter: root.albums[r * root.album-cols + c].letter;
                                    title: root.albums[r * root.album-cols + c].title;
                                    artist: root.albums[r * root.album-cols + c].artist;
                                    dragging: root.album-drag-active && root.album-drag-from == r * root.album-cols + c;
                                    drop-target: root.album-drag-active && root.album-drag-to == r * root.album-cols + c
                                        && root.album-drag-to != root.album-drag-from;
                                    clicked => { root.album-open = true; root.open-album(r * root.album-cols + c); }
                                    shown => { root.album-shown(r * root.album-cols + c); }
                                    drag-start => {
                                        if (root.search-text == "") {
                                            root.album-drag-from = r * root.album-cols + c;
                                            root.album-drag-to = r * root.album-cols + c;
                                            root.album-drag-active = true;
                                        }
                                    }
                                    drag-move(dx, dy) => {
                                        if (root.album-drag-active) {
                                            let col = max(0, min(root.album-cols - 1, c + (dx / (root.tile-w + root.grid-gap)).round()));
                                            let row = max(0, min(root.album-rows - 1, r + (dy / root.album-row-h).round()));
                                            root.album-drag-to = min(root.albums.length - 1, row * root.album-cols + col);
                                        }
                                    }
                                    drag-end => {
                                        if (root.album-drag-active && root.album-drag-from != root.album-drag-to) {
                                            root.album-move(root.album-drag-from, root.album-drag-to);
                                        }
                                        root.album-drag-active = false;
                                    }
                                }
                            }
                        }
                    }

                    // Open album: slides in over the grid.
                    Rectangle {
                        x: root.album-open ? 0px : parent.width;
                        width: parent.width;
                        height: parent.height;
                        background: Theme.bg;
                        animate x { duration: 260ms; easing: ease-in-out; }

                        // Keeps clicks and the wheel away from the grid underneath.
                        TouchArea {
                            scroll-event(e) => { return accept; }
                        }

                        VerticalLayout {
                            // Header: title and artist centered in the window, cover on the right, back button on the left.
                            Rectangle {
                                height: 164px;
                                Text {
                                    x: root.album-side;
                                    y: 22px;
                                    width: root.album-title-w;
                                    height: 42px;
                                    text: root.album-title;
                                    color: Theme.text;
                                    font-size: 30px;
                                    font-weight: 800;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    x: root.album-side;
                                    y: 66px;
                                    width: root.album-title-w;
                                    height: 24px;
                                    text: root.album-artist;
                                    color: Theme.text;
                                    font-size: 17px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    x: root.album-side;
                                    y: 92px;
                                    width: root.album-title-w;
                                    height: 18px;
                                    text: root.album-meta;
                                    color: Theme.muted;
                                    font-size: 12.5px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                CoverArt {
                                    x: parent.width - 28px - self.width;
                                    y: 14px;
                                    width: 104px;
                                    height: 104px;
                                    border-radius: 10px;
                                    art: root.album-cover;
                                    has-image: root.album-has-cover;
                                    letter: root.album-letter;
                                    letter-size: 40px;
                                }
                                PillButton {
                                    x: parent.width / 2 - self.width - 6px;
                                    y: 122px;
                                    width: 110px;
                                    text: (root.album-current-index >= 0 && root.is-playing) ? "Pause" : "Play";
                                    active: root.album-current-index >= 0 && root.is-playing;
                                    clicked => {
                                        // A track of this album is loaded (started from anywhere): pause / resume it.
                                        if (root.album-current-index >= 0) { root.toggle-play(); }
                                        else { root.play-album(); }
                                    }
                                }
                                PillButton {
                                    x: parent.width / 2 + 6px;
                                    y: 122px;
                                    width: 110px;
                                    text: "Shuffle";
                                    active: root.shuffle;
                                    clicked => {
                                        if (root.shuffle) { root.shuffle-changed(false); }
                                        else if (root.album-current-index >= 0) { root.shuffle-changed(true); }
                                        else { root.shuffle-album(); }
                                    }
                                }
                                IconButton {
                                    x: 16px;
                                    y: 14px;
                                    width: 36px;
                                    height: 36px;
                                    commands: "M 12.5 3 L 5.5 10 L 12.5 17 L 14 15.5 L 8.5 10 L 14 4.5 Z";
                                    icon-size: 20px;
                                    clicked => { root.album-open = false; }
                                }
                            }

                            // Column captions.
                            Rectangle {
                                height: 30px;
                                Text {
                                    x: root.col-pad;
                                    width: root.num-w;
                                    height: parent.height;
                                    text: "#";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Text {
                                    x: root.title-x;
                                    width: root.album-list-title-w;
                                    height: parent.height;
                                    text: "Title";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    x: root.dur-x;
                                    width: root.dur-w;
                                    height: parent.height;
                                    text: "Time";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    x: root.col-pad;
                                    y: parent.height - 1px;
                                    width: parent.width - 2 * root.col-pad;
                                    height: 1px;
                                    background: Theme.surface-hover;
                                }
                            }

                            ListView {
                                vertical-stretch: 1;
                                for t[i] in root.album-tracks : Rectangle {
                                    height: root.detail-row-h;
                                    background: t.header != "" ? transparent
                                        : i == root.album-current-index ? Theme.accent.with-alpha(0.16)
                                        : arow-ta.has-hover ? Theme.surface : transparent;
                                    animate background { duration: 120ms; }

                                    // "Disc N" caption (multi-disc albums).
                                    if t.header != "" : Text {
                                        x: root.col-pad;
                                        y: 10px;
                                        width: parent.width - 2 * root.col-pad;
                                        height: parent.height - 10px;
                                        text: t.header;
                                        color: Theme.accent.brighter(0.5);
                                        font-size: 13px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                    if t.header == "" : Text {
                                        x: root.col-pad;
                                        width: root.num-w;
                                        height: parent.height;
                                        text: t.no;
                                        color: i == root.album-current-index ? Theme.accent : Theme.muted;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                    if t.header == "" : Text {
                                        x: root.title-x;
                                        y: t.artist == "" ? 0px : 8px;
                                        width: root.album-list-title-w;
                                        height: t.artist == "" ? parent.height : 22px;
                                        text: t.title;
                                        color: i == root.album-current-index ? Theme.accent : Theme.text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    if t.header == "" && t.artist != "" : Text {
                                        x: root.title-x;
                                        y: 30px;
                                        width: root.album-list-title-w;
                                        height: 18px;
                                        text: t.artist;
                                        color: Theme.muted;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    if t.header == "" : Text {
                                        x: root.dur-x;
                                        width: root.dur-w;
                                        height: parent.height;
                                        text: t.duration;
                                        color: Theme.muted;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                    arow-ta := TouchArea {
                                        enabled: t.header == "";
                                        mouse-cursor: pointer;
                                        clicked => { root.play-album-track(i); }
                                        pointer-event(event) => {
                                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                                root.open-menu(arow-ta.absolute-position.x + arow-ta.mouse-x, arow-ta.absolute-position.y + arow-ta.mouse-y, i, true);
                                            }
                                        }
                                    }
                                    if t.header == "" : MoreButton {
                                        x: root.dots-x;
                                        y: (parent.height - self.height) / 2;
                                        open(mx, my) => { root.open-menu(mx, my, i, true); }
                                    }
                                }
                            }
                        }
                    }
                }

                for k in 2 : Rectangle {
                    x: (k + 2 - root.section) * parent.width;
                    width: parent.width;
                    height: parent.height;
                    animate x { duration: 320ms; easing: ease-in-out; }

                    // Playlists: Liked tracks, loose playlists, then folders with their playlists.
                    if k == 0 : Rectangle {
                      x: 0px;
                      y: 0px;
                      width: parent.width;
                      height: parent.height;
                      VerticalLayout {
                        padding-top: 14px;
                        Rectangle {
                            height: 52px;
                            Text {
                                x: 28px;
                                height: parent.height;
                                text: "Playlists";
                                color: Theme.text;
                                font-size: 22px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            PillButton {
                                x: parent.width - self.width - 28px;
                                y: 9px;
                                width: 140px;
                                text: "New playlist";
                                clicked => { root.pl-open-create(); }
                            }
                        }
                        if root.pl-rows.length <= 1 : Rectangle {
                            height: 34px;
                            Text {
                                x: 28px;
                                width: parent.width - 56px;
                                height: parent.height;
                                text: "Add tracks from the three-dot menu of any track, or press New playlist.";
                                color: Theme.muted;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                        ListView {
                            vertical-stretch: 1;
                            for r[i] in root.pl-rows : Rectangle {
                                height: r.is-folder ? 50px : 64px;
                                background: root.plr-drag-active && i == root.plr-drag-from ? Theme.accent.with-alpha(0.28)
                                    : plrow-ta.has-hover ? Theme.surface : transparent;
                                animate background { duration: 120ms; }

                                // Drop marker: the dragged playlist takes the place of this row.
                                if root.plr-drag-active && i == root.plr-drag-to && root.plr-valid(root.plr-drag-from, i) : Rectangle {
                                    x: 12px;
                                    y: root.plr-drag-to > root.plr-drag-from ? parent.height - 2px : 0px;
                                    width: parent.width - 24px;
                                    height: 2px;
                                    background: Theme.accent;
                                }

                                // Folder header.
                                if r.is-folder : Path {
                                    x: 28px;
                                    y: (parent.height - self.height) / 2;
                                    width: 12px;
                                    height: 12px;
                                    viewbox-width: 10;
                                    viewbox-height: 10;
                                    commands: r.collapsed ? "M 2 0 L 9 5 L 2 10 Z" : "M 0 2 L 10 2 L 5 9 Z";
                                    fill: Theme.muted;
                                }
                                if r.is-folder : Path {
                                    x: 52px;
                                    y: (parent.height - self.height) / 2;
                                    width: 20px;
                                    height: 20px;
                                    viewbox-width: 20;
                                    viewbox-height: 20;
                                    commands: "M 1 4 Q 1 2 3 2 H 8 L 10 4 H 17 Q 19 4 19 6 V 15 Q 19 17 17 17 H 3 Q 1 17 1 15 Z";
                                    fill: Theme.accent.brighter(0.5);
                                }
                                if r.is-folder : Text {
                                    x: 84px;
                                    width: parent.width - 84px - 290px;
                                    height: parent.height;
                                    text: r.name;
                                    color: Theme.text;
                                    font-size: 15px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if r.is-folder : Text {
                                    x: parent.width - 28px - 34px - 38px - 10px - 150px;
                                    width: 150px;
                                    height: parent.height;
                                    text: r.sub;
                                    color: Theme.muted;
                                    font-size: 13px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                // Playlist: small sleeve with the record peeking out.
                                if !r.is-folder : Rectangle {
                                    x: r.indent ? 56px : 28px;
                                    y: (parent.height - 44px) / 2;
                                    width: 100px;
                                    height: 44px;
                                    Rectangle {
                                        x: 14px;
                                        y: 3px;
                                        width: 38px;
                                        height: 38px;
                                        border-radius: 19px;
                                        background: #0c0c0f;
                                        border-width: 1px;
                                        border-color: #ffffff18;
                                        Rectangle {
                                            x: 12px;
                                            y: 12px;
                                            width: 14px;
                                            height: 14px;
                                            border-radius: 7px;
                                            background: r.color-a;
                                        }
                                    }
                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        width: 44px;
                                        height: 44px;
                                        border-radius: 8px;
                                        background: @linear-gradient(135deg, r.color-a, r.color-b);
                                        if !r.liked : Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: r.letter;
                                            color: #ffffff55;
                                            font-size: 20px;
                                            font-weight: 800;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        if r.liked : Path {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            width: 22px;
                                            height: 22px;
                                            viewbox-width: 20;
                                            viewbox-height: 20;
                                            commands: "M 10 17.5 C 2 11.5 2 5 6 4 C 8 3.5 9.5 4.5 10 6 C 10.5 4.5 12 3.5 14 4 C 18 5 18 11.5 10 17.5 Z";
                                            fill: #ffffff80;
                                        }
                                    }
                                }
                                if !r.is-folder : Text {
                                    x: (r.indent ? 56px : 28px) + 66px;
                                    y: 11px;
                                    width: parent.width - self.x - 28px - 48px;
                                    height: 22px;
                                    text: r.name;
                                    color: Theme.text;
                                    font-size: 15px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if !r.is-folder : Text {
                                    x: (r.indent ? 56px : 28px) + 66px;
                                    y: 33px;
                                    width: parent.width - self.x - 28px - 48px;
                                    height: 20px;
                                    text: r.sub;
                                    color: Theme.muted;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                                plrow-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(event) => {
                                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                            root.suppress-click = false;
                                            root.plr-drag-from = i;
                                            root.plr-drag-to = i;
                                            root.plr-drag-moved = false;
                                            root.plr-drag-active = !r.is-folder && !r.liked;
                                        } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.plr-drag-active) {
                                            if (root.plr-drag-moved && root.plr-valid(root.plr-drag-from, root.plr-drag-to)) {
                                                root.pl-move-playlist(root.plr-drag-from, root.plr-drag-to);
                                                root.suppress-click = true;
                                            }
                                            root.plr-drag-active = false;
                                            root.plr-drag-moved = false;
                                        }
                                    }
                                    moved => {
                                        if (self.pressed && root.plr-drag-active && abs(self.mouse-y - self.pressed-y) > 8px) {
                                            let target = max(0, min(root.pl-rows.length - 1,
                                                i + ((self.mouse-y - self.pressed-y) / 64px).round()));
                                            if (target != root.plr-drag-to) { root.plr-drag-to = target; }
                                            root.plr-drag-moved = true;
                                        }
                                    }
                                    clicked => {
                                        if (root.suppress-click) { root.suppress-click = false; }
                                        else { root.pl-row-clicked(i); }
                                    }
                                }
                                // Folder header: rename / delete.
                                if r.is-folder : IconButton {
                                    x: parent.width - 28px - 34px - 38px;
                                    y: (parent.height - self.height) / 2;
                                    width: 34px;
                                    height: 34px;
                                    icon-size: 16px;
                                    icon-color: Theme.muted;
                                    commands: "M 3 14.5 V 17 H 5.5 L 14.8 7.7 L 12.3 5.2 Z M 16.7 5.8 L 14.2 3.3 L 12.9 4.6 L 15.4 7.1 Z";
                                    clicked => { root.pl-open-rename-folder(i); }
                                }
                                if r.is-folder : IconButton {
                                    x: parent.width - 28px - 34px;
                                    y: (parent.height - self.height) / 2;
                                    width: 34px;
                                    height: 34px;
                                    icon-size: 16px;
                                    icon-color: Theme.muted;
                                    commands: "M 6 3 H 14 L 14.8 4.5 H 17.5 V 6 H 2.5 V 4.5 H 5.2 Z M 4 7.5 H 16 L 15.2 17 H 4.8 Z";
                                    clicked => { root.pl-open-delete-folder(i); }
                                }
                                // Move into a folder (Liked tracks has no folder).
                                if !r.is-folder && !r.liked : IconButton {
                                    x: parent.width - 28px - self.width - 12px;
                                    y: (parent.height - self.height) / 2;
                                    width: 34px;
                                    height: 34px;
                                    icon-color: Theme.muted;
                                    commands: "M 1 4 Q 1 2 3 2 H 8 L 10 4 H 17 Q 19 4 19 6 V 15 Q 19 17 17 17 H 3 Q 1 17 1 15 Z";
                                    clicked => { root.pl-open-move(i); }
                                }
                            }
                        }
                      }

                      // Open playlist: slides in over the list.
                      Rectangle {
                        x: root.pl-open ? 0px : root.width;
                        y: 0px;
                        width: root.width;
                        height: parent.height;
                        background: Theme.bg;
                        animate x { duration: 260ms; easing: ease-in-out; }
                        // Never shows over another section, whatever happens to the strip.
                        opacity: root.section == 2 ? 1 : 0;
                        visible: self.opacity > 0.01;
                        animate opacity { duration: 320ms; }

                        TouchArea {
                            scroll-event(e) => { return accept; }
                        }

                        VerticalLayout {
                            Rectangle {
                                height: 164px;
                                Text {
                                    x: root.album-side;
                                    y: 22px;
                                    width: root.album-title-w;
                                    height: 42px;
                                    text: root.pl-page-title;
                                    color: Theme.text;
                                    font-size: 30px;
                                    font-weight: 800;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    x: root.album-side;
                                    y: 70px;
                                    width: root.album-title-w;
                                    height: 20px;
                                    text: root.pl-page-meta;
                                    color: Theme.muted;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                // Sleeve on the right, like the album cover.
                                Rectangle {
                                    x: parent.width - 28px - self.width;
                                    y: 14px;
                                    width: 104px;
                                    height: 104px;
                                    border-radius: 10px;
                                    background: @linear-gradient(135deg, root.pl-page-color-a, root.pl-page-color-b);
                                    if !root.pl-page-liked : Text {
                                        width: parent.width;
                                        height: parent.height;
                                        text: root.pl-page-letter;
                                        color: #ffffff40;
                                        font-size: 46px;
                                        font-weight: 800;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    if root.pl-page-liked : Path {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 52px;
                                        height: 52px;
                                        viewbox-width: 20;
                                        viewbox-height: 20;
                                        commands: "M 10 17.5 C 2 11.5 2 5 6 4 C 8 3.5 9.5 4.5 10 6 C 10.5 4.5 12 3.5 14 4 C 18 5 18 11.5 10 17.5 Z";
                                        fill: #ffffff66;
                                    }
                                }
                                IconButton {
                                    x: 16px;
                                    y: 14px;
                                    width: 36px;
                                    height: 36px;
                                    commands: "M 12.5 3 L 5.5 10 L 12.5 17 L 14 15.5 L 8.5 10 L 14 4.5 Z";
                                    icon-size: 20px;
                                    clicked => { root.pl-open = false; }
                                }
                                PillButton {
                                    x: root.pl-btn-x0;
                                    y: 122px;
                                    width: 104px;
                                    text: (root.pl-current-index >= 0 && root.is-playing) ? "Pause" : "Play";
                                    active: root.pl-current-index >= 0 && root.is-playing;
                                    clicked => {
                                        if (root.pl-current-index >= 0) { root.toggle-play(); }
                                        else { root.pl-play-all(); }
                                    }
                                }
                                PillButton {
                                    x: root.pl-btn-x0 + 114px;
                                    y: 122px;
                                    width: 104px;
                                    text: "Shuffle";
                                    active: root.shuffle;
                                    clicked => {
                                        if (root.shuffle) { root.shuffle-changed(false); }
                                        else if (root.pl-current-index >= 0) { root.shuffle-changed(true); }
                                        else { root.pl-shuffle-all(); }
                                    }
                                }
                                if !root.pl-page-liked : PillButton {
                                    x: root.pl-btn-x0 + 228px;
                                    y: 122px;
                                    width: 104px;
                                    text: "Rename";
                                    clicked => { root.pl-open-rename-playlist(); }
                                }
                                if !root.pl-page-liked : PillButton {
                                    x: root.pl-btn-x0 + 342px;
                                    y: 122px;
                                    width: 104px;
                                    text: "Delete";
                                    clicked => { root.pl-open-delete-playlist(); }
                                }
                            }

                            if root.pl-page-tracks.length == 0 : Rectangle {
                                vertical-stretch: 1;
                                Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: "No tracks yet. Use \"Add to playlist\" in the menu of a track.";
                                    color: Theme.muted;
                                    font-size: 15px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            if root.pl-page-tracks.length > 0 : Rectangle {
                                height: 30px;
                                Text {
                                    x: root.col-pad;
                                    width: root.num-w;
                                    height: parent.height;
                                    text: "#";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Text {
                                    x: root.title-x;
                                    width: root.album-list-title-w;
                                    height: parent.height;
                                    text: "Title";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    x: root.dur-x;
                                    width: root.dur-w;
                                    height: parent.height;
                                    text: "Time";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    x: root.col-pad;
                                    y: parent.height - 1px;
                                    width: parent.width - 2 * root.col-pad;
                                    height: 1px;
                                    background: Theme.surface-hover;
                                }
                            }
                            if root.pl-page-tracks.length > 0 : ListView {
                                vertical-stretch: 1;
                                for t[i] in root.pl-page-tracks : Rectangle {
                                    height: root.detail-row-h;
                                    background: root.pl-drag-active && i == root.pl-drag-from ? Theme.accent.with-alpha(0.28)
                                        : i == root.pl-current-index ? Theme.accent.with-alpha(0.16)
                                        : plt-ta.has-hover ? Theme.surface : transparent;
                                    animate background { duration: 120ms; }

                                    if root.pl-drag-active && i == root.pl-drag-to : Rectangle {
                                        x: 12px;
                                        y: root.pl-drag-to > root.pl-drag-from ? parent.height - 2px : 0px;
                                        width: parent.width - 24px;
                                        height: 2px;
                                        background: Theme.accent;
                                    }

                                    Text {
                                        x: root.col-pad;
                                        width: root.num-w;
                                        height: parent.height;
                                        text: t.no;
                                        color: i == root.pl-current-index ? Theme.accent : Theme.muted;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        x: root.title-x;
                                        y: t.artist == "" ? 0px : 8px;
                                        width: root.album-list-title-w;
                                        height: t.artist == "" ? parent.height : 22px;
                                        text: t.title;
                                        color: t.missing ? Theme.muted : i == root.pl-current-index ? Theme.accent : Theme.text;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    if t.artist != "" : Text {
                                        x: root.title-x;
                                        y: 30px;
                                        width: root.album-list-title-w;
                                        height: 18px;
                                        text: t.artist;
                                        color: Theme.muted;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        x: root.dur-x;
                                        width: root.dur-w;
                                        height: parent.height;
                                        text: t.duration;
                                        color: Theme.muted;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                    plt-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        pointer-event(event) => {
                                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                                root.open-pl-menu(plt-ta.absolute-position.x + plt-ta.mouse-x, plt-ta.absolute-position.y + plt-ta.mouse-y, i);
                                            }
                                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                                root.suppress-click = false;
                                                root.pl-drag-from = i;
                                                root.pl-drag-to = i;
                                                root.pl-drag-active = true;
                                                root.pl-drag-moved = false;
                                            } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.pl-drag-active) {
                                                if (root.pl-drag-moved && root.pl-drag-from != root.pl-drag-to) {
                                                    root.pl-move-track(root.pl-drag-from, root.pl-drag-to);
                                                    root.suppress-click = true;
                                                }
                                                root.pl-drag-active = false;
                                                root.pl-drag-moved = false;
                                            }
                                        }
                                        moved => {
                                            if (self.pressed && root.pl-drag-active) {
                                                let target = max(0, min(root.pl-page-tracks.length - 1,
                                                    i + ((self.mouse-y - self.pressed-y) / root.detail-row-h).round()));
                                                if (target != root.pl-drag-to) {
                                                    root.pl-drag-to = target;
                                                    root.pl-drag-moved = true;
                                                }
                                            }
                                        }
                                        clicked => {
                                            if (root.suppress-click) { root.suppress-click = false; }
                                            else { root.pl-play-track(i); }
                                        }
                                    }
                                    MoreButton {
                                        x: root.dots-x;
                                        y: (parent.height - self.height) / 2;
                                        open(mx, my) => { root.open-pl-menu(mx, my, i); }
                                    }
                                }
                            }
                        }
                      }
                    }

                    // Queue page: the tracks of the open queue (drag to reorder, click to play).
                    if k == 1 : Rectangle {
                      x: root.q-shift;
                      width: parent.width;
                      height: parent.height;
                      opacity: root.q-fade;
                      animate x { duration: root.q-anim-reset ? 0ms : 260ms; easing: ease-out; }
                      animate opacity { duration: root.q-anim-reset ? 0ms : 260ms; easing: ease-out; }
                      VerticalLayout {
                        Rectangle {
                            height: 124px;
                            Text {
                                x: 28px;
                                y: 16px;
                                width: parent.width - 56px;
                                height: 30px;
                                text: "Queue \{root.queue-index + 1}";
                                color: Theme.text;
                                font-size: 22px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Text {
                                x: 28px;
                                y: 48px;
                                width: parent.width - 56px;
                                height: 18px;
                                text: root.queue-page-meta;
                                color: Theme.muted;
                                font-size: 13px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            PillButton {
                                x: 28px;
                                y: 78px;
                                width: 104px;
                                text: (root.queue-current-index >= 0 && root.is-playing) ? "Pause" : "Play";
                                active: root.queue-current-index >= 0 && root.is-playing;
                                clicked => {
                                    if (root.queue-current-index >= 0) { root.toggle-play(); }
                                    else { root.queue-play-all(); }
                                }
                            }
                            PillButton {
                                x: 142px;
                                y: 78px;
                                width: 104px;
                                text: "Shuffle";
                                active: root.shuffle;
                                clicked => {
                                    if (root.shuffle) { root.shuffle-changed(false); }
                                    else if (root.queue-current-index >= 0) { root.shuffle-changed(true); }
                                    else { root.queue-shuffle-all(); }
                                }
                            }
                            PillButton {
                                x: 256px;
                                y: 78px;
                                width: 104px;
                                text: "Clear";
                                clicked => { root.clear-confirm = true; root.queue-clear-ask(); }
                            }
                        }

                        if root.queue-page-tracks.length == 0 : Rectangle {
                            vertical-stretch: 1;
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: "Queue \{root.queue-index + 1} is empty. Use \"Add to queue\" in the menu of a track.";
                                color: Theme.muted;
                                font-size: 15px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        if root.queue-page-tracks.length > 0 : Rectangle {
                            height: 30px;
                            Text {
                                x: root.col-pad;
                                width: root.num-w;
                                height: parent.height;
                                text: "#";
                                color: Theme.muted;
                                font-size: 12px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            Text {
                                x: root.title-x;
                                width: root.album-list-title-w;
                                height: parent.height;
                                text: "Title";
                                color: Theme.muted;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Text {
                                x: root.dur-x;
                                width: root.dur-w;
                                height: parent.height;
                                text: "Time";
                                color: Theme.muted;
                                font-size: 12px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                x: root.col-pad;
                                y: parent.height - 1px;
                                width: parent.width - 2 * root.col-pad;
                                height: 1px;
                                background: Theme.surface-hover;
                            }
                        }
                        if root.queue-page-tracks.length > 0 : ListView {
                            vertical-stretch: 1;
                            for t[i] in root.queue-page-tracks : Rectangle {
                                height: root.detail-row-h;
                                background: root.q-drag-active && i == root.q-drag-from ? Theme.accent.with-alpha(0.28)
                                    : i == root.queue-current-index ? Theme.accent.with-alpha(0.16)
                                    : qt-ta.has-hover ? Theme.surface : transparent;
                                animate background { duration: 120ms; }

                                if root.q-drag-active && i == root.q-drag-to : Rectangle {
                                    x: 12px;
                                    y: root.q-drag-to > root.q-drag-from ? parent.height - 2px : 0px;
                                    width: parent.width - 24px;
                                    height: 2px;
                                    background: Theme.accent;
                                }

                                Text {
                                    x: root.col-pad;
                                    width: root.num-w;
                                    height: parent.height;
                                    text: t.no;
                                    color: i == root.queue-current-index ? Theme.accent : Theme.muted;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Text {
                                    x: root.title-x;
                                    y: t.artist == "" ? 0px : 8px;
                                    width: root.album-list-title-w;
                                    height: t.artist == "" ? parent.height : 22px;
                                    text: t.title;
                                    color: t.missing ? Theme.muted : i == root.queue-current-index ? Theme.accent : Theme.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                if t.artist != "" : Text {
                                    x: root.title-x;
                                    y: 30px;
                                    width: root.album-list-title-w;
                                    height: 18px;
                                    text: t.artist;
                                    color: Theme.muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    x: root.dur-x;
                                    width: root.dur-w;
                                    height: parent.height;
                                    text: t.duration;
                                    color: Theme.muted;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                qt-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    pointer-event(event) => {
                                        if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                            root.open-queue-menu(qt-ta.absolute-position.x + qt-ta.mouse-x, qt-ta.absolute-position.y + qt-ta.mouse-y, i);
                                        }
                                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                            root.suppress-click = false;
                                            root.q-drag-from = i;
                                            root.q-drag-to = i;
                                            root.q-drag-active = true;
                                            root.q-drag-moved = false;
                                        } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.q-drag-active) {
                                            if (root.q-drag-moved && root.q-drag-from != root.q-drag-to) {
                                                root.queue-move-track(root.q-drag-from, root.q-drag-to);
                                                root.suppress-click = true;
                                            }
                                            root.q-drag-active = false;
                                            root.q-drag-moved = false;
                                        }
                                    }
                                    moved => {
                                        if (self.pressed && root.q-drag-active) {
                                            let target = max(0, min(root.queue-page-tracks.length - 1,
                                                i + ((self.mouse-y - self.pressed-y) / root.detail-row-h).round()));
                                            if (target != root.q-drag-to) {
                                                root.q-drag-to = target;
                                                root.q-drag-moved = true;
                                            }
                                        }
                                    }
                                    clicked => {
                                        if (root.suppress-click) { root.suppress-click = false; }
                                        else { root.queue-play-track(i); }
                                    }
                                }
                                MoreButton {
                                    x: root.dots-x;
                                    y: (parent.height - self.height) / 2;
                                    open(mx, my) => { root.open-queue-menu(mx, my, i); }
                                }
                            }
                        }
                      }
                    }
                }

            Rectangle {
                x: (0 - root.section) * parent.width;
                width: parent.width;
                height: parent.height;
                animate x { duration: 320ms; easing: ease-in-out; }
            VerticalLayout {

            // Column captions.
            if root.tracks.length > 0 : Rectangle {
                height: 30px;
                Text {
                    x: root.col-pad;
                    width: root.num-w;
                    height: parent.height;
                    text: "#";
                    color: Theme.muted;
                    font-size: 12px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                Text {
                    x: root.title-x;
                    width: root.title-w;
                    height: parent.height;
                    text: "Title";
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                if root.show-album : Text {
                    x: root.album-x;
                    width: root.album-w;
                    height: parent.height;
                    text: "Album";
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                if root.show-year : Text {
                    x: root.year-x;
                    width: root.year-w;
                    height: parent.height;
                    text: "Year";
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Text {
                    x: root.dur-x;
                    width: root.dur-w;
                    height: parent.height;
                    text: "Time";
                    color: Theme.muted;
                    font-size: 12px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                Rectangle {
                    x: root.col-pad;
                    y: parent.height - 1px;
                    width: parent.width - 2 * root.col-pad;
                    height: 1px;
                    background: Theme.surface-hover;
                }
            }

            if root.tracks.length == 0 : Rectangle {
                vertical-stretch: 1;
                Text {
                    width: parent.width;
                    height: parent.height;
                    text: root.search-text == "" ? "Choose a music folder to start" : "No matching tracks";
                    color: Theme.muted;
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.tracks.length > 0 : ListView {
                vertical-stretch: 1;
                for t[i] in root.tracks : Rectangle {
                    height: root.row-h;
                    background: root.drag-active && i == root.drag-from ? Theme.accent.with-alpha(0.28)
                        : i == root.current-index ? Theme.accent.with-alpha(0.16)
                        : row-ta.has-hover ? Theme.surface : transparent;
                    animate y { duration: 180ms; easing: ease-in-out; }
                    animate background { duration: 120ms; }

                    if root.drag-active && i == root.drag-to : Rectangle {
                        x: 12px;
                        y: root.drag-to > root.drag-from ? parent.height - 2px : 0px;
                        width: parent.width - 24px;
                        height: 2px;
                        background: Theme.accent;
                    }

                    // 1. number
                    Text {
                        x: root.col-pad;
                        width: root.num-w;
                        height: parent.height;
                        text: i + 1;
                        color: i == root.current-index ? Theme.accent : Theme.muted;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    // 2. cover, title and artist
                    CoverArt {
                        x: root.title-x;
                        y: (parent.height - self.height) / 2;
                        art: t.cover;
                        has-image: t.has-cover;
                        letter: t.letter;
                    }
                    Text {
                        x: root.title-x + 52px;
                        y: t.artist == "" ? 0px : 8px;
                        width: max(0px, root.title-w - 52px);
                        height: t.artist == "" ? parent.height : 22px;
                        text: t.title;
                        color: i == root.current-index ? Theme.accent : Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if t.artist != "" : Text {
                        x: root.title-x + 52px;
                        y: 30px;
                        width: max(0px, root.title-w - 52px);
                        height: 18px;
                        text: t.artist;
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    // 3. album
                    if root.show-album : Text {
                        x: root.album-x;
                        width: root.album-w;
                        height: parent.height;
                        text: t.album;
                        color: Theme.muted;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    // 4. year
                    if root.show-year : Text {
                        x: root.year-x;
                        width: root.year-w;
                        height: parent.height;
                        text: t.year;
                        color: Theme.muted;
                        vertical-alignment: center;
                    }
                    // 5. duration
                    Text {
                        x: root.dur-x;
                        width: root.dur-w;
                        height: parent.height;
                        text: t.duration;
                        color: Theme.muted;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    row-ta := TouchArea {
                        mouse-cursor: pointer;
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                                root.open-menu(row-ta.absolute-position.x + row-ta.mouse-x, row-ta.absolute-position.y + row-ta.mouse-y, i, false);
                            }
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                root.suppress-click = false;
                            }
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down && root.search-text == "") {
                                root.drag-from = i;
                                root.drag-to = i;
                                root.drag-active = true;
                                root.drag-moved = false;
                            } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.drag-active) {
                                if (root.drag-moved && root.drag-from != root.drag-to) {
                                    root.reorder-tracks(root.drag-from, root.drag-to);
                                    root.suppress-click = true;
                                }
                                root.drag-active = false;
                                root.drag-moved = false;
                            }
                        }
                        moved => {
                            if (self.pressed && root.drag-active) {
                                let target = max(0, min(root.tracks.length - 1,
                                    i + ((self.mouse-y - self.pressed-y) / root.row-h).round()));
                                if (target != root.drag-to) {
                                    root.drag-to = target;
                                    root.drag-moved = true;
                                }
                            }
                        }
                        clicked => {
                            if (root.suppress-click) { root.suppress-click = false; }
                            else { root.play-track(i); }
                        }
                    }
                    MoreButton {
                        x: root.dots-x;
                        y: (parent.height - self.height) / 2;
                        open(mx, my) => { root.open-menu(mx, my, i, false); }
                    }
                }
            }
            }
            }
            }
        }

        // ---- player bar ----
        Rectangle {
            height: 112px;
            background: Theme.surface;

            VerticalLayout {
            padding-top: 8px;
            spacing: 0px;

            HorizontalLayout {
                height: 24px;
                padding-left: 24px;
                padding-right: 24px;
                spacing: 12px;
                Text {
                    text: root.position-text;
                    width: 44px;
                    color: Theme.muted;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                SeekBar {
                    ratio: root.progress;
                    duration-secs: root.duration-secs;
                    seek(r) => { root.seek(r); }
                }
                Text {
                    text: root.duration-text;
                    width: 44px;
                    color: Theme.muted;
                    vertical-alignment: center;
                }
            }

            // Control row: every block has an absolute position, so the title length
            // can never move the buttons. Transport is centered in the window, the title
            // takes the space to its left, volume sits at the right edge.
            Rectangle {
                vertical-stretch: 1;

                // Cover of the playing track (or a tile with its first letter), like in the list.
                if root.now-playing != "" : CoverArt {
                    x: 24px;
                    y: (parent.height - self.height) / 2;
                    width: 52px;
                    height: 52px;
                    border-radius: 8px;
                    art: root.np-cover;
                    has-image: root.np-has-cover;
                    letter: root.np-letter;
                    letter-size: 22px;
                }
                // Two lines: title (tag, file name as fallback) and "artist · album · year".
                VerticalLayout {
                    x: root.now-playing != "" ? 88px : 24px;
                    y: 0px;
                    width: max(0px, (parent.width - 348px) / 2 - (root.now-playing != "" ? 88px : 24px) - 16px);
                    height: parent.height;
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.np-title != "" ? root.np-title : root.now-playing;
                        color: root.show-player ? Theme.accent : Theme.text;
                        font-weight: 600;
                        overflow: elide;
                    }
                    if root.np-sub != "" && root.now-playing != "" : Text {
                        text: root.np-sub;
                        color: Theme.muted;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                // Click the title to open / close the big player view.
                TouchArea {
                    x: 24px;
                    width: max(0px, (parent.width - 348px) / 2 - 24px - 16px);
                    height: parent.height;
                    enabled: root.now-playing != "";
                    mouse-cursor: pointer;
                    clicked => {
                        root.show-player = !root.show-player;
                        root.show-sort = false;
                        root.show-sound = false;
                    }
                }

                // Center: transport controls.
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 348px;
                    height: 52px;
                    ToggleText {
                        x: 0px;
                        y: 12px;
                        width: 84px;
                        height: 28px;
                        text: "Shuffle";
                        active: root.shuffle;
                        clicked => { root.shuffle-changed(!root.shuffle); }
                    }
                    IconButton {
                        x: 96px;
                        y: 6px;
                        width: 40px;
                        height: 40px;
                        commands: "M 1 0 H 4 V 20 H 1 Z M 19 0 V 20 L 6 10 Z";
                        clicked => { root.previous-track(); }
                    }
                    IconButton {
                        x: 148px;
                        y: 0px;
                        width: 52px;
                        height: 52px;
                        icon-size: 20px;
                        icon-color: #ffffff;
                        idle-color: Theme.accent;
                        hover-color: Theme.accent.brighter(0.2);
                        commands: root.is-playing
                            ? "M 3 0 H 8 V 20 H 3 Z M 12 0 H 17 V 20 H 12 Z"
                            : "M 4 0 L 19 10 L 4 20 Z";
                        clicked => { root.toggle-play(); }
                    }
                    IconButton {
                        x: 212px;
                        y: 6px;
                        width: 40px;
                        height: 40px;
                        commands: "M 16 0 H 19 V 20 H 16 Z M 1 0 L 14 10 L 1 20 Z";
                        clicked => { root.next-track(); }
                    }
                    ToggleText {
                        x: 264px;
                        y: 12px;
                        width: 84px;
                        height: 28px;
                        text: root.repeat-mode == 0 ? "Repeat"
                            : root.repeat-mode == 1 ? "Repeat all" : "Repeat one";
                        active: root.repeat-mode != 0;
                        clicked => { root.repeat-changed(root.repeat-mode >= 2 ? 0 : root.repeat-mode + 1); }
                    }
                }

                // Add the playing track to a queue (small button left of the playlist button).
                if root.now-playing != "" : IconButton {
                    x: parent.width - 24px - 150px - 8px - 28px - 6px - self.width;
                    y: (parent.height - self.height) / 2;
                    width: 28px;
                    height: 28px;
                    icon-size: 16px;
                    commands: "M 1 3 H 11 V 5 H 1 Z M 1 8 H 11 V 10 H 1 Z M 1 13 H 7 V 15 H 1 Z M 12 11 L 19 15 L 12 19 Z";
                    clicked => { root.add-current-to-queue(); }
                }
                // Add the playing track to a playlist (small button left of the volume block).
                if root.now-playing != "" : IconButton {
                    x: parent.width - 24px - 150px - 8px - self.width;
                    y: (parent.height - self.height) / 2;
                    width: 28px;
                    height: 28px;
                    icon-size: 16px;
                    commands: "M 1 3 H 11 V 5 H 1 Z M 1 8 H 11 V 10 H 1 Z M 1 13 H 7 V 15 H 1 Z M 14 9 H 16 V 12 H 19 V 14 H 16 V 17 H 14 V 14 H 11 V 12 H 14 Z";
                    clicked => { root.add-current-to-playlist(); }
                }

                // Right: volume (click the speaker to mute / unmute).
                Rectangle {
                    x: parent.width - 24px - self.width;
                    y: (parent.height - self.height) / 2;
                    width: 150px;
                    height: 28px;
                    IconButton {
                        x: 0px;
                        y: 0px;
                        width: 28px;
                        height: 28px;
                        icon-size: 16px;
                        icon-color: root.volume <= 0.001 ? Theme.muted : Theme.text;
                        commands: "M 1 7 H 5 L 11 2 V 18 L 5 13 H 1 Z M 13 6 Q 16.5 10 13 14 L 14.5 15.5 Q 19.5 10 14.5 4.5 Z";
                        clicked => {
                            if (root.volume > 0.001) {
                                root.volume-before-mute = root.volume;
                                root.volume = 0.0;
                            } else {
                                root.volume = root.volume-before-mute;
                            }
                            root.volume-changed(root.volume);
                        }
                    }
                    VolumeBar {
                        x: 36px;
                        y: 4px;
                        width: 110px;
                        height: 20px;
                        value: root.volume;
                        edited(v) => {
                            root.volume = v;
                            root.volume-changed(v);
                        }
                    }
                }
            }
            }
        }
    }

    // ---- big player view: covers the track list, the player bar below stays usable ----
    if root.show-player : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.player-h;
        background: Theme.bg;
        clip: true;

        // Swallows every mouse event the player does not use itself, so clicks never fall
        // through to the track list underneath (they used to start another track).
        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        // Stage: glow, progress ring, cover, title.
        if root.stage-visible : stage := Rectangle {
            x: 0px;
            y: root.header-h;
            width: root.stage-w;
            height: root.player-h - root.header-h;

            property <length> zone-h: self.height - 76px;
            // The rays need 20 % of the ring diameter on every side.
            property <length> ring-d: max(90px, min(self.zone-h, min(self.width - 40px, 500px)) / 1.4);
            property <length> ring-x: (self.width - self.ring-d) / 2;
            property <length> ring-y: max(0px, (self.zone-h - self.ring-d) / 2);
            // Seconds, ticking every frame while the stage is on screen (drives the drifting lights).
            property <float> t: animation-tick() / 1s;
            property <float> ring-drag: 0;
            property <bool> ring-band: false;
            property <float> ring-ratio: ring-ta.pressed && self.ring-band ? self.ring-drag : root.progress;
            property <float> ring-c: self.ring-d / 2px;
            property <float> ring-r: self.ring-c - 2;
            property <angle> ring-angle: min(self.ring-ratio, 0.9999) * 360deg;
            property <float> ring-x1: self.ring-c + self.ring-r * Math.sin(self.ring-angle);
            property <float> ring-y1: self.ring-c - self.ring-r * Math.cos(self.ring-angle);

            // Light spilling out of the cover: five colored lights drift on their own paths (sums of
            // sines with unrelated speeds, so the picture never repeats) and swell with bass / loudness.
            GlowBlob {
                tint: root.glow-color;
                cx: stage.ring-x + stage.ring-d * (0.5 + 0.18 * Math.sin(stage.t * 0.7rad) + 0.06 * Math.sin(stage.t * 3.1rad));
                cy: stage.ring-y + stage.ring-d * (0.5 + 0.15 * Math.cos(stage.t * 0.9rad));
                size: stage.ring-d * (1.9 + 0.5 * root.pulse + 0.15 * Math.sin(stage.t * 1.3rad));
                strength: 0.28 + 0.40 * root.pulse;
            }
            GlowBlob {
                tint: root.glow-color.mix(#ff4fd8, 0.5);
                cx: stage.ring-x + stage.ring-d * (0.5 + 0.45 * Math.sin(stage.t * 0.37rad + 1rad) + 0.08 * Math.sin(stage.t * 4.3rad));
                cy: stage.ring-y + stage.ring-d * (0.5 + 0.40 * Math.cos(stage.t * 0.53rad));
                size: stage.ring-d * (1.2 + 0.5 * root.energy + 0.2 * Math.sin(stage.t * 1.9rad));
                strength: 0.16 + 0.26 * root.energy;
            }
            GlowBlob {
                tint: root.glow-color.mix(#36d6ff, 0.5);
                cx: stage.ring-x + stage.ring-d * (0.5 + 0.50 * Math.cos(stage.t * 0.43rad) + 0.07 * Math.sin(stage.t * 5.2rad));
                cy: stage.ring-y + stage.ring-d * (0.5 + 0.45 * Math.sin(stage.t * 0.61rad + 2rad));
                size: stage.ring-d * (1.1 + 0.4 * root.pulse + 0.2 * Math.sin(stage.t * 2.3rad + 1rad));
                strength: 0.14 + 0.26 * root.pulse;
            }
            GlowBlob {
                tint: root.glow-color.mix(#ffb347, 0.45);
                cx: stage.ring-x + stage.ring-d * (0.5 + 0.55 * Math.sin(stage.t * 0.29rad + 4rad));
                cy: stage.ring-y + stage.ring-d * (0.5 + 0.35 * Math.cos(stage.t * 0.47rad + 1rad) + 0.08 * Math.cos(stage.t * 3.7rad));
                size: stage.ring-d * (0.9 + 0.5 * root.energy + 0.2 * Math.sin(stage.t * 1.6rad));
                strength: 0.10 + 0.24 * root.energy;
            }
            GlowBlob {
                tint: root.glow-color.brighter(0.7);
                cx: stage.ring-x + stage.ring-d * (0.5 + 0.30 * Math.sin(stage.t * 1.7rad) + 0.10 * Math.sin(stage.t * 6.3rad));
                cy: stage.ring-y + stage.ring-d * (0.5 + 0.30 * Math.cos(stage.t * 1.3rad + 0.5rad));
                size: stage.ring-d * (0.7 + 0.7 * root.pulse);
                strength: 0.08 + 0.34 * root.pulse;
            }
            // Spectrum rays: soft halo, body, bright tips, falling peak markers.
            Path {
                x: stage.ring-x - stage.ring-d * 0.2;
                y: stage.ring-y - stage.ring-d * 0.2;
                width: stage.ring-d * 1.4;
                height: stage.ring-d * 1.4;
                viewbox-width: 1000;
                viewbox-height: 1000;
                commands: root.rays-halo;
                fill: root.glow-color.with-alpha(0.16 + 0.22 * root.pulse);
            }
            Path {
                x: stage.ring-x - stage.ring-d * 0.2;
                y: stage.ring-y - stage.ring-d * 0.2;
                width: stage.ring-d * 1.4;
                height: stage.ring-d * 1.4;
                viewbox-width: 1000;
                viewbox-height: 1000;
                commands: root.rays-body;
                fill: root.glow-color.with-alpha(0.88);
            }
            Path {
                x: stage.ring-x - stage.ring-d * 0.2;
                y: stage.ring-y - stage.ring-d * 0.2;
                width: stage.ring-d * 1.4;
                height: stage.ring-d * 1.4;
                viewbox-width: 1000;
                viewbox-height: 1000;
                commands: root.rays-tips;
                fill: root.glow-color.brighter(1.0);
            }
            Path {
                x: stage.ring-x - stage.ring-d * 0.2;
                y: stage.ring-y - stage.ring-d * 0.2;
                width: stage.ring-d * 1.4;
                height: stage.ring-d * 1.4;
                viewbox-width: 1000;
                viewbox-height: 1000;
                commands: root.rays-peaks;
                fill: #ffffffd0;
            }
            // Ring track.
            Rectangle {
                x: stage.ring-x;
                y: stage.ring-y;
                width: stage.ring-d;
                height: stage.ring-d;
                border-radius: self.width / 2;
                border-width: 4px;
                border-color: Theme.surface-hover;
            }
            // Ring progress.
            Path {
                x: stage.ring-x;
                y: stage.ring-y;
                width: stage.ring-d;
                height: stage.ring-d;
                viewbox-width: stage.ring-d / 1px;
                viewbox-height: stage.ring-d / 1px;
                commands: stage.ring-ratio < 0.002 ? "M 0 0"
                    : "M \{stage.ring-c} \{stage.ring-c - stage.ring-r} A \{stage.ring-r} \{stage.ring-r} 0 \{stage.ring-ratio > 0.5 ? 1 : 0} 1 \{stage.ring-x1} \{stage.ring-y1}";
                stroke: root.glow-color.brighter(0.2);
                stroke-width: 4px;
                stroke-line-cap: round;
            }
            // Knob at the end of the progress (hover / drag).
            Rectangle {
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: Theme.text;
                visible: ring-ta.has-hover || ring-ta.pressed;
                x: stage.ring-x + stage.ring-x1 * 1px - 6px;
                y: stage.ring-y + stage.ring-y1 * 1px - 6px;
            }
            // Round cover.
            CoverArt {
                x: stage.ring-x + 14px;
                y: stage.ring-y + 14px;
                width: stage.ring-d - 28px;
                height: stage.ring-d - 28px;
                border-radius: self.width / 2;
                art: root.np-cover;
                has-image: root.np-has-cover;
                letter: root.np-letter;
                letter-size: stage.ring-d / 4;
            }
            // Paused: a play mark over the cover.
            if !root.is-playing : Rectangle {
                x: stage.ring-x + 14px;
                y: stage.ring-y + 14px;
                width: stage.ring-d - 28px;
                height: stage.ring-d - 28px;
                border-radius: self.width / 2;
                background: #00000066;
                Path {
                    x: (parent.width - self.width) / 2 + 2px;
                    y: (parent.height - self.height) / 2;
                    width: 28px;
                    height: 28px;
                    viewbox-width: 20;
                    viewbox-height: 20;
                    commands: "M 4 0 L 19 10 L 4 20 Z";
                    fill: #ffffff;
                }
            }
            // Ring: drag or click on the ring = seek, wheel = 5 s, click on the cover = play / pause.
            ring-ta := TouchArea {
                x: stage.ring-x;
                y: stage.ring-y;
                width: stage.ring-d;
                height: stage.ring-d;
                mouse-cursor: pointer;
                pointer-event(event) => {
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                        stage.ring-band = root.ring-hit(self.mouse-x, self.mouse-y, self.width);
                        if (stage.ring-band) {
                            stage.ring-drag = root.ring-ratio-at(self.mouse-x, self.mouse-y, self.width);
                        }
                    } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up
                        && stage.ring-band && root.duration-secs > 0) {
                        root.seek(root.ring-ratio-at(self.mouse-x, self.mouse-y, self.width));
                    }
                }
                moved => {
                    if (self.pressed && stage.ring-band) {
                        stage.ring-drag = root.ring-ratio-at(self.mouse-x, self.mouse-y, self.width);
                    }
                }
                clicked => {
                    if (!stage.ring-band) { root.toggle-play(); }
                }
                scroll-event(event) => {
                    if (root.duration-secs <= 0) {
                        return reject;
                    }
                    root.seek(max(0.0, min(1.0, root.progress + (event.delta-y / 60px) * 5.0 / root.duration-secs)));
                    return accept;
                }
            }

            // Title, "artist · album · year", quality.
            Text {
                x: 24px;
                y: parent.height - 72px;
                width: parent.width - 48px;
                height: 28px;
                text: root.np-title;
                color: Theme.text;
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: 24px;
                y: parent.height - 44px;
                width: parent.width - 48px;
                height: 20px;
                text: root.np-sub;
                color: Theme.muted;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            if root.np-quality != "" : Rectangle {
                property <length> chip-w: root.np-quality-tier == 2 ? 46px : root.np-quality-tier == 1 ? 60px : 0px;
                // No artist / album line under the title: the badge moves up into its place.
                y: root.np-sub == "" ? parent.height - 44px : parent.height - 22px;
                animate y { duration: 160ms; easing: ease-out; }
                height: 18px;
                width: min(parent.width - 48px, self.chip-w + (self.chip-w > 0px ? 6px : 0px) + quality-text.preferred-width + 20px);
                x: (parent.width - self.width) / 2;
                border-radius: 9px;
                background: root.glow-color.with-alpha(0.18);
                // Lossless / Hi-Res chip: gold for Hi-Res, accent for plain lossless.
                if root.np-quality-tier > 0 : Rectangle {
                    x: 2px;
                    y: 2px;
                    width: parent.chip-w;
                    height: 14px;
                    border-radius: 7px;
                    background: root.np-quality-tier == 2 ? #e9b949 : Theme.accent;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.np-quality-tier == 2 ? "Hi-Res" : "Lossless";
                        color: root.np-quality-tier == 2 ? #1a1405 : #ffffff;
                        font-size: 9.5px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                quality-text := Text {
                    x: parent.chip-w > 0px ? parent.chip-w + 8px : 0px;
                    width: parent.width - self.x;
                    height: parent.height;
                    text: root.np-quality;
                    color: Theme.text;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // Side card: Lyrics / Info (the Sound tab shows the sound panel here, see below).
        if root.side-open : Rectangle {
            x: root.card-x;
            y: root.header-h;
            width: root.card-w;
            height: root.card-h;
            background: Theme.surface;
            border-radius: 14px;
            clip: true;

            if root.eff-tab == 0 && root.lyrics.length == 0 : Text {
                width: parent.width;
                height: parent.height;
                text: "No lyrics for this track";
                color: Theme.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            // Synchronized: the current line stays in the middle, sung lines are dimmed, click a line to jump
            // there. The wheel scrolls (auto-follow pauses); a line under the mouse shimmers in the colors of
            // the emitter glow (they come from the cover, so every track has its own).
            if root.eff-tab == 0 && root.lyrics.length > 0 && root.lyrics-synced : lyr-area := Rectangle {
                clip: true;
                property <length> follow-y: self.height / 2 - 28px - max(0, root.lyric-index) * 56px;

                // Wheel over the gaps and the margins.
                TouchArea {
                    scroll-event(e) => {
                        root.lyric-wheel(e.delta-y, lyr-area.height);
                        return accept;
                    }
                }
                Rectangle {
                    y: root.lyr-user-scroll ? root.lyr-scroll-y : lyr-area.follow-y;
                    width: parent.width;
                    height: root.lyrics.length * 56px;
                    animate y { duration: 260ms; easing: ease-in-out; }
                    for l[i] in root.lyrics : row := Rectangle {
                        y: i * 56px;
                        width: parent.width;
                        height: 56px;
                        // 0..1, glides in and out with the mouse.
                        property <float> hot: lyr-ta.has-hover ? 1.0 : 0.0;
                        animate hot { duration: 180ms; easing: ease-out; }

                        // Hover highlight: a moving gradient of the emitter colors with two lights sweeping over it.
                        if row.hot > 0.01 : hl := Rectangle {
                            x: 10px;
                            y: 4px;
                            width: parent.width - 20px;
                            height: parent.height - 8px;
                            border-radius: 14px;
                            opacity: row.hot;
                            drop-shadow-blur: 18px;
                            drop-shadow-color: root.glow-color.with-alpha(0.45);

                            // Seconds; read only while a line is hovered, so nothing animates otherwise.
                            property <float> t: animation-tick() / 1s;
                            // The five lights of the emitter glow (same mixes as behind the rays).
                            property <color> p0: root.glow-color;
                            property <color> p1: root.glow-color.mix(#ff4fd8, 0.5);
                            property <color> p2: root.glow-color.mix(#36d6ff, 0.5);
                            property <color> p3: root.glow-color.mix(#ffb347, 0.45);
                            property <color> p4: root.glow-color.brighter(0.7);

                            Rectangle {
                                border-radius: 14px;
                                clip: true;
                                background: @linear-gradient(90deg,
                                    hl.p0.mix(hl.p1, 0.5 + 0.5 * Math.sin(hl.t * 1.9rad)).with-alpha(0.62) 0%,
                                    hl.p2.mix(hl.p3, 0.5 + 0.5 * Math.sin(hl.t * 1.4rad + 1.5rad)).with-alpha(0.62) 35%,
                                    hl.p4.mix(hl.p1, 0.5 + 0.5 * Math.sin(hl.t * 2.3rad + 3rad)).with-alpha(0.62) 68%,
                                    hl.p3.mix(hl.p2, 0.5 + 0.5 * Math.sin(hl.t * 1.7rad + 4.5rad)).with-alpha(0.62) 100%);

                                // Two lights sweeping from side to side at different speeds.
                                Rectangle {
                                    width: 150px;
                                    height: parent.height * 2.2;
                                    x: (parent.width - self.width) / 2 + parent.width * 0.5 * Math.sin(hl.t * 1.15rad);
                                    y: -parent.height * 0.6;
                                    background: @radial-gradient(circle, #ffffff50 0%, #ffffff00 70%);
                                }
                                Rectangle {
                                    width: 190px;
                                    height: parent.height * 2.6;
                                    x: (parent.width - self.width) / 2 + parent.width * 0.55 * Math.cos(hl.t * 0.71rad);
                                    y: -parent.height * 0.8;
                                    background: @radial-gradient(circle, hl.p1.brighter(0.5).with-alpha(0.55) 0%, hl.p1.with-alpha(0) 70%);
                                }
                            }
                        }

                        Text {
                            // Distance (in lines) from the line that is in the middle.
                            property <int> dist: Math.abs(i - max(0, root.lyric-index));
                            x: 20px;
                            width: parent.width - 40px;
                            height: parent.height;
                            text: l.text;
                            // The current line is bigger and brighter; the farther a line, the fainter it is,
                            // and sung lines are fainter than the ones to come. Size, color and fade glide.
                            font-size: i == root.lyric-index ? 21px : 17px;
                            horizontal-alignment: center;
                            font-weight: 600;
                            color: i == root.lyric-index ? Theme.text : Theme.muted.mix(Theme.text, row.hot);
                            opacity: max(row.hot, i == root.lyric-index ? 1.0
                                : (i < root.lyric-index ? 0.7 : 1.0) * max(0.18, 0.75 - self.dist * 0.14));
                            animate font-size { duration: 240ms; easing: ease-out; }
                            animate color { duration: 240ms; easing: ease-out; }
                            animate opacity { duration: 240ms; easing: ease-out; }
                            vertical-alignment: center;
                            // Long lines wrap (two lines fit a row); anything longer is cut with "...".
                            wrap: word-wrap;
                            overflow: elide;
                        }
                        lyr-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.duration-secs > 0) {
                                    root.seek(max(0.0, min(1.0, (l.time-ms / 1000.0) / root.duration-secs)));
                                }
                                root.lyr-user-scroll = false;
                            }
                            scroll-event(e) => {
                                root.lyric-wheel(e.delta-y, lyr-area.height);
                                return accept;
                            }
                        }
                    }
                }
                // After manual scrolling: jump back to the line that is playing.
                if root.lyr-user-scroll : Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - 46px;
                    width: 168px;
                    height: 32px;
                    border-radius: 16px;
                    background: pback-ta.has-hover ? Theme.accent : Theme.accent.with-alpha(0.85);
                    animate background { duration: 120ms; }
                    drop-shadow-blur: 12px;
                    drop-shadow-color: #00000080;
                    Text {
                        text: "Back to current line";
                        color: #ffffff;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    pback-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.lyr-user-scroll = false; }
                    }
                }
            }
            // Plain text: centered, comfortable size, long lines wrap instead of being cut off.
            if root.eff-tab == 0 && root.lyrics.length > 0 && !root.lyrics-synced : Flickable {
                VerticalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-top: 28px;
                    padding-bottom: 36px;
                    spacing: 9px;
                    alignment: start;
                    for l in root.lyrics : VerticalLayout {
                        if l.text == "" : Rectangle {
                            height: 12px;
                        }
                        if l.text != "" : Text {
                            text: l.text;
                            font-size: 17px;
                            color: Theme.text.with-alpha(0.92);
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
            // Info: "label  value" rows; long values (paths, titles) wrap instead of being cut off.
            if root.eff-tab == 2 : Flickable {
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    alignment: start;
                    if root.np-info.length == 0 : Text {
                        text: "No information";
                        color: Theme.muted;
                        font-size: 13px;
                    }
                    for r in root.np-info : HorizontalLayout {
                        spacing: 12px;
                        alignment: start;
                        Text {
                            width: 104px;
                            text: r.label;
                            color: Theme.muted;
                            font-size: 13px;
                            vertical-alignment: top;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: r.value;
                            color: Theme.text;
                            font-size: 13px;
                            wrap: word-wrap;
                            vertical-alignment: top;
                        }
                    }
                }
            }
        }

        // Header: close, caption, tabs.
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: root.header-h;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 16px;
                spacing: 8px;
                HeaderItem {
                    IconButton {
                        width: 40px;
                        height: 40px;
                        commands: "M 2 6 L 3.5 4.5 L 10 11 L 16.5 4.5 L 18 6 L 10 14 Z";
                        clicked => { root.show-player = false; }
                    }
                }
                Text {
                    text: "Now playing";
                    color: Theme.muted;
                    font-size: 13px;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                HeaderItem {
                    PillButton {
                        text: "Lyrics";
                        active: root.side-open && root.eff-tab == 0;
                        clicked => { root.pick-tab(0); }
                    }
                }
                HeaderItem {
                    PillButton {
                        text: "Sound";
                        active: root.side-open && root.eff-tab == 1;
                        clicked => { root.pick-tab(1); }
                    }
                }
                HeaderItem {
                    PillButton {
                        text: "Info";
                        active: root.side-open && root.eff-tab == 2;
                        clicked => { root.pick-tab(2); }
                    }
                }
            }
        }
    }

    // ---- sort panel (overlay): click outside to close ----
    if root.show-sort : TouchArea {
        y: 64px;
        height: root.height - 64px;
        clicked => { root.show-sort = false; }
    }
    if root.show-sort : Rectangle {
        x: root.width - self.width - 20px;
        y: 68px;
        width: 260px;
        height: min(root.height - 78px, root.section == 1 ? 226px : root.section == 2 ? 256px : 290px);
        background: Theme.surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.surface-hover;
        clip: true;

        TouchArea { }
        VerticalLayout {
            padding: 16px;
            spacing: 2px;
            Text {
                text: root.section == 2 ? "Sort playlists" : root.section == 1 ? "Sort albums" : "Sort tracks";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
                height: 26px;
            }
            for label[i] in root.sort-labels : Rectangle {
                height: 28px;
                border-radius: 7px;
                background: root.cur-sort-mode == i ? Theme.accent.with-alpha(0.2)
                    : sort-row.has-hover ? Theme.surface-hover : transparent;
                Text {
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    text: label;
                    color: root.cur-sort-mode == i ? Theme.accent : Theme.text;
                    vertical-alignment: center;
                }
                sort-row := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.apply-sort(i, root.cur-sort-desc); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                PillButton {
                    text: "Ascending";
                    active: !root.cur-sort-manual && !root.cur-sort-desc;
                    clicked => { root.apply-sort(root.cur-sort-mode, false); }
                }
                PillButton {
                    text: "Descending";
                    active: !root.cur-sort-manual && root.cur-sort-desc;
                    clicked => { root.apply-sort(root.cur-sort-mode, true); }
                }
            }
        }
    }

    // ---- sound panel (overlay): click outside to close ----
    if root.show-sound && !root.show-player : TouchArea {
        y: 64px;
        height: root.height - 64px;
        clicked => { root.show-sound = false; root.show-presets = false; }
    }
    if root.sound-visible : Rectangle {
        // In the player view the panel IS the side card (same position and size, no frame of its own).
        x: root.show-player ? root.card-x : root.width - self.width - 20px;
        y: root.show-player ? root.header-h : 68px;
        width: root.show-player ? root.card-w : 360px;
        height: root.show-player ? root.card-h : min(root.height - 78px, 640px);
        background: Theme.surface;
        border-radius: root.show-player ? 14px : 12px;
        border-width: root.show-player ? 0px : 1px;
        border-color: Theme.surface-hover;
        clip: true;

        // Swallows clicks so the panel does not close itself.
        TouchArea { }

        VerticalLayout {
            padding: 16px;
            spacing: 4px;
            alignment: start;

            Text {
                text: "Sound";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
                height: 26px;
            }
            Rectangle {
                height: 32px;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    ToggleText {
                        width: 96px;
                        height: 28px;
                        text: "Normalize";
                        active: root.fx-normalize;
                        clicked => {
                            root.fx-normalize = !root.fx-normalize;
                            root.normalize-changed(root.fx-normalize);
                        }
                    }
                    ToggleText {
                        width: 64px;
                        height: 28px;
                        text: "Mono";
                        active: root.fx-mono;
                        clicked => {
                            root.fx-mono = !root.fx-mono;
                            root.mono-changed(root.fx-mono);
                        }
                    }
                    ToggleText {
                        width: 64px;
                        height: 28px;
                        text: "Reset";
                        active: false;
                        clicked => { root.fx-reset(); }
                    }
                }
            }
            FxRow {
                label: "Speed";
                lo: -2;
                hi: 2;
                wheel-step: 0.1;
                value: root.speed-t;
                // 1x..3x faster, -1x..-3x slower (pitch is kept).
                value-text: (root.speed-t >= 0 ? "" : "-")
                    + "\{Math.floor(root.speed-n / 10)}.\{Math.mod(root.speed-n, 10)}x";
                edited(v) => {
                    root.speed-t = (v * 10).round() / 10; // steps of 0.1
                    root.speed-changed(root.speed-t);
                }
            }
            FxRow {
                label: "Bass";
                lo: 0;
                hi: 15;
                value: root.fx-bass;
                value-text: "\{(root.fx-bass * 2).round() / 2} dB";
                edited(v) => {
                    root.fx-bass = v;
                    root.bass-changed(v);
                }
            }
            FxRow {
                label: "Treble";
                lo: 0;
                hi: 15;
                value: root.fx-treble;
                value-text: "\{(root.fx-treble * 2).round() / 2} dB";
                edited(v) => {
                    root.fx-treble = v;
                    root.treble-changed(v);
                }
            }
            FxRow {
                label: "Subsonic";
                lo: 0;
                hi: 100;
                wheel-step: 1;
                value: root.fx-subsonic;
                value-text: "\{root.fx-subsonic.round()} %";
                edited(v) => {
                    root.fx-subsonic = v;
                    root.subsonic-changed(v);
                }
            }
            SegmentedControl {
                labels: ["Off", "All tracks", "Per track"];
                current: root.eq-mode;
                selected(k) => {
                    root.eq-mode = k;
                    root.eq-mode-changed(k);
                }
            }
            EqGraph {
                gains: root.eq-gains;
                line: root.eq-curve-line;
                fill: root.eq-curve-fill;
                mode: root.eq-mode;
                editable: root.eq-editable;
                track-name: root.eq-track-name;
                saved: root.eq-track-saved;
            }
            // Preset picker: one button that shows the current preset and opens the preset sheet.
            Rectangle {
                height: 40px;
                opacity: root.eq-presets-enabled ? 1.0 : 0.4;
                animate opacity { duration: 160ms; }
                Rectangle {
                    y: 2px;
                    height: 36px;
                    border-radius: 10px;
                    background: pick-ta.has-hover && root.eq-presets-enabled ? Theme.surface-hover : Theme.bg;
                    animate background { duration: 120ms; }
                    Text {
                        x: 12px;
                        width: 56px;
                        height: parent.height;
                        text: "Preset";
                        color: Theme.muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 68px;
                        width: parent.width - 68px - 36px;
                        height: parent.height;
                        text: (root.eq-active-preset >= 0 && root.eq-mode != 0)
                            ? root.eq-preset-names[root.eq-active-preset] : "Custom";
                        color: (root.eq-active-preset >= 0 && root.eq-mode != 0) ? Theme.accent : Theme.text;
                        font-size: 13px;
                        font-weight: 700;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Text {
                        x: parent.width - 30px;
                        width: 20px;
                        height: parent.height;
                        text: "\u{203A}";
                        color: Theme.muted;
                        font-size: 20px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    pick-ta := TouchArea {
                        enabled: root.eq-presets-enabled;
                        mouse-cursor: root.eq-presets-enabled ? MouseCursor.pointer : MouseCursor.default;
                        clicked => { root.show-presets = true; }
                    }
                }
            }
            // 12 bands (compact: no gaps between the rows); dimmed while the curve cannot be edited.
            Rectangle {
                height: 252px;
                opacity: root.eq-editable ? 1.0 : 0.4;
                animate opacity { duration: 160ms; }
                VerticalLayout {
                    spacing: 0px;
                    for g[i] in root.eq-gains : FxRow {
                        height: 21px;
                        label: root.eq-labels[i] + " Hz";
                        lo: -12;
                        hi: 12;
                        value: g;
                        enabled: root.eq-editable;
                        value-text: "\{(g * 2).round() / 2} dB";
                        edited(v) => { root.eq-changed(i, v); }
                    }
                }
            }
        }
        // ---- preset sheet: covers the panel, 10 cards in two columns ----
        if root.show-presets : Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: Theme.surface;
            TouchArea { }

            property <length> card-w: (self.width - 32px - 8px) / 2;
            property <length> card-h: min(84px, (self.height - 76px - 16px - 4 * 8px) / 5);

            // Back button + title.
            Rectangle {
                x: 12px;
                y: 14px;
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: back-ta.has-hover ? Theme.surface-hover : transparent;
                animate background { duration: 120ms; }
                Text {
                    text: "\u{2039}";
                    color: Theme.text;
                    font-size: 24px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                back-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.show-presets = false; }
                }
            }
            Text {
                x: 52px;
                y: 14px;
                width: parent.width - 52px - 16px;
                height: 32px;
                text: "Equalizer presets";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                x: 16px;
                y: 48px;
                width: parent.width - 32px;
                height: 18px;
                font-size: 11px;
                color: Theme.muted;
                overflow: elide;
                vertical-alignment: center;
                text: root.eq-mode == 0 ? "The equalizer is off \u{2014} picking a preset turns it on"
                    : root.eq-mode == 2 ? (root.eq-track-name == "" ? "Play a track to give it a preset"
                        : "Applies to \u{266A} " + root.eq-track-name)
                    : "Applies to every track";
            }
            for name[k] in root.eq-preset-names : PresetCard {
                x: 16px + Math.mod(k, 2) * (parent.card-w + 8px);
                y: 76px + Math.floor(k / 2) * (parent.card-h + 8px);
                width: parent.card-w;
                height: parent.card-h;
                text: name;
                line: root.eq-preset-lines[k];
                fill: root.eq-preset-fills[k];
                active: k == root.eq-active-preset;
                enabled: root.eq-presets-enabled;
                opacity: root.eq-presets-enabled ? 1.0 : 0.4;
                clicked => { root.eq-preset-selected(k); }
            }
        }
    }
    // ---- track context menu (overlay): click outside to close ----
    if root.show-menu : TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.show-menu = false; }
        }
        scroll-event(e) => { root.show-menu = false; return accept; }
    }
    if root.show-menu : Rectangle {
        x: root.menu-x;
        y: root.menu-y;
        width: root.menu-w;
        height: root.menu-h;
        background: Theme.surface;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.surface-hover;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000080;
        drop-shadow-offset-y: 4px;

        TouchArea { }
        VerticalLayout {
            padding: 6px;
            MenuItem {
                text: "Open album";
                clicked => {
                    root.show-menu = false;
                    if (root.menu-in-queue) {
                        let a = root.album-index-of-queue-track(root.menu-row);
                        if (a >= 0) {
                            root.go-section(1);
                            root.album-open = true;
                            root.open-album(a);
                        }
                    } else if (root.menu-in-pl) {
                        let a = root.album-index-of-pl-track(root.menu-row);
                        if (a >= 0) {
                            root.go-section(1);
                            root.album-open = true;
                            root.open-album(a);
                        }
                    } else if (!root.menu-in-album) {
                        let a = root.album-index-of-track(root.menu-row);
                        if (a >= 0) {
                            root.go-section(1);
                            root.album-open = true;
                            root.open-album(a);
                        }
                    }
                }
            }
            MenuItem {
                text: "Add to playlist";
                clicked => {
                    root.show-menu = false;
                    if (root.menu-in-queue) { root.queue-page-add-to-playlist(root.menu-row); }
                    else if (root.menu-in-pl) { root.pl-page-add-to-playlist(root.menu-row); }
                    else { root.add-to-playlist(root.menu-row, root.menu-in-album); }
                }
            }
            MenuItem {
                text: "Add to queue";
                clicked => {
                    root.show-menu = false;
                    if (root.menu-in-queue) { root.queue-page-add-to-queue(root.menu-row); }
                    else if (root.menu-in-pl) { root.pl-page-add-to-queue(root.menu-row); }
                    else { root.add-to-queue(root.menu-row, root.menu-in-album); }
                }
            }
            if root.menu-in-queue : MenuItem {
                text: "Remove from queue";
                clicked => {
                    root.show-menu = false;
                    root.queue-remove(root.menu-row);
                }
            }
            MenuItem {
                text: "Create stems";
                clicked => {
                    root.show-menu = false;
                    if (!root.menu-in-pl && !root.menu-in-queue) { root.create-stems(root.menu-row, root.menu-in-album); }
                }
            }
        }
    }

    // ---- "Add to queue" window: the four queues, centered over a dimmed backdrop ----
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #000000b0;
        opacity: root.show-q-popup ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 180ms; }

        TouchArea {
            clicked => { root.show-q-popup = false; }
            scroll-event(e) => { return accept; }
        }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2 + (root.show-q-popup ? 0px : 18px);
            width: min(420px, root.width - 32px);
            height: min(434px, root.height - 32px);
            background: Theme.surface;
            border-radius: 18px;
            border-width: 1px;
            border-color: Theme.surface-hover;
            drop-shadow-blur: 32px;
            drop-shadow-color: #000000a0;
            drop-shadow-offset-y: 8px;
            animate y { duration: 220ms; easing: ease-out; }

            q-fs := FocusScope {
                key-pressed(e) => {
                    if (e.text == Key.Escape) { root.show-q-popup = false; return accept; }
                    return reject;
                }
            }
            // Keeps clicks inside the window from closing it.
            TouchArea { scroll-event(e) => { return accept; } }

            VerticalLayout {
                padding: 22px;
                spacing: 10px;
                Rectangle {
                    height: 56px;
                    CoverArt {
                        x: 0px;
                        y: 4px;
                        width: 48px;
                        height: 48px;
                        art: root.pl-track-cover;
                        has-image: root.pl-track-has-cover;
                        letter: root.pl-track-letter;
                    }
                    Text {
                        x: 60px;
                        y: 4px;
                        width: parent.width - 60px - 44px;
                        height: 14px;
                        text: "ADD TO QUEUE";
                        color: Theme.accent.brighter(0.5);
                        font-size: 11px;
                        font-weight: 700;
                    }
                    Text {
                        x: 60px;
                        y: 18px;
                        width: parent.width - 60px - 44px;
                        height: 24px;
                        text: root.pl-track-title;
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        x: 60px;
                        y: 42px;
                        width: parent.width - 60px - 44px;
                        height: 18px;
                        text: root.pl-track-artist;
                        color: Theme.muted;
                        font-size: 13px;
                        overflow: elide;
                    }
                    IconButton {
                        x: parent.width - self.width;
                        y: 8px;
                        width: 36px;
                        height: 36px;
                        icon-size: 16px;
                        icon-color: Theme.muted;
                        commands: "M 5 3.6 L 10 8.6 L 15 3.6 L 16.4 5 L 11.4 10 L 16.4 15 L 15 16.4 L 10 11.4 L 5 16.4 L 3.6 15 L 8.6 10 L 3.6 5 Z";
                        clicked => { root.show-q-popup = false; }
                    }
                }
                for q in 4 : Rectangle {
                    height: 60px;
                    border-radius: 12px;
                    background: root.q-added[q] ? Theme.accent.with-alpha(0.2)
                        : q-row-ta.has-hover ? Theme.surface-hover : Theme.bg.with-alpha(0.5);
                    animate background { duration: 120ms; }

                    Rectangle {
                        x: 14px;
                        y: (parent.height - self.height) / 2;
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;
                        background: root.q-added[q] ? Theme.accent : Theme.surface-hover;
                        Text {
                            text: q + 1;
                            color: root.q-added[q] ? #ffffff : Theme.text;
                            font-size: 16px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    Text {
                        x: 62px;
                        y: 10px;
                        width: parent.width - 62px - 56px;
                        height: 22px;
                        text: "Queue \{q + 1}";
                        color: root.q-added[q] ? Theme.accent : Theme.text;
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 62px;
                        y: 32px;
                        width: parent.width - 62px - 56px;
                        height: 18px;
                        text: root.queue-counts[q] == 1 ? "1 track" : "\{root.queue-counts[q]} tracks";
                        color: Theme.muted;
                        font-size: 13px;
                    }
                    // Tick: the track is already in this queue (click again to take it out).
                    if root.q-added[q] : Path {
                        x: parent.width - 14px - 20px;
                        y: (parent.height - 20px) / 2;
                        width: 20px;
                        height: 20px;
                        viewbox-width: 20;
                        viewbox-height: 20;
                        commands: "M 3 10.5 L 4.6 8.9 L 8 12.3 L 15.4 4.9 L 17 6.5 L 8 15.5 Z";
                        fill: Theme.accent;
                    }
                    q-row-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.queue-toggle(q); }
                    }
                }
                Rectangle {
                    height: 44px;
                    Text {
                        x: 2px;
                        width: parent.width - 120px;
                        height: parent.height;
                        text: "Click a queue to add the track, click again to take it out.";
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    AccentButton {
                        x: parent.width - self.width;
                        y: 2px;
                        width: 100px;
                        text: "Done";
                        clicked => { root.show-q-popup = false; }
                    }
                }
            }
        }
    }

    // ---- "Add to playlist" window: centered over a dimmed backdrop ----
    Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #000000b0;
        opacity: root.show-pl-popup ? 1 : 0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 180ms; }

        TouchArea {
            clicked => { root.show-pl-popup = false; }
            scroll-event(e) => { return accept; }
        }

        Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2 + (root.show-pl-popup ? 0px : 18px);
            width: root.pl-w;
            height: root.pl-h;
            background: Theme.surface;
            border-radius: 18px;
            border-width: 1px;
            border-color: Theme.surface-hover;
            drop-shadow-blur: 32px;
            drop-shadow-color: #000000a0;
            drop-shadow-offset-y: 8px;
            animate y { duration: 220ms; easing: ease-out; }
            animate width { duration: 160ms; easing: ease-out; }
            animate height { duration: 160ms; easing: ease-out; }

            pl-fs := FocusScope {
                key-pressed(e) => {
                    if (e.text == Key.Escape) { root.pl-back(); return accept; }
                    return reject;
                }
            }
            // Keeps clicks inside the window from closing it.
            TouchArea { scroll-event(e) => { return accept; } }

            // View 0: pick playlists.
            if root.pl-view == 0 : VerticalLayout {
                padding: 22px;
                spacing: 10px;
                Rectangle {
                    height: 56px;
                    CoverArt {
                        x: 0px;
                        y: 4px;
                        width: 48px;
                        height: 48px;
                        art: root.pl-track-cover;
                        has-image: root.pl-track-has-cover;
                        letter: root.pl-track-letter;
                    }
                    Text {
                        x: 60px;
                        y: 4px;
                        width: parent.width - 60px - 44px;
                        height: 14px;
                        text: "ADD TO PLAYLIST";
                        color: Theme.accent.brighter(0.5);
                        font-size: 11px;
                        font-weight: 700;
                    }
                    Text {
                        x: 60px;
                        y: 18px;
                        width: parent.width - 60px - 44px;
                        height: 24px;
                        text: root.pl-track-title;
                        color: Theme.text;
                        font-size: 17px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        x: 60px;
                        y: 42px;
                        width: parent.width - 60px - 44px;
                        height: 18px;
                        text: root.pl-track-artist;
                        color: Theme.muted;
                        font-size: 13px;
                        overflow: elide;
                    }
                    IconButton {
                        x: parent.width - self.width;
                        y: 8px;
                        width: 36px;
                        height: 36px;
                        icon-size: 16px;
                        icon-color: Theme.muted;
                        commands: "M 5 3.6 L 10 8.6 L 15 3.6 L 16.4 5 L 11.4 10 L 16.4 15 L 15 16.4 L 10 11.4 L 5 16.4 L 3.6 15 L 8.6 10 L 3.6 5 Z";
                        clicked => { root.show-pl-popup = false; }
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for r in root.pl-grid-rows : Rectangle {
                        height: root.sl-h + 8px;
                        for c in root.pl-cols : Rectangle {
                            if r * root.pl-cols + c < root.pl-cards.length + 1 : SleeveCard {
                                x: root.pl-grid-x + c * (root.sl-w + root.sl-gap);
                                y: 8px;
                                is-new: r * root.pl-cols + c == 0;
                                name: root.pl-cards[r * root.pl-cols + c - 1].name;
                                count: root.pl-cards[r * root.pl-cols + c - 1].count;
                                letter: root.pl-cards[r * root.pl-cols + c - 1].letter;
                                color-a: root.pl-cards[r * root.pl-cols + c - 1].color-a;
                                color-b: root.pl-cards[r * root.pl-cols + c - 1].color-b;
                                added: root.pl-cards[r * root.pl-cols + c - 1].added;
                                liked: root.pl-cards[r * root.pl-cols + c - 1].liked;
                                clicked => {
                                    if (r * root.pl-cols + c == 0) {
                                        root.pl-name = "";
                                        root.pl-folder-sel = "";
                                        root.pl-view = 1;
                                    } else {
                                        root.pl-toggle(r * root.pl-cols + c - 1);
                                    }
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    height: 44px;
                    Text {
                        x: 2px;
                        width: parent.width - 120px;
                        height: parent.height;
                        text: "Click a record to add the track, click again to take it out.";
                        color: Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    AccentButton {
                        x: parent.width - self.width;
                        y: 2px;
                        width: 100px;
                        text: "Done";
                        clicked => { root.show-pl-popup = false; }
                    }
                }
            }

            // View 1: create a playlist (name, optional folder).
            if root.pl-view == 1 : VerticalLayout {
                padding: 22px;
                spacing: 10px;
                Rectangle {
                    height: 44px;
                    IconButton {
                        x: 0px;
                        y: 4px;
                        width: 36px;
                        height: 36px;
                        icon-size: 16px;
                        commands: "M 12.5 3.5 L 14 5 L 9 10 L 14 15 L 12.5 16.5 L 6 10 Z";
                        clicked => { root.pl-back(); }
                    }
                    Text {
                        x: 48px;
                        height: parent.height;
                        text: "New playlist";
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                Text { text: "NAME"; color: Theme.muted; font-size: 11px; font-weight: 700; }
                NameField {
                    placeholder: "Playlist name";
                    value <=> root.pl-name;
                    accepted(v) => { root.pl-submit(); }
                    init => { self.focus-input(); }
                }
                Text { text: "FOLDER (optional)"; color: Theme.muted; font-size: 11px; font-weight: 700; }
                FolderPicker {
                    vertical-stretch: 1;
                    folders: root.pl-folders;
                    selected <=> root.pl-folder-sel;
                    create-folder(n) => { root.pl-folder-sel = root.pl-folder-create(n); }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    PillButton { text: "Cancel"; clicked => { root.pl-back(); } }
                    AccentButton {
                        text: root.pl-has-track ? "Create and add" : "Create";
                        width: 150px;
                        enabled: root.pl-name != "";
                        clicked => { root.pl-submit(); }
                    }
                }
            }

            // View 2: move an existing playlist into a folder.
            if root.pl-view == 2 : VerticalLayout {
                padding: 22px;
                spacing: 10px;
                Rectangle {
                    height: 52px;
                    Text {
                        x: 0px;
                        y: 2px;
                        width: parent.width - 44px;
                        height: 30px;
                        text: "Move to folder";
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        x: 0px;
                        y: 32px;
                        width: parent.width - 44px;
                        height: 18px;
                        text: root.pl-move-name;
                        color: Theme.muted;
                        font-size: 13px;
                        overflow: elide;
                    }
                    IconButton {
                        x: parent.width - self.width;
                        y: 4px;
                        width: 36px;
                        height: 36px;
                        icon-size: 16px;
                        icon-color: Theme.muted;
                        commands: "M 5 3.6 L 10 8.6 L 15 3.6 L 16.4 5 L 11.4 10 L 16.4 15 L 15 16.4 L 10 11.4 L 5 16.4 L 3.6 15 L 8.6 10 L 3.6 5 Z";
                        clicked => { root.show-pl-popup = false; }
                    }
                }
                FolderPicker {
                    vertical-stretch: 1;
                    folders: root.pl-folders;
                    selected <=> root.pl-folder-sel;
                    create-folder(n) => { root.pl-folder-sel = root.pl-folder-create(n); }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    PillButton { text: "Cancel"; clicked => { root.show-pl-popup = false; } }
                    AccentButton {
                        text: "Move";
                        width: 110px;
                        clicked => { root.pl-move(root.pl-folder-sel); root.show-pl-popup = false; }
                    }
                }
            }

            // View 3: rename a playlist or a folder.
            if root.pl-view == 3 : VerticalLayout {
                padding: 22px;
                spacing: 10px;
                Rectangle {
                    height: 44px;
                    Text {
                        x: 0px;
                        width: parent.width - 44px;
                        height: parent.height;
                        text: root.pl-dialog-title;
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    IconButton {
                        x: parent.width - self.width;
                        y: 4px;
                        width: 36px;
                        height: 36px;
                        icon-size: 16px;
                        icon-color: Theme.muted;
                        commands: "M 5 3.6 L 10 8.6 L 15 3.6 L 16.4 5 L 11.4 10 L 16.4 15 L 15 16.4 L 10 11.4 L 5 16.4 L 3.6 15 L 8.6 10 L 3.6 5 Z";
                        clicked => { root.show-pl-popup = false; }
                    }
                }
                Text { text: "NAME"; color: Theme.muted; font-size: 11px; font-weight: 700; }
                NameField {
                    placeholder: "Name";
                    value <=> root.pl-name;
                    accepted(v) => { if (root.pl-rename(root.pl-name)) { root.show-pl-popup = false; } }
                    init => { self.focus-input(); }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    PillButton { text: "Cancel"; clicked => { root.show-pl-popup = false; } }
                    AccentButton {
                        text: "Save";
                        width: 110px;
                        enabled: root.pl-name != "";
                        clicked => { if (root.pl-rename(root.pl-name)) { root.show-pl-popup = false; } }
                    }
                }
            }

            // View 4: confirm deleting a playlist or a folder.
            if root.pl-view == 4 : VerticalLayout {
                padding: 22px;
                spacing: 12px;
                Text {
                    text: root.pl-dialog-title;
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: root.pl-dialog-text;
                    color: Theme.muted;
                    font-size: 15px;
                    wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    PillButton { text: "Cancel"; clicked => { root.show-pl-popup = false; } }
                    AccentButton {
                        text: root.clear-confirm ? "Clear" : "Delete";
                        tone: #d64550;
                        width: 110px;
                        clicked => {
                            if (root.clear-confirm) { root.queue-clear(); } else { root.pl-delete(); }
                            root.show-pl-popup = false;
                        }
                    }
                }
            }
        }
    }

    // ---- settings page (topmost; the player bar below stays usable) ----
    if root.settings-t > 0.001 : SettingsPage {
        x: (1 - root.settings-t) * 40px;
        y: 0px;
        width: root.width;
        height: root.player-h;
        opacity: root.settings-t;
        close => { root.show-settings = false; }
    }
}
