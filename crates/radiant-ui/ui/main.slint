// Main window. DONE: folder button, track list (click = play), prev / play-pause / next, now playing.
// TODO: tabs (Playlists / Albums / Tracks / Queues), search, sorting, seek bar, cover, quality badge,
//       themes (light / true-black / system), translations via @tr().
import { Button, ListView } from "std-widgets.slint";

export component MainWindow inherits Window {
    title: "Radiant";
    preferred-width: 800px;
    preferred-height: 600px;

    in property <[string]> tracks;
    in property <string> status;
    in property <string> now-playing;
    in property <bool> is-playing;

    callback choose-folder();
    callback play-track(int);
    callback toggle-play();
    callback next-track();
    callback previous-track();

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "Choose music folder";
                clicked => { root.choose-folder(); }
            }
            Text {
                text: root.status;
                vertical-alignment: center;
            }
        }

        ListView {
            for t[i] in root.tracks : Rectangle {
                height: 24px;
                Text {
                    text: t;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { root.play-track(i); }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "Prev";
                clicked => { root.previous-track(); }
            }
            Button {
                text: root.is-playing ? "Pause" : "Play";
                clicked => { root.toggle-play(); }
            }
            Button {
                text: "Next";
                clicked => { root.next-track(); }
            }
            Text {
                text: root.now-playing;
                vertical-alignment: center;
            }
        }
    }
}
